{
  "name": "paradigm-hp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/build-next.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node scripts/run-vitest.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck:pet-life-movie": "tsc --pretty false -p tsconfig.pet-life-movie.json",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium webkit",
    "e2e:local": "E2E_BASE_URL=http://localhost:3000 playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "deploy:guard": "node scripts/coolify-deploy-guard.mjs --inspect",
    "deploy:prod": "npm run release:prod",
    "release:doctor": "node scripts/release-doctor.mjs",
    "release:prod": "node scripts/release-doctor.mjs --pre-deploy && node scripts/sales-os-no-login-deploy.mjs && node scripts/release-doctor.mjs --post-deploy",
    "deploy:screenshot-to-code": "node scripts/deploy-screenshot-to-code.mjs",
    "quality:guard": "node scripts/paradigm-quality-guard.mjs",
    "quality:ci": "node scripts/paradigm-quality-guard.mjs --ci",
    "smoke:japan-entry-form-copy": "tsx scripts/smoke-japan-entry-form-copy.mts",
    "host:install-coolify-guard": "node scripts/install-coolify-host-guard.mjs",
    "host:disable-resident-runtime": "node scripts/disable-resident-runtime.mjs",
    "context:audit": "powershell -ExecutionPolicy Bypass -File %USERPROFILE%\\\\.agents\\\\scripts\\\\context-audit.ps1"
  },

<!-- ClickHouse config override for Trigger.dev OSS self-hosted -->
<!-- Disables system log tables to reduce disk usage in production -->
<clickhouse>
  <asynchronous_metric_log>
    <enabled>false</enabled>
  </asynchronous_metric_log>
  <asynchronous_insert_log>
    <enabled>false</enabled>
  </asynchronous_insert_log>
  <metric_log>
    <enabled>false</enabled>
  </metric_log>
  <query_log>
    <enabled>true</enabled>
  </query_log>
  <query_thread_log>
    <enabled>false</enabled>
  </query_thread_log>
  <part_log>
    <enabled>false</enabled>
  </part_log>
  <text_log>
    <enabled>false</enabled>
  </text_log>
  <trace_log>
    <enabled>false</enabled>
  </trace_log>
</clickhouse>

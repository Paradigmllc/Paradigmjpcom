<section class="sericia-discovery page-width" id="discovery" aria-labelledby="DiscoveryTitle-{{ section.id }}">
  <header><p class="tea-eyebrow">Everyday Japan</p><h2 id="DiscoveryTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2><p>{{ section.settings.intro | escape }}</p></header>
  <div class="sericia-discovery__grid">
    {% for block in section.blocks %}
      {% assign category = block.settings.collection %}
      <article class="sericia-discovery__card" {{ block.shopify_attributes }}>
        <span class="sericia-discovery__index" aria-hidden="true">0{{ forloop.index }}</span>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.description | escape }}</p>
        {% if category != blank %}
          <a href="{{ category.url }}">{{ block.settings.link_label | escape }} <span class="visually-hidden">— {{ block.settings.title | escape }}</span><span aria-hidden="true"> →</span></a>
        {% elsif pages.contact.url != blank %}
          <a href="{{ pages.contact.url }}?topic=product#ContactForm">{{ 'sericia.contact' | t }}<span class="visually-hidden"> — {{ block.settings.title | escape }}</span></a>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>
{% schema %}
{
 "name":"SERICIA discoveries","max_blocks":6,
 "settings":[{"type":"text","id":"heading","label":"Heading","default":"Find a little something."},{"type":"textarea","id":"intro","label":"Introduction"}],
 "blocks":[{"type":"category","name":"Discovery category","settings":[{"type":"text","id":"title","label":"Title"},{"type":"textarea","id":"description","label":"Description"},{"type":"collection","id":"collection","label":"Collection"},{"type":"text","id":"link_label","label":"Link label","default":"Explore"}]}],
 "presets":[{"name":"SERICIA discoveries"}]
}
{% endschema %}

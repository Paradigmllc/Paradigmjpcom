<section class="sericia-editorial-story" id="our-curation" aria-labelledby="SericiaStoryTitle-{{ section.id }}">
  <div class="sericia-editorial-story__grid page-width">
    <div class="sericia-editorial-story__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            class: 'sericia-editorial-story__image',
            widths: '550, 800, 1100, 1400, 1600',
            sizes: '(min-width: 990px) 48vw, 100vw',
            loading: 'lazy',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        <img
          class="sericia-editorial-story__image"
          src="{{ 'sericia-maker-story.webp' | asset_url }}"
          width="1200"
          height="1500"
          loading="lazy"
          alt="Artisan hands shaping wood in a refined studio setting"
        >
      {%- endif -%}
      <p class="sericia-editorial-story__caption">Material · Form · Provenance</p>
    </div>

    <div class="sericia-editorial-story__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="serica-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="sericia-editorial-story__title" id="SericiaStoryTitle-{{ section.id }}">
        {{ section.settings.heading | escape }}
      </h2>
      <div class="sericia-editorial-story__text rte">{{ section.settings.text }}</div>

      <ol class="sericia-editorial-story__principles" aria-label="{{ section.settings.principles_label | escape }}">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span aria-hidden="true">0{{ forloop.index }}</span>
            <div>
              <h3>{{ block.settings.heading | escape }}</h3>
              <p>{{ block.settings.text | escape }}</p>
            </div>
          </li>
        {%- endfor -%}
      </ol>

      {%- if section.settings.button_label != blank -%}
        <a class="button button--secondary" href="{{ section.settings.button_link | default: routes.collections_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SERICIA editorial story",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Editorial image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The SERICIA point of view"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Luxury is the discipline of choosing less, better."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We select for proportion, material intelligence, and enduring relevance. Every piece must earn its place through both presence and purpose.</p>"
    },
    {
      "type": "text",
      "id": "principles_label",
      "label": "Principles accessibility label",
      "default": "Our curation principles"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the opening collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "principle",
      "name": "Curation principle",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Material intelligence"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Texture, weight, and finish are considered before an object enters the edit."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SERICIA editorial story",
      "blocks": [
        {
          "type": "principle",
          "settings": {
            "heading": "Material intelligence",
            "text": "Texture, weight, and finish are considered before an object enters the edit."
          }
        },
        {
          "type": "principle",
          "settings": {
            "heading": "Exacting selection",
            "text": "Every piece must justify its presence through proportion, purpose, and longevity."
          }
        },
        {
          "type": "principle",
          "settings": {
            "heading": "Context without noise",
            "text": "Origin, maker, and care are presented with precision for an international audience."
          }
        }
      ]
    }
  ]
}
{% endschema %}

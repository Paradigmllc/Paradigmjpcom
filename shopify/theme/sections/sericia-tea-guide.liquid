<section class="tea-guide page-width" id="tea-guide" aria-labelledby="TeaGuideTitle-{{ section.id }}">
  <div class="tea-guide__heading">
    <div><p class="tea-eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 id="TeaGuideTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2></div>
    <p>{{ section.settings.intro | escape }}</p>
  </div>
  <div class="tea-guide__grid">
    {% for block in section.blocks %}
      <article class="tea-guide__card" {{ block.shopify_attributes }}>
        <span class="tea-guide__number" aria-hidden="true">0{{ forloop.index }}</span>
        <p class="tea-eyebrow">{{ block.settings.profile | escape }}</p>
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.description | escape }}</p>
        <p class="tea-guide__ritual">{{ block.settings.ritual | escape }}</p>
        {% if pages.contact.url != blank %}<a href="{{ pages.contact.url }}?topic=product#ContactForm">{{ section.settings.link_label | escape }} <span class="visually-hidden">— {{ block.settings.title | escape }}</span><span aria-hidden="true"> ↗</span></a>{% endif %}
      </article>
    {% endfor %}
  </div>
  <p class="tea-guide__footnote">{{ section.settings.note | escape }}</p>
</section>
{% schema %}
{
 "name":"SERICIA tea discovery","max_blocks":3,
 "settings":[
  {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Start with your palate"},
  {"type":"text","id":"heading","label":"Heading","default":"Find your everyday favourite."},
  {"type":"textarea","id":"intro","label":"Introduction","default":"Fresh and green, gently roasted, or rich and whisked. There is more than one way to enjoy Japanese tea."},
  {"type":"text","id":"link_label","label":"Enquiry link","default":"Ask us about this tea"},
  {"type":"text","id":"note","label":"Note","default":"A guide to tea styles. Available products and individual tasting notes will appear in the collection."}
 ],
 "blocks":[{"type":"tea","name":"Tea style","settings":[
  {"type":"text","id":"title","label":"Tea name"},
  {"type":"text","id":"profile","label":"Flavour profile"},
  {"type":"textarea","id":"description","label":"Description"},
  {"type":"text","id":"ritual","label":"Ritual"}
 ]}],
 "presets":[{"name":"SERICIA tea discovery"}]
}
{% endschema %}

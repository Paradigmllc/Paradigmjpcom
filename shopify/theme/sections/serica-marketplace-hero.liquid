<section class="serica-marketplace-hero" aria-labelledby="SericaHeroTitle-{{ section.id }}">
  <div class="serica-marketplace-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          class: 'serica-marketplace-hero__image',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: section.settings.image.alt
      }}
    {%- else -%}
      <img
        class="serica-marketplace-hero__image"
        src="{{ 'sericia-woodmart-hero.webp' | asset_url }}"
        width="1984"
        height="793"
        loading="eager"
        fetchpriority="high"
        alt="Japanese craft-inspired ceramic, indigo textile, cedar tray, and washi in morning light"
      >
    {%- endif -%}
  </div>

  <div class="serica-marketplace-hero__inner page-width">
    <div class="serica-marketplace-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="serica-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="serica-marketplace-hero__title" id="SericaHeroTitle-{{ section.id }}">
          {{ section.settings.heading | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="serica-marketplace-hero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
        <div class="serica-marketplace-hero__actions">
          {%- if section.settings.primary_label != blank -%}
            <a
              class="button serica-marketplace-hero__button--primary"
              href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
            >
              {{ section.settings.primary_label | escape }}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a
              class="button serica-marketplace-hero__button--secondary"
              href="{{ section.settings.secondary_link | default: routes.collections_url }}"
            >
              {{ section.settings.secondary_label | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <p class="serica-marketplace-hero__note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "SERICIA marketplace hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Independent Japan, delivered worldwide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Objects with a story."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover considered goods from independent Japanese makers, small studios, and local shops.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop new arrivals"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Explore collections"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small note",
      "default": "Tracked international delivery from Japan"
    }
  ],
  "presets": [
    {
      "name": "SERICIA marketplace hero"
    }
  ]
}
{% endschema %}

{%- style -%}
  .sericia-preview-banner {
    background: #11100f;
    color: #fbfaf7;
    border-bottom: 1px solid rgba(183, 155, 106, 0.4);
    font-size: 1.1rem;
    letter-spacing: 0.08em;
    padding: 1.1rem 2rem;
    text-align: center;
  }
  .sericia-preview-banner p {
    margin: 0;
  }
  .sericia-preview-banner strong {
    color: inherit;
  }
{%- endstyle -%}

<aside class="sericia-preview-banner" aria-label="Store preview status">
  <p><strong>Preview storefront.</strong> Products and checkout are being prepared and are not yet available for purchase.</p>
</aside>

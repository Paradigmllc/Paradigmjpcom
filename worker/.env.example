# ④フォーム営業 worker env (Coolify の別サービスに設定)

# Next アプリ (RemoteWorkerProvider) と共有する秘密鍵 (X-Worker-Secret)
WORKER_SECRET=

# HTTP サーバ port
PORT=8080

# ── ブラウザ実行モード ──
# 案2 (default): 空 = ローカル Chromium を起動 (scale-to-zero 前提・playwright install chromium 要)
# 案1: CDP_ENDPOINT を指定 = リモートブラウザ (Steel-Browser 等) に CDP 接続・ローカル Chromium 不要 (ディスク最安)
CDP_ENDPOINT=
# CDP_ENDPOINT が空でも STEEL_BASE_URL が設定されていれば worker が Steel CDP URL を自動生成する
STEEL_BASE_URL=

# Stagehand mode. The same worker can serve STAGEHAND_URL=/submit and /discover-form.
# Stagehand requires an LLM key plus either Browserbase or CDP/Steel.
STAGEHAND_MODEL=deepseek-chat
STAGEHAND_LLM_API_KEY=
STAGEHAND_LLM_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
STAGEHAND_CONNECT_TIMEOUT_MS=30000
STAGEHAND_NAV_TIMEOUT_MS=45000

# ディスク/メモリ保護
MAX_CONCURRENCY=2
NAV_TIMEOUT_MS=30000
# スクショ証跡を残すか (true=R2 等にアップロード想定・false=ディスク汚さない)
CAPTURE_EVIDENCE=false

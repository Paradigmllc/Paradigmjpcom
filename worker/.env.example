# ④フォーム営業 worker env (Coolify の別サービスに設定)

# Next アプリ (RemoteWorkerProvider) と共有する秘密鍵 (X-Worker-Secret)
WORKER_SECRET=

# HTTP サーバ port
PORT=8080

# ── ブラウザ実行モード ──
# 案2 (default): 空 = ローカル Chromium を起動 (scale-to-zero 前提・playwright install chromium 要)
# 案1: CDP_ENDPOINT を指定 = リモートブラウザ (Browserless 等) に CDP 接続・ローカル Chromium 不要 (ディスク最安)
CDP_ENDPOINT=
# CDP_ENDPOINT が空でも、下記2つがあれば worker が Browserless CDP URL を自動生成する
BROWSERLESS_URL=
BROWSERLESS_TOKEN=

# ディスク/メモリ保護
MAX_CONCURRENCY=2
NAV_TIMEOUT_MS=30000
# スクショ証跡を残すか (true=R2 等にアップロード想定・false=ディスク汚さない)
CAPTURE_EVIDENCE=false

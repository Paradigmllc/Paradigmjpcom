{
  "name": "Sales 02 — Notion → Supabase reverse sync (5min cron)",
  "description": "Notion リードDB で人間が編集した 4 field (deal_stage / follow_up_date / memo / 担当者) を Supabase sales_companies に書き戻す。5 分 cron で差分のみ処理。Sprint 8 / 2026-05-13.",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 5 }]
        }
      },
      "name": "Cron (5min)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "// 5 分前の timestamp を ISO で返す\nconst since = new Date(Date.now() - 5 * 60 * 1000).toISOString()\nreturn [{ json: { since } }]"
      },
      "name": "Compute since",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "=https://api.notion.com/v1/databases/{{ $env.NOTION_DB_COMPANIES_ID }}/query",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.NOTION_API_KEY }}" },
            { "name": "Notion-Version", "value": "2022-06-28" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filter: { timestamp: 'last_edited_time', last_edited_time: { on_or_after: $json.since } }, page_size: 100 }) }}",
        "options": { "timeout": 15000 }
      },
      "name": "Notion query recently edited",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [680, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "results",
        "options": {}
      },
      "name": "Split into pages",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.PARADIGMJP_BASE_URL }}/api/sales/sync-from-notion",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ notion_page_id: $json.id, properties: $json.properties }) }}",
        "options": { "timeout": 10000 }
      },
      "name": "Call lib/sales/sync.ts (syncCompanyFromNotion)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 300],
      "notes": "Notion ページ 1 件ごとに paradigmjp.com 側 API を call。syncCompanyFromNotion() が 4 field のみ書き戻す"
    }
  ],
  "connections": {
    "Cron (5min)": {
      "main": [[{ "node": "Compute since", "type": "main", "index": 0 }]]
    },
    "Compute since": {
      "main": [[{ "node": "Notion query recently edited", "type": "main", "index": 0 }]]
    },
    "Notion query recently edited": {
      "main": [[{ "node": "Split into pages", "type": "main", "index": 0 }]]
    },
    "Split into pages": {
      "main": [[{ "node": "Call lib/sales/sync.ts (syncCompanyFromNotion)", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "_meta": {
    "sprint": "Sprint 8 (2026-05-13)",
    "purpose": "Notion 編集 (deal_stage / memo / etc.) を Supabase に逆流",
    "frequency": "5 minutes (Sprint 8 既定値・需要に応じて調整)",
    "env_required": [
      "NOTION_API_KEY",
      "NOTION_DB_COMPANIES_ID",
      "PARADIGMJP_BASE_URL"
    ],
    "safety_limit": "編集可能 4 field 以外は無視 (lib/sales/companies.ts::updateCompanyFromNotion の whitelist)"
  }
}

{
  "name": "Sales 03 — Notion テンプレ → Supabase upsert (webhook, event-driven)",
  "description": "Notion 📝 テンプレ DB を全件取得し sales_templates に upsert。WW-EVENT: cron 廃止 → Notion automation / 手動 webhook で起動。Notion 主管・Supabase 側は read-only。Sprint 8 / 2026-05-13.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "notion-template-sync",
        "responseMode": "onReceived"
      },
      "name": "Webhook trigger (event-driven)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "=https://api.notion.com/v1/databases/{{ $env.NOTION_DB_TEMPLATES_ID }}/query",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.NOTION_API_KEY }}" },
            { "name": "Notion-Version", "value": "2022-06-28" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ filter: { property: '有効', checkbox: { equals: true } }, page_size: 100 }) }}",
        "options": { "timeout": 30000 }
      },
      "name": "Notion query all active templates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "results",
        "options": {}
      },
      "name": "Split templates",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.PARADIGMJP_BASE_URL }}/api/sales/upsert-template",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ notion_page_id: $json.id, properties: $json.properties }) }}",
        "options": { "timeout": 10000 }
      },
      "name": "Call lib/sales/templates.ts (upsertTemplateFromNotion)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '📝 テンプレ同期完了: ' + $items().length + ' templates updated from Notion to Supabase' }) }}",
        "options": { "timeout": 5000 }
      },
      "name": "Slack notify completion (optional)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1120, 300],
      "disabled": true,
      "notes": "デバッグ時のみ有効化。本番では disabled でログ抑制"
    }
  ],
  "connections": {
    "Webhook trigger (event-driven)": {
      "main": [[{ "node": "Notion query all active templates", "type": "main", "index": 0 }]]
    },
    "Notion query all active templates": {
      "main": [[{ "node": "Split templates", "type": "main", "index": 0 }]]
    },
    "Split templates": {
      "main": [[{ "node": "Call lib/sales/templates.ts (upsertTemplateFromNotion)", "type": "main", "index": 0 }]]
    },
    "Call lib/sales/templates.ts (upsertTemplateFromNotion)": {
      "main": [[{ "node": "Slack notify completion (optional)", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "_meta": {
    "sprint": "Sprint 8 (2026-05-13)",
    "purpose": "Notion テンプレ DB を Supabase に同期 (Notion 主管)",
    "frequency": "1 hour (テンプレ更新頻度に合わせる・Sprint 8 注意点準拠)",
    "env_required": [
      "NOTION_API_KEY",
      "NOTION_DB_TEMPLATES_ID",
      "PARADIGMJP_BASE_URL"
    ],
    "scale": "業種 8 × 課題 7 = 最大 56 templates・1h cron で十分"
  }
}

{
  "name": "Sales 01 — Supabase → Notion sync (companies)",
  "description": "Supabase の sales_companies UPDATE/INSERT を Webhook で受けて Notion リードDB に反映。HOT lead なら Slack 通知も同時実行。Sprint 8 / 2026-05-13.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sales-companies-webhook",
        "responseMode": "responseNode"
      },
      "name": "Webhook (Supabase trigger)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "notes": "Supabase Realtime / Database Webhooks から POST 受信。payload = { record: SalesCompany, type: 'INSERT'|'UPDATE' }"
    },
    {
      "parameters": {
        "url": "={{ $env.PARADIGMJP_BASE_URL }}/api/sales/sync-to-notion",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ company: $json.record }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "name": "Call lib/sales/sync.ts (syncCompanyToNotion)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [460, 300],
      "notes": "paradigmjp.com 側で syncCompanyToNotion() を呼ぶ薄い API route 経由。レート制限を notion.ts 内で処理"
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $node['Webhook (Supabase trigger)'].json.record.is_hot_lead }}",
              "value2": true
            }
          ]
        }
      },
      "name": "Is HOT lead?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: '🔥 HOT LEAD: ' + $node[\"Webhook (Supabase trigger)\"].json.record.company_name + ' (' + $node[\"Webhook (Supabase trigger)\"].json.record.domain + ') reports views: ' + $node[\"Webhook (Supabase trigger)\"].json.record.report_views }) }}",
        "options": { "timeout": 5000 }
      },
      "name": "Slack notify HOT lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [900, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, processed: $node['Webhook (Supabase trigger)'].json.record.domain }) }}"
      },
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Webhook (Supabase trigger)": {
      "main": [[{ "node": "Call lib/sales/sync.ts (syncCompanyToNotion)", "type": "main", "index": 0 }]]
    },
    "Call lib/sales/sync.ts (syncCompanyToNotion)": {
      "main": [[{ "node": "Is HOT lead?", "type": "main", "index": 0 }]]
    },
    "Is HOT lead?": {
      "main": [
        [{ "node": "Slack notify HOT lead", "type": "main", "index": 0 }],
        [{ "node": "Respond OK", "type": "main", "index": 0 }]
      ]
    },
    "Slack notify HOT lead": {
      "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "_meta": {
    "sprint": "Sprint 8 (2026-05-13)",
    "purpose": "Supabase truth source → Notion human UI への一方向同期",
    "env_required": [
      "PARADIGMJP_BASE_URL (例: https://paradigmjp.com)",
      "SLACK_WEBHOOK_URL (HOT lead 通知先)"
    ],
    "rate_limit": "Notion API 3 req/秒は lib/notion.ts 側で吸収"
  }
}

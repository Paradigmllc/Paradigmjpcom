# deploy.sh が実行時にコンテナ env / media-os volume から実値を埋めて .env(0600) を生成する。
# ここには値を書かない (このファイルは git 追跡・.env は .gitignore)。
PGHOST=supabase-db-1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=            # supabase-db-1 の POSTGRES_PASSWORD
PGDATABASE=postgres
TWENTY_PGHOST=opt-twenty-db-1
TWENTY_PGPORT=5432
TWENTY_PGUSER=twenty
TWENTY_PGPASSWORD=     # opt-twenty-db-1 の POSTGRES_PASSWORD
TWENTY_PGDATABASE=twenty
REVENUEOS_URL=https://paradigmjp.com
WEBHOOK_SECRET=        # RevenueOS app の TRIGGER_WEBHOOK_SECRET
PULL_TOKEN=            # /pull/<token> の内部網トークン (openssl rand -hex 24)
PORT=8791
PULL_DEBOUNCE_MS=8000
PULL_LIMIT=200
SLACK_WEBHOOK_URL=     # 任意 (未設定なら Slack 通知は no-op)

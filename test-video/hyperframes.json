{
  "$schema": "https://hyperframes.ai/schema/hyperframes.json",
  "registry": "https://hyperframes.ai/registry",
  "paths": {
    "blocks": "compositions",
    "components": "compositions/components",
    "assets": "assets"
  },
  "render": {
    "defaults": {
      "fps": 30,
      "quality": "standard",
      "format": "mp4"
    },
    "profiles": {
      "draft": {
        "fps": 15,
        "quality": "draft",
        "description": "Quick preview"
      },
      "standard": {
        "fps": 30,
        "quality": "standard",
        "description": "Standard quality"
      },
      "high": {
        "fps": 60,
        "quality": "high",
        "video_bitrate": "20M",
        "description": "High quality delivery"
      },
      "social-portrait": {
        "fps": 30,
        "quality": "standard",
        "resolution": "portrait",
        "description": "TikTok / Reels / Shorts"
      },
      "social-square": {
        "fps": 30,
        "quality": "standard",
        "resolution": "square",
        "description": "Instagram square"
      }
    }
  }
}

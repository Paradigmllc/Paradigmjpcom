---
export interface Props {
  title?: string
  subTitle?: string
}

const {
  title = 'By the Numbers',
  subTitle = '',
} = Astro.props as Props
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
    <div class="mb-14 text-center">
      <h2 class="text-3xl font-bold text-neutral-800 dark:text-neutral-200">{title}</h2>
      {subTitle && <p class="mt-3 text-lg text-neutral-600 dark:text-neutral-400">{subTitle}</p>}
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <slot />
    </div>
  </div>
</section>

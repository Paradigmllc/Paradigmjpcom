---
export interface Props {
  title?: string
  subTitle?: string
  faqs?: Array<{ question: string; answer: string }>
}

const {
  title = 'Frequently Asked <span class="text-orange-500">Questions</span>',
  subTitle = '',
  faqs = [],
} = Astro.props as Props

const makeId = (base: string, index: number) => `${base}${index + 1}`
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="grid gap-10 md:grid-cols-5">
    <div class="md:col-span-2">
      <div class="max-w-xs">
        <h2 class="text-2xl font-bold text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
          <Fragment set:html={title} />
        </h2>
        {subTitle && (
          <p class="mt-1 hidden text-neutral-600 md:block dark:text-neutral-400">
            {subTitle}
          </p>
        )}
      </div>
    </div>

    <div class="md:col-span-3">
      <div class="hs-accordion-group divide-y divide-neutral-200 dark:divide-neutral-700">
        {faqs.map((faq, i) => {
          const id = makeId('hs-faq-heading-', i)
          const collapseId = makeId('hs-faq-collapse-', i)
          const first = i === 0

          return (
            <div class={first ? 'hs-accordion pb-3 active' : 'hs-accordion pt-6 pb-3'} id={id}>
              <button
                class="hs-accordion-toggle group inline-flex w-full items-center justify-between gap-x-3 rounded-lg pb-3 text-start font-bold text-balance text-neutral-800 ring-zinc-500 outline-hidden transition hover:text-neutral-500 focus-visible:ring-3 md:text-lg dark:text-neutral-200 dark:ring-zinc-200 dark:hover:text-neutral-400 dark:focus:outline-hidden"
                aria-expanded={first}
                aria-controls={collapseId}
              >
                {faq.question}
                <svg class="block h-5 w-5 shrink-0 text-neutral-600 group-hover:text-neutral-500 hs-accordion-active:hidden dark:text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6" />
                </svg>
                <svg class="hidden h-5 w-5 shrink-0 text-neutral-600 group-hover:text-neutral-500 hs-accordion-active:block dark:text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m18 15-6-6-6 6" />
                </svg>
              </button>
              <div
                id={collapseId}
                role="region"
                aria-labelledby={id}
                class={`hs-accordion-content w-full overflow-hidden transition-[height] duration-300 ${first ? '' : 'hidden'}`}
              >
                <p class="text-pretty text-neutral-600 dark:text-neutral-400">
                  {faq.answer}
                </p>
              </div>
            </div>
          )
        })}
      </div>
    </div>
  </div>
</section>

---
export interface Props {
  title?: string
  subTitle?: string
  url?: string
}

const {
  title = 'Build Faster.',
  subTitle = 'Ship enterprise-grade applications with confidence.',
  url = '#',
} = Astro.props as Props
---

<section class="relative overflow-hidden py-24 md:py-32">
  <div class="absolute inset-0 -z-10">
    <svg class="absolute -left-20 -top-20 h-64 w-64 text-orange-100 opacity-50 dark:text-orange-900/20" fill="currentColor" viewBox="0 0 200 200">
      <circle cx="40" cy="40" r="36" />
      <circle cx="80" cy="20" r="24" />
      <circle cx="100" cy="60" r="16" opacity="0.7" />
    </svg>
    <svg class="absolute -bottom-16 -right-16 h-80 w-80 text-orange-100 opacity-50 dark:text-orange-900/20" fill="currentColor" viewBox="0 0 200 200">
      <rect x="20" y="20" width="60" height="60" rx="8" transform="rotate(15 50 50)" />
      <rect x="90" y="60" width="40" height="40" rx="6" transform="rotate(25 110 80)" />
      <rect x="110" y="110" width="50" height="50" rx="7" transform="rotate(-10 135 135)" opacity="0.7" />
    </svg>
  </div>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
    <h1 class="text-balance text-3xl font-bold tracking-tight text-neutral-800 sm:text-4xl lg:text-6xl dark:text-neutral-200">
      <Fragment set:html={title} />
    </h1>
    {subTitle && (
      <p class="text-pretty mt-6 text-lg text-neutral-600 dark:text-neutral-400">
        {subTitle}
      </p>
    )}
    <div class="mt-10">
      <a
        href={url}
        class="inline-flex items-center gap-x-2 rounded-lg bg-orange-500 px-6 py-3 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-orange-600"
      >
        Continue
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

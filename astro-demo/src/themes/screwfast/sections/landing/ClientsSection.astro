---
export interface Props {
  title?: string
  subTitle?: string
  partners?: Array<{ icon?: string; name?: string; href?: string }>
}

const {
  title = 'Trusted by Industry Leaders',
  subTitle = '',
  partners = [],
} = Astro.props as Props
---

<section class="py-16">
  <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-10 w-full text-center sm:w-1/2 lg:w-1/3">
      <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200">{title}</h2>
      {subTitle && <p class="mt-2 text-neutral-600 dark:text-neutral-400">{subTitle}</p>}
    </div>
    <div class="flex flex-wrap items-center justify-center gap-x-12 sm:gap-x-12 lg:gap-x-24 gap-y-6">
      {partners.map((p) => (
        p.href ? (
          <a
            href={p.href}
            target="_blank"
            rel="noopener"
            class="text-neutral-400 transition-colors hover:text-neutral-600 dark:hover:text-neutral-300"
          >
            {p.icon ? (
              <span class="block" set:html={p.icon} />
            ) : (
              <span class="text-sm font-semibold">{p.name || 'Partner'}</span>
            )}
          </a>
        ) : (
          <span class="text-neutral-400">
            {p.icon ? (
              <span class="block" set:html={p.icon} />
            ) : (
              <span class="text-sm font-semibold">{p.name || 'Partner'}</span>
            )}
          </span>
        )
      ))}
    </div>
  </div>
</section>

---
export interface Props {
  title?: string
  subTitle?: string
  testimonials?: Array<{
    content: string
    author: string
    role: string
    avatarSrc?: string
  }>
  statistics?: Array<{
    count: string
    description: string
  }>
}

const {
  title = 'Loved by Teams Everywhere',
  subTitle = '',
  testimonials = [],
  statistics = [],
} = Astro.props as Props
---

<section class="py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-[85rem] px-4 sm:px-6 lg:px-8">
    <div class="lg:grid lg:grid-cols-12 lg:items-center lg:justify-between lg:gap-16">
      <div class="lg:col-span-5 lg:col-start-1">
        <div class="mb-8">
          <h2 class="mb-2 text-3xl font-bold text-neutral-800 lg:text-4xl dark:text-neutral-200">
            {title}
          </h2>
          {subTitle && (
            <p class="text-neutral-600 dark:text-neutral-400">{subTitle}</p>
          )}
        </div>

        {testimonials.map((t, idx) => (
          <div class={idx > 0 ? 'mt-8' : ''}>
            <div class="relative">
              <svg class="absolute left-0 top-0 h-16 w-16 -translate-x-6 -translate-y-8 text-neutral-300 dark:text-neutral-700" fill="currentColor" viewBox="0 0 16 16">
                <path d="M7.39762 10.3C7.39762 11.0733 7.14888 11.7 6.6514 12.18C6.15392 12.6333 5.52552 12.86 4.76621 12.86C3.84979 12.86 3.09047 12.5533 2.48825 11.94C1.91222 11.3266 1.62421 10.4467 1.62421 9.29999C1.62421 8.07332 1.96459 6.87332 2.64535 5.69999C3.35231 4.49999 4.33418 3.55332 5.59098 2.85999L6.4943 4.25999C5.81354 4.73999 5.26369 5.27332 4.84476 5.85999C4.45201 6.44666 4.19017 7.12666 4.05926 7.89999C4.29491 7.79332 4.56983 7.73999 4.88403 7.73999C5.61716 7.73999 6.21938 7.97999 6.69067 8.45999C7.16197 8.93999 7.39762 9.55333 7.39762 10.3ZM14.6242 10.3C14.6242 11.0733 14.3755 11.7 13.878 12.18C13.3805 12.6333 12.7521 12.86 11.9928 12.86C11.0764 12.86 10.3171 12.5533 9.71484 11.94C9.13881 11.3266 8.85079 10.4467 8.85079 9.29999C8.85079 8.07332 9.19117 6.87332 9.87194 5.69999C10.5789 4.49999 11.5608 3.55332 12.8176 2.85999L13.7209 4.25999C13.0401 4.73999 12.4903 5.27332 12.0713 5.85999C11.6786 6.44666 11.4168 7.12666 11.2858 7.89999C11.5215 7.79332 11.7964 7.73999 12.1106 7.73999C12.8437 7.73999 13.446 7.97999 13.9173 8.45999C14.3886 8.93999 14.6242 9.55333 14.6242 10.3Z" />
              </svg>
              <blockquote class="pl-10 text-pretty text-neutral-700 italic dark:text-neutral-300">
                {t.content}
              </blockquote>
            </div>
            <div class="mt-6 flex items-center gap-x-3 pl-10">
              {t.avatarSrc ? (
                <img class="h-10 w-10 rounded-full object-cover" src={t.avatarSrc} alt={t.author} loading="lazy" />
              ) : (
                <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-orange-100 text-sm font-bold text-orange-600 dark:bg-orange-900/30 dark:text-orange-400">
                  {t.author?.charAt(0) || '?'}
                </span>
              )}
              <div>
                <p class="text-sm font-semibold text-neutral-800 dark:text-neutral-200">{t.author}</p>
                <p class="text-xs text-neutral-500 dark:text-neutral-500">{t.role}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      {statistics.length > 0 && (
        <div class="mt-10 lg:col-span-6 lg:col-end-13 lg:mt-0">
          <div class="space-y-6 sm:space-y-8">
            <ul class="grid grid-cols-2 divide-x-2 divide-y-2 divide-neutral-300 overflow-hidden dark:divide-neutral-700">
              {statistics.map((stat, index) => (
                <li class="-m-0.5 flex flex-col p-4 sm:p-8">
                  <div class="mb-2 flex items-end gap-x-2 text-3xl font-bold text-neutral-800 sm:text-5xl dark:text-neutral-200">
                    {index === 1 || index === 2 ? (
                      <svg class="h-5 w-5 shrink-0 text-orange-400 dark:text-orange-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m5 12 7-7 7 7" />
                        <path d="M12 19V5" />
                      </svg>
                    ) : null}
                    {stat.count}
                  </div>
                  <p class="text-sm text-neutral-600 sm:text-base dark:text-neutral-400">
                    {stat.description}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

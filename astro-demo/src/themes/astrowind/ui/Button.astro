---
import type { CallToAction } from '../types'

const { variant = 'primary', text = '', icon, classes = {}, ...attrs } = Astro.props as CallToAction

const variantClasses = {
  primary: 'bg-primary-600 text-white hover:bg-primary-700 shadow-sm',
  secondary: 'bg-white text-gray-900 ring-1 ring-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:text-gray-100 dark:ring-gray-700 dark:hover:bg-gray-700',
  tertiary: 'text-primary-600 hover:text-primary-700 dark:text-primary-400',
  link: 'text-primary-600 hover:text-primary-700 dark:text-primary-400 font-semibold',
}
---

<a
  {...attrs}
  class:list={[
    'inline-flex items-center gap-2 rounded-lg px-5 py-2.5 text-sm font-semibold transition-colors',
    variantClasses[variant] || variantClasses.primary,
    classes?.container,
  ]}
>
  {icon && <span class:list={[classes?.icon]} set:html={icon} />}
  {text}
</a>

---
import DesignRoot from "../../components/renderer/DesignRoot.astro"
import type { DemoDesignSpec } from "../../lib/design-spec"

const API_BASE = import.meta.env.API_BASE || import.meta.env.PUBLIC_API_BASE || "http://localhost:3000"
const rawPath = Astro.params.path ?? ""
const segments = rawPath.split("/").filter(Boolean)
const slug = segments[0] || ""
const rawSection = segments[1]?.toLowerCase() || ""

const validSections = ["home","about","services","pricing","cases","faq","blog","contact","privacy","terms","tokushoho"]
const section = validSections.includes(rawSection) ? rawSection : "home"

if (!slug) return Astro.redirect("/demo", 302)

interface ApiResult { error?: string }

function isDesignSpec(value: unknown): value is DemoDesignSpec {
  return typeof value === "object" && value !== null &&
    "schema_version" in value && "design_philosophy" in value &&
    "design_tokens" in value && "pages" in value
}

let spec: DemoDesignSpec | null = null
let error: string | null = null

try {
  const response = await fetch(`${API_BASE}/api/demo-designs/${encodeURIComponent(slug)}`, {
    headers: { "x-source": "astro-design-root" },
    signal: AbortSignal.timeout(15000),
  })

  if (response.ok) {
    const data = await response.json()
    if (isDesignSpec(data)) {
      spec = data
    } else if ((data as ApiResult).error) {
      error = (data as ApiResult).error ?? "invalid spec"
    }
  } else if (response.status !== 404) {
    error = `API ${response.status}`
  }
} catch (e) {
  error = e instanceof Error ? e.message : "fetch failed"
}

// Validate the requested section exists in spec
if (spec && !spec.pages[section]) {
  error = `section "${section}" not found`
  spec = null
}
---

{
  spec ? (
    <DesignRoot spec={spec} section={section} />
  ) : (
    <html lang="ja">
      <head><meta charset="UTF-8" /><title>Demo Not Ready</title></head>
      <body style="font-family:system-ui;display:grid;place-items:center;min-height:100vh;background:#f8fafc;color:#64748b">
        <div style="text-align:center">
          <h1 style="font-size:1.5rem;margin-bottom:0.5rem">Design spec not yet generated</h1>
          <p style="font-size:0.9rem">{error ?? "Run enrichment to generate this demo."}</p>
        </div>
      </body>
    </html>
  )
}

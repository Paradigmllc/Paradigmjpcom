---
import HeroIsland from '../../components/islands/HeroIsland'
import ScrollRevealIsland from '../../components/islands/ScrollRevealIsland'

const services = [
  { title: '建築工事', body: '新築から大規模改修まで。4世代で培った技術力。' },
  { title: 'リノベーション', body: '古さを価値に変える。住まいに新しい息吹を。' },
  { title: '耐震診断', body: '最新の診断技術で建物の安全性を見える化。' },
  { title: '解体工事', body: '安全第一。近隣配慮と廃材リサイクルまで徹底。' },
]
---
<html lang="ja"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>山田建設株式会社</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">
<style is:inline>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'Inter','Noto Sans JP',sans-serif;background:#000;color:#f5f5f7;line-height:1.47;-webkit-font-smoothing:antialiased;overflow-x:hidden}
.nav{position:fixed;top:0;left:0;right:0;z-index:100;height:44px;display:flex;align-items:center;justify-content:space-between;padding:0 clamp(16px,3vw,22px);background:rgba(0,0,0,.8);backdrop-filter:saturate(180%) blur(20px)}
.nav-brand{font-size:16px;font-weight:500;color:#f5f5f7;text-decoration:none;opacity:1}
.nav-links{display:flex;gap:24px}
.nav-links a{font-size:12px;color:#f5f5f7;text-decoration:none;opacity:.8}
.section{padding:clamp(60px,10vw,120px) clamp(16px,3vw,24px);text-align:center}
.section-light{background:#fff;color:#1d1d1f}
.section-gray{background:#f5f5f7;color:#1d1d1f}
h2{font-size:clamp(32px,5vw,56px);font-weight:600;letter-spacing:-.015em;line-height:1.05;margin-bottom:8px}
.sub{font-size:clamp(17px,2vw,21px);color:#86868b;margin-bottom:48px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:24px;max-width:1100px;margin:0 auto}
.card{background:#fff;padding:40px 32px;border-radius:18px;box-shadow:0 4px 24px rgba(0,0,0,.04)}
.card h3{font-size:21px;font-weight:500;margin-bottom:8px;color:#1d1d1f}
.card p{font-size:15px;line-height:1.7;color:#86868b}
.footer{padding:40px 24px;background:#f5f5f7;color:#86868b;font-size:12px;text-align:center}
@media(max-width:768px){.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<nav class="nav"><a href="/yamada/" class="nav-brand">山田建設</a><div class="nav-links"><a href="/yamada/">Home</a><a href="/yamada/about/">About</a><a href="/yamada/services/">Services</a><a href="/yamada/contact/">Contact</a></div></nav>

<HeroIsland title="大阪を、創り続ける。" subtitle="1950年創業。4世代の技術と信頼で、確かな未来を築きます。" ctaLabel="サービスを見る" ctaHref="/yamada/services/" variant="gradient" accentColor="#2997ff" client:only="react" />

<section class="section section-light">
  <ScrollRevealIsland client:only="react"><h2>サービス</h2><p class="sub">確かな技術で、あなたのビジョンを形に</p></ScrollRevealIsland>
  <div class="grid">
    {services.map((s, i) => (
      <ScrollRevealIsland delay={i * 0.1} client:only="react">
        <div class="card"><h3>{s.title}</h3><p>{s.body}</p></div>
      </ScrollRevealIsland>
    ))}
  </div>
</section>

<section class="section section-gray">
  <ScrollRevealIsland client:only="react"><h2>4世代の信頼</h2><p class="sub">1950年から大阪の街とともに</p></ScrollRevealIsland>
  <div style="display:flex;gap:48px;justify-content:center;flex-wrap:wrap">
    {[{v:'1950',l:'創業'},{v:'4',l:'世代'},{v:'2000+',l:'プロジェクト'}].map((s,i) => (
      <ScrollRevealIsland delay={i*.15} client:only="react"><div style="text-align:center"><div style="font-size:clamp(40px,6vw,64px);font-weight:700;color:#2997ff;line-height:1">{s.v}</div><div style="font-size:14px;color:#86868b;margin-top:8px">{s.l}</div></div></ScrollRevealIsland>
    ))}
  </div>
</section>

<section class="section" style="background:linear-gradient(180deg,#000,#1d1d1f)">
  <ScrollRevealIsland client:only="react"><h2 style="color:#fff">まずはご相談ください</h2><p class="sub" style="color:#86868b">無料見積もり・現地調査を承ります</p><a href="/yamada/contact/" style="display:inline-flex;padding:14px 32px;background:#2997ff;color:#fff;border-radius:980px;font-size:17px;font-weight:500;text-decoration:none">お問い合わせ</a></ScrollRevealIsland>
</section>

<footer class="footer">&copy; 2024 山田建設株式会社</footer>
</body></html>

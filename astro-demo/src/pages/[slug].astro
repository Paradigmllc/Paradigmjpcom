---
/**
 * [slug].astro — Dynamic Theme Demo Page Renderer (Delivery Quality v2)
 *
 * Fetches JSON blueprint directly from Supabase and renders matching widgets.
 */
import { THEME_WIDGETS, THEME_META, type ThemeName } from '../themes/registry.astro'

// ─── Config ────────────────────────────────────────────────────────────────
const SUPABASE_URL = import.meta.env.SUPABASE_URL || 'http://supabase-rest-1:3000'
const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || ''
const SUPABASE_SERVICE_KEY = import.meta.env.SUPABASE_SERVICE_ROLE_KEY || ''

const { slug } = Astro.params

// ─── Fetch from Supabase directly ──────────────────────────────────────────
interface DemoBlock { id: string; type: string; props: Record<string, any> }
interface DemoPage {
  slug: string; theme: ThemeName; blocks: DemoBlock[]
  meta: Record<string, any>; title?: string
}

let page: DemoPage | null = null
let fetchError: string | null = null

try {
  const key = SUPABASE_SERVICE_KEY || SUPABASE_ANON_KEY
  const res = await fetch(
    `${SUPABASE_URL}/rest/v1/theme_demo_pages?slug=eq.${encodeURIComponent(slug)}&is_published=eq.true&select=*`,
    {
      headers: {
        'apikey': key,
        'Authorization': `Bearer ${key}`,
        'Accept': 'application/json',
      },
      signal: AbortSignal.timeout(10000),
    },
  )
  if (res.ok) {
    const data = await res.json()
    if (Array.isArray(data) && data.length > 0) {
      page = data[0] as DemoPage
    } else {
      fetchError = 'not_found'
    }
  } else {
    fetchError = `Supabase error ${res.status}`
    console.error(`[slug] Supabase fetch failed: ${res.status}`)
  }
} catch (e) {
  fetchError = e instanceof Error ? e.message : String(e)
  console.error(`[slug] fetch error:`, fetchError)
}

const theme: ThemeName = page?.theme || 'astrowind'
const blocks = page?.blocks || []
const meta = page?.meta || {}
const pageTitle = page?.title || meta?.title || `Demo — ${slug}`
const pageDesc = meta?.description || ''
const locale: 'ja' | 'en' = meta?.locale || 'ja'
const isJa = locale === 'ja'
const t = {
  nav: { home: isJa ? 'ホーム' : 'Home', services: isJa ? 'サービス' : 'Services', pricing: isJa ? '料金' : 'Pricing', cases: isJa ? '実績' : 'Cases', faq: 'FAQ', about: isJa ? '会社概要' : 'About', blog: isJa ? 'ブログ' : 'Blog', contact: isJa ? 'お問合せ' : 'Contact' },
  cta: isJa ? '無料相談を予約' : 'Book Free Consult',
  footer: { copyright: `© ${new Date().getFullYear()} ${meta?.company_name || 'Paradigm'} LLC. All rights reserved.`, tagline: isJa ? 'データ診断に基づくパーソナライズドWeb改善提案' : 'Personalized web improvement proposals based on data diagnostics' },
}
const themeMeta = THEME_META[theme] || THEME_META.astrowind
const themeWidgets = THEME_WIDGETS[theme] || THEME_WIDGETS.astrowind
const accentColor = meta?.accentColor || '#7c3aed'
const accentColorDark = meta?.accentColorDark || '#5b21b6'
const accentColorLight = meta?.accentColorLight || '#a78bfa'
const calUrl = meta?.calBookingUrl || 'https://cal.com/paradigm-jp/15min'
const companyName = meta?.company_name || 'Paradigm'
const navLinks = [
  { href: `/demo/${slug}`, label: t.nav.home },
  { href: `/demo/${slug}/services`, label: t.nav.services },
  { href: `/demo/${slug}/pricing`, label: t.nav.pricing },
  { href: `/demo/${slug}/cases`, label: t.nav.cases },
  { href: `/demo/${slug}/faq`, label: t.nav.faq },
  { href: `/demo/${slug}/about`, label: t.nav.about },
  { href: `/demo/${slug}/blog`, label: t.nav.blog },
  { href: `/demo/${slug}/contact`, label: t.nav.contact },
]
const isAstroWind = theme === 'astrowind'
const isScrewFast = theme === 'screwfast'
const isAstroship = theme === 'astroship'
const fontFamily = themeMeta.fontFamily || 'Inter, Noto Sans JP, sans-serif'
const accR = parseInt(accentColor.slice(1,3),16)
const accG = parseInt(accentColor.slice(3,5),16)
const accB = parseInt(accentColor.slice(5,7),16)
const themeCSS = `
    :root {
      --brand: ${accentColor};
      --brand-dark: ${accentColorDark};
      --brand-light: ${accentColorLight};
      --brand-rgb: ${accR},${accG},${accB};
      ${isAstroWind ? '--aw-color-primary-500: var(--brand);--aw-color-primary-600: var(--brand);--aw-color-primary-700: var(--brand-dark);--aw-color-primary-400: var(--brand-light);' : ''}
    }
    body { font-family: ${fontFamily}; }
  `
---

<!doctype html>
<html lang={locale} class={isAstroWind ? '' : (isScrewFast ? 'scrollbar-hide scroll-pt-16' : '')}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content={pageDesc} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" />
  {isAstroship && <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&display=swap" rel="stylesheet" />}

  <!-- Theme CSS Variables -->
  <style set:html={themeCSS} />

  <!-- Anti-FOUC dark mode -->
  <script is:inline>
    (function() {
      const stored = localStorage.getItem('theme');
      if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    })();
  </script>
</head>
<body class:list={['min-h-screen antialiased', themeMeta.bgClass, themeMeta.textClass]}>
  {
    fetchError === 'not_found' ? (
      <div class="flex min-h-screen items-center justify-center">
        <div class="text-center max-w-md px-6">
          <div class="text-8xl font-black gradient-text mb-6">404</div>
          <h1 class="text-2xl font-bold mb-3">{isJa ? 'デモページが見つかりません' : 'Demo Page Not Found'}</h1>
          <p class="opacity-60 mb-8">{isJa ? `"${slug}" のデモはまだ生成されていません。診断後に自動生成されます。` : `Demo for "${slug}" not yet generated. Created automatically after diagnostic.`}</p>
          <a href="/demo" class="btn-primary inline-flex items-center gap-2 rounded-xl px-6 py-3 font-semibold text-white shadow-lg hover:-translate-y-0.5 transition-all" style={`background:linear-gradient(135deg,${accentColor},${accentColorDark})`}>
            {isJa ? 'ギャラリーに戻る' : 'Back to Gallery'}
          </a>
        </div>
      </div>
    ) : fetchError ? (
      <div class="flex min-h-screen items-center justify-center">
        <div class="text-center max-w-md px-6">
          <div class="text-6xl mb-6">&#x26A0;&#xFE0F;</div>
          <h1 class="text-2xl font-bold mb-3">{isJa ? '読み込みエラー' : 'Loading Error'}</h1>
          <p class="opacity-60 mb-8">{fetchError}</p>
          <a href="/demo" class="btn-primary inline-flex items-center gap-2 rounded-xl px-6 py-3 font-semibold text-white shadow-lg hover:-translate-y-0.5 transition-all" style={`background:linear-gradient(135deg,${accentColor},${accentColorDark})`}>
            {isJa ? 'ギャラリーに戻る' : 'Back to Gallery'}
          </a>
        </div>
      </div>
    ) : (
      <>
        <!-- ═══ HEADER / NAV ═══ -->
        <header id="header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300" data-aw-sticky-header>
          <div class="flex items-center justify-between h-16 px-4 sm:px-6 max-w-7xl mx-auto">
            <a href={`/demo/${slug}`} class="flex items-center gap-3 group shrink-0">
              <div class="flex h-8 w-8 items-center justify-center rounded-lg font-black text-white text-sm" style={`background:linear-gradient(135deg,${accentColor},${accentColorDark})`}>{companyName.charAt(0)}</div>
              <span class="hidden sm:block text-sm font-bold truncate max-w-[160px]">{companyName}</span>
            </a>
            <nav class="hidden lg:flex items-center gap-1">
              {navLinks.map(link => (
                <a href={link.href} class="px-3 py-1.5 rounded-lg text-sm font-medium transition-colors hover:bg-black/5 dark:hover:bg-white/5">{link.label}</a>
              ))}
            </nav>
            <div class="flex items-center gap-3">
              <button onclick="document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light')" class="p-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors" aria-label="Toggle theme">
                <svg class="h-4 w-4 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                <svg class="h-4 w-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
              </button>
              <a href={calUrl} target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold text-white shadow-lg hover:-translate-y-0.5 transition-all" style={`background:linear-gradient(135deg,${accentColor},${accentColorDark})`}>
                {t.cta}
              </a>
              <button id="mobile-menu-btn" onclick="document.querySelector('#mobile-menu')?.classList.toggle('hidden');this.classList.toggle('expanded')" class="lg:hidden p-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 group" aria-label="Menu">
                <svg class="h-5 w-5 hamburger-top transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M4 6h16"/></svg>
                <svg class="h-5 w-5 hamburger-middle transition-opacity mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M4 12h16"/></svg>
                <svg class="h-5 w-5 hamburger-bottom transition-transform mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M4 18h16"/></svg>
              </button>
            </div>
          </div>
          <!-- Mobile menu -->
          <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-200/10 dark:border-white/5 bg-white/95 dark:bg-gray-950/95 backdrop-blur-xl">
            <nav class="flex flex-col px-4 py-3 space-y-1">
              {navLinks.map(link => (
                <a href={link.href} class="px-3 py-2 rounded-lg text-sm font-medium hover:bg-black/5 dark:hover:bg-white/5 transition-colors">{link.label}</a>
              ))}
              <a href={calUrl} target="_blank" rel="noopener noreferrer" class="mt-2 text-center rounded-lg px-4 py-2.5 text-sm font-semibold text-white" style={`background:linear-gradient(135deg,${accentColor},${accentColorDark})`}>{t.cta}</a>
            </nav>
          </div>
        </header>

        <!-- ═══ ORBS (AstroWind) ═══ -->
        {isAstroWind && (
          <div class="fixed inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
            <div class="absolute -top-[20%] -right-[10%] w-[600px] h-[600px] rounded-full opacity-20 blur-[120px] animate-float" style={`background:${accentColor}`}></div>
            <div class="absolute -bottom-[10%] -left-[5%] w-[400px] h-[400px] rounded-full opacity-10 blur-[120px] animate-float" style={`background:${accentColorLight}; animation-delay: 2s; animation-duration: 25s`}></div>
          </div>
        )}

        <main class="pt-16">
          <!-- ═══ WIDGETS ═══ -->
          {
            blocks.map((block: DemoBlock) => {
              const Widget = themeWidgets[block.type]
              if (!Widget) {
                console.warn(`[slug] Unknown widget "${block.type}" for theme "${theme}"`)
                return null
              }
              return <div class="widget-section intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade" data-animate>
                <Widget {...block.props} />
              </div>
            })
          }
        </main>

        <!-- ═══ FOOTER ═══ -->
        <footer class="border-t border-gray-200/10 dark:border-white/5 py-16 px-6 mt-20">
          <div class="max-w-7xl mx-auto">
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
              <div>
                <div class="flex items-center gap-2 mb-4">
                  <div class="flex h-7 w-7 items-center justify-center rounded-lg font-black text-white text-xs" style={`background:linear-gradient(135deg,${accentColor},${accentColorDark})`}>{companyName.charAt(0)}</div>
                  <span class="text-sm font-bold">{companyName}</span>
                </div>
                <p class="text-xs opacity-50 leading-relaxed max-w-[200px]">{t.footer.tagline}</p>
              </div>
              <div>
                <h4 class="text-xs font-bold opacity-60 uppercase tracking-wider mb-4">{isJa ? 'サービス' : 'Services'}</h4>
                <ul class="space-y-2.5">
                  <li><a href={`/demo/${slug}/services`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">{isJa ? 'Web制作' : 'Web Dev'}</a></li>
                  <li><a href={`/demo/${slug}/services`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">SEO/MEO</a></li>
                  <li><a href={`/demo/${slug}/pricing`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">{isJa ? '料金プラン' : 'Pricing'}</a></li>
                  <li><a href={`/demo/${slug}/cases`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">{isJa ? '導入事例' : 'Case Studies'}</a></li>
                </ul>
              </div>
              <div>
                <h4 class="text-xs font-bold opacity-60 uppercase tracking-wider mb-4">{isJa ? '会社情報' : 'Company'}</h4>
                <ul class="space-y-2.5">
                  <li><a href={`/demo/${slug}/about`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">{isJa ? '会社概要' : 'About'}</a></li>
                  <li><a href={`/demo/${slug}/blog`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">{isJa ? 'ブログ' : 'Blog'}</a></li>
                  <li><a href={`/demo/${slug}/contact`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">{isJa ? 'お問合せ' : 'Contact'}</a></li>
                  <li><a href={`/demo/${slug}/faq`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">FAQ</a></li>
                </ul>
              </div>
              <div>
                <h4 class="text-xs font-bold opacity-60 uppercase tracking-wider mb-4">{isJa ? '法的情報' : 'Legal'}</h4>
                <ul class="space-y-2.5">
                  <li><a href={`/demo/${slug}/terms`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">{isJa ? '利用規約' : 'Terms'}</a></li>
                  <li><a href={`/demo/${slug}/privacy`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">{isJa ? 'プライバシー' : 'Privacy'}</a></li>
                  {locale === 'ja' && <li><a href={`/demo/${slug}/tokushoho`} class="text-xs opacity-40 hover:opacity-70 transition-opacity">{isJa ? '特商法表記' : 'Commercial Law'}</a></li>}
                </ul>
              </div>
            </div>
            <div class="pt-8 border-t border-gray-200/10 dark:border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs opacity-30">
              <span>{t.footer.copyright}</span>
              <span>Powered by <a href="https://paradigmjp.com" class="hover:opacity-70 transition-opacity" style={`color:${accentColor}`}>Paradigm</a> — Theme: {themeMeta.label}</span>
            </div>
          </div>
        </footer>
      </>
    )
  }

  <!-- ═══ SCRIPTS ═══ -->
  <script is:inline>
    // IntersectionObserver — scroll-triggered fade animations
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            e.target.removeAttribute('no-intersect');
            e.target.classList.add('intersect:animate-fade');
          }
        });
      }, { threshold: 0.15 });
      document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));

      // Sticky header scroll effect
      const header = document.querySelector('#header[data-aw-sticky-header]');
      if (header) {
        window.addEventListener('scroll', () => {
          header.classList.toggle('scroll', window.scrollY > 60);
        });
      }
    });
  </script>
</body>
</html>

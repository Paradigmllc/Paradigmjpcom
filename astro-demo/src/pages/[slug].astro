---
// Only redirect old demo slugs. Let Astro's file routing handle new pages.
const slug = Astro.params.slug ?? ""
const oldSlugs = ["demo", "sample-restaurant", "demos"]
if (oldSlugs.includes(slug) || slug.startsWith("sample-") || slug.startsWith("demo/")) {
  return Astro.redirect("/demos/trattoria-soleil/index.html", 301)
}
// Not an old demo — return 404, don't interfere
return new Response(null, { status: 404 })
---

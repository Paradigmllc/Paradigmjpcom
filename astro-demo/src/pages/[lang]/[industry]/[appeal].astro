---
// Phase 3-2: the legacy industry×appeal LP matrix is retired. Every industry URL now
// 301-redirects to its canonical full-site sample (/demo/sample-{industry}), so the
// public demo surface is the navigable full site, not a single-page LP.
const VALID_INDUSTRIES = [
  "restaurant",
  "construction",
  "dental",
  "beauty_salon",
  "retail",
  "accounting",
  "cleaning",
  "consulting",
] as const

const industry = (Astro.params.industry ?? "consulting").toLowerCase()
const target = (VALID_INDUSTRIES as readonly string[]).includes(industry) ? industry : "consulting"

return Astro.redirect(`/demo/sample-${target}`, 301)
---

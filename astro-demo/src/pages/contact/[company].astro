---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCompany, type CompanyData } from '../../data/demoData';

export function getStaticPaths() {
  return [
    { params: { company: 'paradigm' } },
    { params: { company: 'sampletech' } },
    { params: { company: 'tokyocommerce' } },
  ];
}

const { company } = Astro.params;
const data: CompanyData = getCompany(company);
const loc = data.locale;
const t = (ja: string, en: string) => (loc === 'en' ? en : ja);
const title = t(`${data.nameJa} | お問い合わせ`, `${data.name} | Contact`);
const desc = t(`${data.nameJa}へのお問い合わせページ。`, `Contact ${data.name}.`);

const crumbs = [
  { label: { ja: 'ホーム', en: 'Home' }, href: '/' },
  { label: { ja: 'お問い合わせ', en: 'Contact' }, href: `/contact/${company}` },
];
---

<BaseLayout title={title} description={desc} locale={loc}>
  <Navbar locale={loc} current={`/contact/${company}`} />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumb items={crumbs} locale={loc} />

    <div class="my-8">
      <h1 class="text-3xl font-bold text-gray-900 leading-tight mb-2">{t('お問い合わせ', 'Contact Us')}</h1>
      <p class="text-gray-600 max-w-2xl">{t('サービスに関するご質問・お見積りのご依頼など、お気軽にお問い合わせください。', 'Please feel free to contact us for any questions or quote requests.')}</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
      <!-- Sidebar -->
      <aside class="lg:col-span-1 order-2 lg:order-1">
        <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 space-y-6 sticky top-24">
          <div>
            <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">{t('企業情報', 'Company Info')}</h3>
            <p class="font-bold text-gray-900 text-lg">{t(data.nameJa, data.name)}</p>
          </div>
          <div class="space-y-3">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <div>
                <p class="text-xs text-gray-400">{t('電話番号', 'Phone')}</p>
                <a href={`tel:${data.phone}`} class="text-sm font-medium text-gray-700 hover:text-brand-600 transition">{data.phone}</a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <div>
                <p class="text-xs text-gray-400">{t('メールアドレス', 'Email')}</p>
                <a href={`mailto:${data.email}`} class="text-sm font-medium text-gray-700 hover:text-brand-600 transition">{data.email}</a>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <div>
                <p class="text-xs text-gray-400">{t('所在地', 'Address')}</p>
                <p class="text-sm font-medium text-gray-700 leading-relaxed">{t(data.addressJa, data.address)}</p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 text-brand-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <p class="text-xs text-gray-400">{t('営業時間', 'Business Hours')}</p>
                <p class="text-sm font-medium text-gray-700">{t(data.businessHoursJa, data.businessHours)}</p>
              </div>
            </div>
          </div>
          <!-- Map Placeholder -->
          <div class="bg-gray-200 rounded-lg h-36 flex items-center justify-center">
            <div class="text-center text-gray-400 text-xs">
              <svg class="w-8 h-8 mx-auto mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
              Google Maps
            </div>
          </div>
        </div>
      </aside>

      <!-- Form -->
      <div class="lg:col-span-2 order-1 lg:order-2">
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8 space-y-5"
        >
          <!-- Web3Forms Access Key -->
          <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
          <input type="hidden" name="subject" value={`[${data.nameJa}] ${t('お問い合わせ', 'Contact Form Submission')}`} />
          <input type="hidden" name="from_name" value={data.nameJa} />

          <!-- Honeypot -->
          <div class="hidden">
            <input type="checkbox" name="botcheck" class="hidden" />
          </div>

          <!-- reCAPTCHA note -->
          <p class="text-xs text-gray-400 -mb-2">
            {t(
              'このフォームは reCAPTCHA によって保護されています。',
              'This form is protected by reCAPTCHA.'
            )}
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">
                {t('お名前', 'Name')} <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
                placeholder={t('山田 太郎', 'John Smith')}
              />
            </div>
            <div>
              <label for="company_name" class="block text-sm font-medium text-gray-700 mb-1.5">
                {t('会社名', 'Company Name')}
              </label>
              <input
                type="text"
                id="company_name"
                name="company_name"
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
                placeholder={t('株式会社〇〇', 'Company Inc.')}
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">
                {t('メールアドレス', 'Email')} <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
                placeholder="email@example.com"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-gray-700 mb-1.5">
                {t('電話番号', 'Phone')}
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition"
                placeholder="03-1234-5678"
              />
            </div>
          </div>

          <div>
            <label for="inquiry_type" class="block text-sm font-medium text-gray-700 mb-1.5">
              {t('お問い合わせ種別', 'Inquiry Type')}
            </label>
            <select
              id="inquiry_type"
              name="inquiry_type"
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition bg-white"
            >
              <option value="">{t('選択してください', 'Please select')}</option>
              <option value="service">{t('サービスについて', 'About Services')}</option>
              <option value="quote">{t('お見積り依頼', 'Quote Request')}</option>
              <option value="other">{t('その他', 'Other')}</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-gray-700 mb-1.5">
              {t('お問い合わせ内容', 'Message')} <span class="text-red-500">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="6"
              required
              class="w-full px-4 py-2.5 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-brand-500 focus:border-brand-500 outline-none transition resize-y"
              placeholder={t('お問い合わせ内容をこちらにご記入ください。', 'Please write your inquiry here.')}
            ></textarea>
          </div>

          <!-- Privacy consent -->
          <div class="flex items-start gap-2">
            <input type="checkbox" id="privacy_consent" name="privacy_consent" required class="mt-1 rounded border-gray-300 text-brand-600 focus:ring-brand-500" />
            <label for="privacy_consent" class="text-xs text-gray-600 leading-relaxed">
              {t(
                'プライバシーポリシーに同意します',
                'I agree to the Privacy Policy'
              )}
              <a href={`/privacy/${company}`} class="text-brand-600 underline ml-1">{t('（詳細）', '(Details)')}</a>
            </label>
          </div>

          <!-- Response message area -->
          <div id="form-result" class="hidden text-sm p-4 rounded-lg"></div>

          <!-- Submit -->
          <button
            type="submit"
            id="form-submit-btn"
            class="w-full sm:w-auto px-8 py-3 bg-brand-600 text-white font-semibold text-sm rounded-lg hover:bg-brand-700 focus:ring-4 focus:ring-brand-200 transition-all duration-200 flex items-center justify-center gap-2"
          >
            <span id="btn-text">{t('送信する', 'Send Message')}</span>
            <svg id="btn-spinner" class="hidden w-4 h-4 animate-spin" viewBox="0 0 24 24" fill="none">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </main>

  <Footer locale={loc} />

  <script>
    const form = document.getElementById('contact-form');
    const result = document.getElementById('form-result');
    const btnText = document.getElementById('btn-text');
    const spinner = document.getElementById('btn-spinner');
    const submitBtn = document.getElementById('form-submit-btn');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = form.querySelector('#email').value;
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showResult('error', '有効なメールアドレスを入力してください / Please enter a valid email address.');
        return;
      }
      btnText.textContent = '送信中...';
      spinner.classList.remove('hidden');
      submitBtn.disabled = true;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
        });
        const data = await response.json();
        if (data.success) {
          showResult('success', 'お問い合わせありがとうございます。確認メールをお送りしました。 / Thank you! A confirmation email has been sent.');
          form.reset();
        } else {
          showResult('error', '送信に失敗しました。お手数ですが、再度お試しいただくか、メールで直接ご連絡ください。 / Submission failed. Please try again or contact us by email.');
        }
      } catch {
        showResult('error', '通信エラーが発生しました。時間をおいて再度お試しください。 / A network error occurred. Please try again later.');
      } finally {
        btnText.textContent = '送信する';
        spinner.classList.add('hidden');
        submitBtn.disabled = false;
      }
    });

    function showResult(type, msg) {
      if (!result) return;
      result.classList.remove('hidden');
      result.textContent = msg;
      result.className = `text-sm p-4 rounded-lg ${type === 'success' ? 'bg-green-50 text-green-700 border border-green-200' : 'bg-red-50 text-red-700 border border-red-200'}`;
      result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: title,
    description: desc,
    url: `https://paradigm.co.jp/contact/${company}`,
    mainEntity: {
      '@type': 'Organization',
      name: data.nameJa,
      telephone: data.phone,
      email: data.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: data.addressJa,
        addressLocality: '渋谷区',
        addressRegion: '東京都',
        postalCode: '150-0043',
        addressCountry: 'JP',
      },
    },
  })} />
</BaseLayout>

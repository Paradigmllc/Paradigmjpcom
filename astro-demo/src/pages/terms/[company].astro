---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCompany, type CompanyData } from '../../data/demoData';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { company: 'paradigm' } },
    { params: { company: 'sampletech' } },
    { params: { company: 'tokyocommerce' } },
  ];
}

const { company } = Astro.params;
const data: CompanyData = getCompany(company);
const loc = data.locale;
const t = (ja: string, en: string) => (loc === 'en' ? en : ja);
const title = t(`${data.nameJa} | 利用規約`, `${data.name} | Terms of Service`);
const desc = t(`${data.nameJa}の利用規約ページ。`, `${data.name} Terms of Service.`);
const lastUpdated = '2025-06-01';

const crumbs = [
  { label: { ja: 'ホーム', en: 'Home' }, href: '/' },
  { label: { ja: '利用規約', en: 'Terms of Service' }, href: `/terms/${company}` },
];

const articles = {
  ja: [
    { num: 1, title: '適用範囲', body: '本規約は、{companyName}（以下「当社」）が提供するすべてのサービス（以下「本サービス」）の利用条件を定めるものです。本サービスをご利用いただくすべてのお客様（以下「利用者」）は、本規約に同意いただいたものとみなします。' },
    { num: 2, title: '利用登録', body: '利用者は、当社所定の方法により利用登録を行うものとします。当社は、以下の事由に該当する場合、利用登録を承認しないことがあります。\n(1) 登録内容に虚偽、誤記または記載漏れがあった場合\n(2) 過去に本規約違反等により利用停止処分を受けたことがある場合\n(3) その他、当社が不適切と判断した場合' },
    { num: 3, title: '利用者IDおよびパスワードの管理', body: '利用者は、自己の責任において、本サービスの利用者IDおよびパスワードを適切に管理するものとします。利用者IDおよびパスワードが第三者によって使用されたことによって生じた損害について、当社は一切の責任を負いません。' },
    { num: 4, title: '禁止事項', body: '利用者は、本サービスの利用にあたり、以下の行為を行ってはなりません。\n(1) 法令または公序良俗に違反する行為\n(2) 犯罪行為に関連する行為\n(3) 当社のサーバーまたはネットワークの機能を破壊・妨害する行為\n(4) 当社のサービス運営を妨害するおそれのある行為\n(5) 他の利用者に関する個人情報等を収集または蓄積する行為\n(6) 不正アクセスまたはこれを試みる行為\n(7) 他の利用者になりすます行為\n(8) 当社のサービスに関連して、反社会的勢力に対して直接または間接に利益を供与する行為\n(9) その他、当社が不適切と判断する行為' },
    { num: 5, title: '本サービスの提供の停止等', body: '当社は、以下のいずれかの事由があると判断した場合、利用者に事前通知することなく本サービスの全部または一部の提供を停止または中断することができるものとします。\n(1) 本サービスに係るコンピューターシステムの保守点検または更新を行う場合\n(2) 地震、落雷、火災、停電または天災などの不可抗力により、本サービスの提供が困難となった場合\n(3) コンピューターまたは通信回線等が事故により停止した場合\n(4) その他、当社が本サービスの提供が困難と判断した場合' },
    { num: 6, title: '知的財産権', body: '本サービスに含まれるすべてのコンテンツ（文章、画像、デザイン、ロゴ、プログラム等）に関する知的財産権は、当社または正当な権利者に帰属します。利用者は、当社の事前の書面による承諾なく、これらを複製、改変、転載、配布することはできません。' },
    { num: 7, title: '利用制限および登録抹消', body: '当社は、利用者が以下のいずれかに該当する場合、事前の通知なく、利用者に対して本サービスの全部もしくは一部の利用を制限し、または利用者としての登録を抹消することができるものとします。\n(1) 本規約のいずれかの条項に違反した場合\n(2) 登録事項に虚偽の事実があることが判明した場合\n(3) 当社からの連絡に対し、一定期間返答がない場合\n(4) その他、当社が本サービスの利用を適当でないと判断した場合' },
    { num: 8, title: '免責事項', body: '当社は、本サービスに事実上または法律上の瑕疵（安全性、信頼性、正確性、完全性、有効性、特定の目的への適合性、セキュリティなどに関する欠陥、エラーやバグ、権利侵害などを含みます）がないことを明示的にも黙示的にも保証しておりません。当社は、本サービスによって利用者に生じたあらゆる損害について、一切の責任を負いません。ただし、当社と利用者との間の契約が消費者契約法に定める消費者契約となる場合、この免責規定は適用されません。' },
    { num: 9, title: 'サービス内容の変更等', body: '当社は、利用者に通知することなく、本サービスの内容を変更し、または本サービスの提供を中止することができるものとし、これによって利用者に生じた損害について一切の責任を負いません。' },
    { num: 10, title: '損害賠償', body: '利用者が本規約に違反したことにより当社に損害が生じた場合、利用者は当社に対してその損害を賠償する責任を負います。' },
    { num: 11, title: '秘密保持', body: '利用者は、本サービスの利用に関連して当社が利用者に対して秘密情報として開示した情報について、当社の事前の書面による承諾がある場合を除き、第三者に開示または漏洩してはなりません。' },
    { num: 12, title: '反社会的勢力の排除', body: '利用者は、現在および将来にわたり、暴力団、暴力団員、暴力団準構成員、総会屋、社会運動標榜ゴロ、特殊知能暴力集団、その他これらに準ずる者（以下「反社会的勢力」）に該当しないことを表明し、保証します。当社は、利用者が反社会的勢力に該当すると判断した場合、催告なしに契約を解除することができます。' },
    { num: 13, title: '準拠法', body: '本規約の解釈には、日本法を準拠法とします。' },
    { num: 14, title: '管轄裁判所', body: '本サービスに関して紛争が生じた場合には、当社の本店所在地を管轄する裁判所を第一審の専属的合意管轄裁判所とします。' },
    { num: 15, title: '規約の改定', body: '当社は、以下の場合に本規約を改定できるものとします。\n(1) 規約の改定が利用者の一般の利益に適合するとき\n(2) 規約の改定が契約の目的に反せず、かつ改定の必要性、改定後の内容の相当性、その他改定に係る事情に照らして合理的なものであるとき\n当社は、規約の改定にあたり、改定後の規約の効力発生日の1ヶ月前までに、当社ウェブサイトに掲載する方法により利用者に周知します。' },
  ],
  en: [
    { num: 1, title: 'Scope of Application', body: 'These Terms of Service (hereinafter "Terms") set forth the conditions for using all services (hereinafter "Services") provided by {companyName} (hereinafter "the Company"). All users (hereinafter "Users") of the Services are deemed to have agreed to these Terms.' },
    { num: 2, title: 'User Registration', body: 'Users shall register for use in accordance with the method prescribed by the Company. The Company may not approve registration in the following cases:\n(1) The registration details contain false information, errors, or omissions\n(2) The applicant has previously had their use suspended due to a violation of these Terms\n(3) Any other cases where the Company deems registration inappropriate' },
    { num: 3, title: 'User ID and Password Management', body: 'Users shall be responsible for properly managing their user ID and password for the Services. The Company shall not be liable for any damages arising from the use of a user ID or password by a third party.' },
    { num: 4, title: 'Prohibited Acts', body: 'Users shall not engage in the following acts when using the Services:\n(1) Acts that violate laws or public order and morals\n(2) Acts related to criminal activity\n(3) Acts that destroy or interfere with the Company\'s server or network functions\n(4) Acts that may interfere with the operation of the Company\'s services\n(5) Acts of collecting or accumulating personal information about other users\n(6) Unauthorized access or attempts thereof\n(7) Impersonating other users\n(8) Acts of directly or indirectly providing benefits to antisocial forces in connection with the Company\'s services\n(9) Any other acts the Company deems inappropriate' },
    { num: 5, title: 'Suspension of Services', body: 'The Company may suspend or interrupt the provision of all or part of the Services without prior notice to Users if any of the following applies:\n(1) When performing maintenance, inspection, or updates of computer systems related to the Services\n(2) When provision of the Services becomes difficult due to force majeure such as earthquakes, lightning, fire, power outages, or natural disasters\n(3) When computers or communication lines stop due to an accident\n(4) Any other cases where the Company deems provision of the Services difficult' },
    { num: 6, title: 'Intellectual Property Rights', body: 'All intellectual property rights relating to the content included in the Services (text, images, designs, logos, programs, etc.) belong to the Company or the rightful rights holders. Users may not reproduce, modify, reprint, or distribute these without prior written consent from the Company.' },
    { num: 7, title: 'Use Restrictions and Registration Cancellation', body: 'The Company may restrict the use of all or part of the Services or cancel a User\'s registration without prior notice in the following cases:\n(1) Violation of any provision of these Terms\n(2) Discovery of false information in registration details\n(3) No response to communications from the Company for a certain period\n(4) Any other cases where the Company deems continued use inappropriate' },
    { num: 8, title: 'Disclaimer', body: 'The Company does not warrant, expressly or impliedly, that the Services are free from defects (including defects relating to safety, reliability, accuracy, completeness, effectiveness, fitness for a particular purpose, security, errors, bugs, infringement of rights, etc.). The Company shall not be liable for any damages incurred by Users through the Services. However, if the contract between the Company and a User constitutes a consumer contract as defined in the Consumer Contract Act, this disclaimer shall not apply.' },
    { num: 9, title: 'Changes to Service Content', body: 'The Company may change the content of or discontinue the Services without notifying Users, and shall not be liable for any damages arising from such changes or discontinuation.' },
    { num: 10, title: 'Damages', body: 'If a User violates these Terms and causes damage to the Company, the User shall be liable for compensating the Company for such damage.' },
    { num: 11, title: 'Confidentiality', body: 'Users shall not disclose or leak to any third party any information disclosed by the Company as confidential in connection with the use of the Services, except with the prior written consent of the Company.' },
    { num: 12, title: 'Exclusion of Antisocial Forces', body: 'Users represent and warrant that they are not, now or in the future, organized crime groups, members of organized crime groups, associate members, corporate racketeers, social movement racketeers, special intellectual violent groups, or any other equivalent persons (hereinafter "Antisocial Forces"). The Company may terminate the contract without notice if it determines a User falls under the category of Antisocial Forces.' },
    { num: 13, title: 'Governing Law', body: 'These Terms shall be governed by and construed in accordance with the laws of Japan.' },
    { num: 14, title: 'Jurisdiction', body: 'Any disputes arising in connection with the Services shall be subject to the exclusive jurisdiction of the court having jurisdiction over the location of the Company\'s head office as the court of first instance.' },
    { num: 15, title: 'Amendment of Terms', body: 'The Company may amend these Terms in the following cases:\n(1) When the amendment of the Terms conforms to the general interest of Users\n(2) When the amendment of the Terms is not contrary to the purpose of the contract and is reasonable in light of the necessity of the amendment, the appropriateness of the amended content, and other circumstances related to the amendment\nWhen amending the Terms, the Company shall notify Users by posting on the Company\'s website at least one month prior to the effective date of the amended Terms.' },
  ],
};
---

<BaseLayout title={title} description={desc} locale={loc} noindex>
  <Navbar locale={loc} current={`/terms/${company}`} />

  <main class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumb items={crumbs} locale={loc} />

    <div class="mb-10 mt-4">
      <h1 class="text-3xl font-bold text-gray-900 leading-tight mb-2">
        {t(`${data.nameJa} 利用規約`, `${data.name} Terms of Service`)}
      </h1>
      <p class="text-sm text-gray-500">
        {t(`最終更新日: ${lastUpdated}`, `Last Updated: ${lastUpdated}`)}
      </p>
      <hr class="mt-6 border-gray-200" />
    </div>

    <div class="prose prose-slate max-w-none space-y-8 print:space-y-6">
      {(loc === 'ja' ? articles.ja : articles.en).map((article) => (
        <section class="pb-6 border-b border-gray-100 last:border-0">
          <h2 class="text-lg font-bold text-gray-900 flex items-start gap-3 mb-3">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-brand-100 text-brand-700 text-sm font-bold shrink-0 mt-0.5">
              {article.num}
            </span>
            <span>
              {loc === 'ja' ? `第${article.num}条（${article.title}）` : `Article ${article.num}: ${article.title}`}
            </span>
          </h2>
          <div class="text-sm leading-relaxed text-gray-700 pl-0 sm:pl-10 whitespace-pre-line">
            {article.body.replace('{companyName}', data.nameJa)}
          </div>
        </section>
      ))}
    </div>

    <div class="mt-12 p-6 bg-gray-50 rounded-xl text-center text-sm text-gray-500">
      <p>{t('以上', 'End of Terms of Service')}</p>
    </div>
  </main>

  <Footer locale={loc} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description: desc,
    url: `https://paradigm.co.jp/terms/${company}`,
    dateModified: lastUpdated,
    isPartOf: {
      '@type': 'WebSite',
      name: data.nameJa,
      url: 'https://paradigm.co.jp',
    },
  })} />
</BaseLayout>

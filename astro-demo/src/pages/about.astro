---
import DemoLayout from "../layouts/DemoLayout.astro"
import { getDemoData, JA_INDUSTRY } from "../keystatic/demo-data"

const slug = Astro.url.searchParams.get("slug") || "default-demo"
const data = await getDemoData(slug)
---

<DemoLayout title={`${data.customerName} — 会社概要`} accentColor={data.accentColor} accentColorDark={data.accentColorDark} accentColorLight={data.accentColorLight} lang="ja">
  <section class="section-padding">
    <div class="max-w-4xl mx-auto">
      <div class="badge mb-6"><span class="badge-dot"></span>About</div>
      <h1 class="text-4xl md:text-6xl font-black gradient-text mb-8">{data.customerName}</h1>
      <div class="glass p-10 space-y-6 text-white/60 leading-relaxed">
        <p class="text-lg">{data.customerName}は、{JA_INDUSTRY[data.industry] || data.industry}業界で長年の実績を持つ企業です。データに基づくWeb改善により、デジタルプレゼンスの強化を進めています。</p>
        <div class="grid sm:grid-cols-2 gap-6 pt-6 border-t border-white/5">
          <div><span class="text-xs text-white/30 uppercase tracking-wider">業界</span><p class="font-bold text-white mt-1">{JA_INDUSTRY[data.industry] || data.industry}</p></div>
          <div><span class="text-xs text-white/30 uppercase tracking-wider">所在地</span><p class="font-bold text-white mt-1">東京都</p></div>
          <div><span class="text-xs text-white/30 uppercase tracking-wider">従業員数</span><p class="font-bold text-white mt-1">50-200名</p></div>
          <div><span class="text-xs text-white/30 uppercase tracking-wider">Webサイト</span><p class="font-bold text-white mt-1">{data.domain || "—"}</p></div>
        </div>
      </div>
    </div>
  </section>
</DemoLayout>

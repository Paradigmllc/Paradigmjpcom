---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCompany, type CompanyData } from '../../data/demoData';

export const prerender = true;

export function getStaticPaths() {
  return [
    { params: { company: 'paradigm' } },
    { params: { company: 'sampletech' } },
    { params: { company: 'tokyocommerce' } },
  ];
}

const { company } = Astro.params;
const data: CompanyData = getCompany(company);
const loc = data.locale;
const t = (ja: string, en: string) => (loc === 'en' ? en : ja);
const title = t(`${data.nameJa} | 実績・事例`, `${data.name} | Case Studies`);
const desc = t(`${data.nameJa}の実績・事例集。`, `Case studies and portfolio from ${data.name}.`);

const crumbs = [
  { label: { ja: 'ホーム', en: 'Home' }, href: '/' },
  { label: { ja: '実績・事例', en: 'Case Studies' }, href: `/cases/${company}` },
];

const cases = [
  { cat: 'web', tags: { ja: ['Web制作'], en: ['Web Development'] }, client: { ja: 'ABCテクノロジー株式会社', en: 'ABC Technology Inc.' }, industry: { ja: 'IT・テクノロジー', en: 'IT & Technology' }, title: { ja: 'コーポレートサイト全面リニューアル', en: 'Full Corporate Site Redesign' }, desc: { ja: '古いCMSから最新のAstroベースの静的サイトに刷新。表示速度が平均4.2秒から0.8秒に改善し、問い合わせ数が2.3倍に増加しました。', en: 'Migrated from an old CMS to a modern Astro-based static site. Load time improved from 4.2s to 0.8s, with inquiries increasing 2.3x.' }, metrics: { score: '98 → 42', conversion: '+130%', traffic: '+85%' } },
  { cat: 'seo', tags: { ja: ['SEO', 'Web制作'], en: ['SEO', 'Web Dev'] }, client: { ja: '東京コマース株式会社', en: 'Tokyo Commerce Inc.' }, industry: { ja: 'EC・小売', en: 'E-Commerce' }, title: { ja: 'ECサイトSEO対策で月間売上200%向上', en: '200% Monthly Revenue Growth with E-Commerce SEO' }, desc: { ja: 'キーワード戦略の見直し、内部SEO改善、コンテンツマーケティングにより、主要キーワード50語で1ページ目表示を達成。月間オーガニック流入が3倍に。', en: 'Achieved page 1 rankings for 50 main keywords through keyword strategy overhaul, on-page SEO, and content marketing. Monthly organic traffic tripled.' }, metrics: { score: '76 → 96', conversion: '+200%', traffic: '+210%' } },
  { cat: 'meo', tags: { ja: ['MEO'], en: ['MEO'] }, client: { ja: 'サクラ美容クリニック', en: 'Sakura Beauty Clinic' }, industry: { ja: '美容・医療', en: 'Beauty & Medical' }, title: { ja: 'Googleビジネスプロフィール最適化で来院数50%増', en: '50% Increase in Clinic Visits via GBP Optimization' }, desc: { ja: 'Googleビジネスプロフィールの完全最適化と口コミ管理戦略により、地域検索での表示回数が月間15,000回から45,000回に増加。', en: 'Complete GBP optimization and review management strategy increased monthly search views from 15,000 to 45,000 and clinic visits by 50%.' }, metrics: { score: 'N/A', conversion: '+50%', traffic: '+200%' } },
  { cat: 'web', tags: { ja: ['Web制作', 'SEO'], en: ['Web Dev', 'SEO'] }, client: { ja: '株式会社サンプルホールディングス', en: 'Sample Holdings Inc.' }, industry: { ja: '不動産', en: 'Real Estate' }, title: { ja: '不動産ポータルサイト構築・SEO集客', en: 'Real Estate Portal Development & SEO' }, desc: { ja: '物件検索機能を備えた不動産ポータルサイトを構築。SEO対策と合わせて、オーガニック検索からの問い合わせが前年比340%増。', en: 'Built a property search portal with advanced filtering. Combined with SEO, organic inquiries increased 340% YoY.' }, metrics: { score: '65 → 95', conversion: '+340%', traffic: '+180%' } },
  { cat: 'seo', tags: { ja: ['SEO', 'マーケティング'], en: ['SEO', 'Marketing'] }, client: { ja: 'NEXT STARTUP株式会社', en: 'NEXT STARTUP Inc.' }, industry: { ja: 'スタートアップ', en: 'Startup' }, title: { ja: 'BtoB SaaS企業のSEO基盤構築', en: 'SEO Foundation for B2B SaaS Startup' }, desc: { ja: '技術的SEO基盤の確立とコンテンツマーケティング戦略により、リード獲得コストを70%削減。月間MQL数が120件から400件に増加。', en: 'Established technical SEO foundation and content marketing strategy, reducing lead acquisition cost by 70% and growing monthly MQL from 120 to 400.' }, metrics: { score: '80 → 97', conversion: '+230%', traffic: '+300%' } },
  { cat: 'web', tags: { ja: ['Web制作', 'システム開発'], en: ['Web Dev', 'System'] }, client: { ja: '未来教育ラボ株式会社', en: 'Mirai Education Lab Inc.' }, industry: { ja: '教育', en: 'Education' }, title: { ja: 'オンライン学習プラットフォーム構築', en: 'Online Learning Platform Development' }, desc: { ja: '動画配信、テスト機能、進捗管理を備えたLMSプラットフォームを開発。受講完了率が従来比で65%向上。', en: 'Developed an LMS platform with video delivery, testing, and progress tracking. Course completion rate improved by 65%.' }, metrics: { score: 'N/A', conversion: '+65%', traffic: '+120%' } },
];
---

<BaseLayout title={title} description={desc} locale={loc}>
  <Navbar locale={loc} current={`/cases/${company}`} />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <Breadcrumb items={crumbs} locale={loc} />

    <!-- Hero -->
    <section class="text-center my-12 lg:my-16">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight mb-4">
        {t('実績・事例', 'Case Studies')}
      </h1>
      <p class="text-lg text-gray-600 max-w-2xl mx-auto">
        {t('お客様のビジネス成長を支援した実績の一部をご紹介します。', 'Here are some examples of how we have helped our clients grow their businesses.')}
      </p>
    </section>

    <!-- Filter Tabs -->
    <div class="flex flex-wrap justify-center gap-2 mb-10" id="case-tabs">
      {[
        { id: 'all', label: { ja: 'すべて', en: 'All' } },
        { id: 'web', label: { ja: 'Web制作', en: 'Web Dev' } },
        { id: 'seo', label: { ja: 'SEO', en: 'SEO' } },
        { id: 'meo', label: { ja: 'MEO', en: 'MEO' } },
      ].map((tab) => (
        <button
          type="button"
          data-category={tab.id}
          class={`case-tab px-5 py-2 rounded-full text-sm font-medium transition-colors duration-150 ${
            tab.id === 'all'
              ? 'bg-brand-600 text-white'
              : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
          }`}
        >
          {loc === 'ja' ? tab.label.ja : tab.label.en}
        </button>
      ))}
    </div>

    <!-- Case Cards Grid -->
    <section class="mb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="case-grid">
        {cases.map((c) => (
          <div class="case-card group bg-white border border-gray-200 rounded-xl overflow-hidden hover:border-brand-300 hover:shadow-xl hover:-translate-y-1 transition-all duration-300" data-category={c.cat}>
            <div class="h-40 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center relative overflow-hidden">
              <div class="absolute inset-0 flex items-center justify-center gap-4 px-6">
                <div class="bg-white/80 backdrop-blur-sm rounded-lg p-3 text-center shadow-sm">
                  <span class="block text-xs text-gray-400 mb-1">{t('Before', 'Before')}</span>
                  <span class="block text-sm font-bold text-gray-400">{t('旧', 'Old')}</span>
                </div>
                <svg class="w-6 h-6 text-brand-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
                <div class="bg-brand-100/80 backdrop-blur-sm rounded-lg p-3 text-center shadow-sm">
                  <span class="block text-xs text-brand-600 mb-1">{t('After', 'After')}</span>
                  <span class="block text-sm font-bold text-brand-700">{t('新', 'New')}</span>
                </div>
              </div>
              <div class="absolute inset-0 opacity-5">
                <div class="grid grid-cols-4 grid-rows-3 h-full">
                  {Array.from({ length: 12 }).map(() => <div class="border border-gray-400"></div>)}
                </div>
              </div>
            </div>
            <div class="p-5">
              <div class="flex flex-wrap gap-1.5 mb-2">
                {(loc === 'ja' ? c.tags.ja : c.tags.en).map((tag) => (
                  <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-brand-50 text-brand-600">{tag}</span>
                ))}
                <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-gray-100 text-gray-500">{loc === 'ja' ? c.industry.ja : c.industry.en}</span>
              </div>
              <h3 class="text-base font-bold text-gray-900 mb-2 group-hover:text-brand-700 transition-colors">
                {loc === 'ja' ? c.title.ja : c.title.en}
              </h3>
              <p class="text-sm text-gray-500 mb-3">{loc === 'ja' ? c.client.ja : c.client.en}</p>
              <p class="text-xs text-gray-600 leading-relaxed mb-4 line-clamp-3">
                {loc === 'ja' ? c.desc.ja : c.desc.en}
              </p>
              <div class="grid grid-cols-3 gap-2 pt-3 border-t border-gray-100">
                <div class="text-center">
                  <p class="text-xs text-gray-400">{t('PageSpeed', 'PageSpeed')}</p>
                  <p class="text-sm font-bold text-brand-700">{c.metrics.score}</p>
                </div>
                <div class="text-center">
                  <p class="text-xs text-gray-400">{t('成果', 'Result')}</p>
                  <p class="text-sm font-bold text-green-600">{c.metrics.conversion}</p>
                </div>
                <div class="text-center">
                  <p class="text-xs text-gray-400">{t('流入増', 'Traffic')}</p>
                  <p class="text-sm font-bold text-accent-600">{c.metrics.traffic}</p>
                </div>
              </div>
            </div>
          </div>
        ))}
        <div id="no-case-results" class="hidden col-span-full text-center py-12 text-gray-400">
          <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
          </svg>
          <p class="text-sm">{t('該当する事例が見つかりませんでした。', 'No matching case studies found.')}</p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="mb-12 bg-gradient-to-r from-brand-700 to-brand-900 rounded-2xl p-8 sm:p-12 text-center text-white">
      <h2 class="text-2xl sm:text-3xl font-bold mb-3">
        {t('あなたのビジネスも成功事例に', 'Your Business Could Be Our Next Success Story')}
      </h2>
      <p class="text-brand-100 mb-6 max-w-xl mx-auto">
        {t('まずは無料相談で、貴社の課題をお聞かせください。', 'Tell us about your challenges in a free consultation.')}
      </p>
      <a href={`/contact/${company}`} class="inline-block px-8 py-3 bg-white text-brand-700 font-semibold text-sm rounded-lg hover:bg-brand-50 transition-colors shadow-lg">
        {t('無料相談を申し込む', 'Request Free Consultation')}
      </a>
    </section>
  </main>

  <Footer locale={loc} />

  <script>
    const caseTabs = document.querySelectorAll('.case-tab');
    const caseCards = document.querySelectorAll('.case-card');
    const noResults = document.getElementById('no-case-results');
    let activeCaseCat = 'all';

    function filterCases() {
      let visible = 0;
      caseCards.forEach((card) => {
        const cat = card.dataset.category;
        const match = activeCaseCat === 'all' || cat === activeCaseCat;
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (noResults) noResults.classList.toggle('hidden', visible > 0);
    }

    caseTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activeCaseCat = tab.dataset.category || 'all';
        caseTabs.forEach((t) => {
          t.className = t.dataset.category === activeCaseCat
            ? 'case-tab px-5 py-2 rounded-full text-sm font-medium transition-colors duration-150 bg-brand-600 text-white'
            : 'case-tab px-5 py-2 rounded-full text-sm font-medium transition-colors duration-150 bg-gray-100 text-gray-600 hover:bg-gray-200';
        });
        filterCases();
      });
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: title,
    description: desc,
    url: `https://paradigm.co.jp/cases/${company}`,
    about: {
      '@type': 'Organization',
      name: data.nameJa,
    },
  })} />
</BaseLayout>

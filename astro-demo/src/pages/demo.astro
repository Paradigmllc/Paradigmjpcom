---
// Phase 3-1 / 3-4: the single-page LP gallery is retired. /demo is now an index of the
// industry sample FULL SITES (home/services/pricing/cases/faq/about/contact/legal),
// each rendered by the canonical full-site renderer at /demo/sample-{industry}.
const lang = (Astro.url.searchParams.get("lang") || "ja") as "ja" | "en"
const isJa = lang === "ja"

const industries: { id: string; labelJa: string; labelEn: string; descJa: string; descEn: string }[] = [
  { id: "restaurant", labelJa: "飲食店", labelEn: "Restaurant", descJa: "予約導線とメニュー設計", descEn: "Reservation flow & menu design" },
  { id: "construction", labelJa: "建設業", labelEn: "Construction", descJa: "施工実績と見積導線", descEn: "Project proof & quote funnel" },
  { id: "dental", labelJa: "歯科医院", labelEn: "Dental Clinic", descJa: "初診予約と安心設計", descEn: "First-visit booking & trust" },
  { id: "beauty_salon", labelJa: "美容サロン", labelEn: "Beauty Salon", descJa: "世界観と指名予約", descEn: "Brand world & staff booking" },
  { id: "retail", labelJa: "小売店", labelEn: "Retail", descJa: "商品導線と購入説得", descEn: "Catalog & purchase proof" },
  { id: "accounting", labelJa: "会計事務所", labelEn: "Accounting", descJa: "専門性と相談導線", descEn: "Expertise & consultation" },
  { id: "cleaning", labelJa: "清掃業", labelEn: "Cleaning", descJa: "対応エリアと緊急相談", descEn: "Coverage & urgent inquiry" },
  { id: "consulting", labelJa: "コンサル", labelEn: "Consulting", descJa: "実績と信頼構築", descEn: "Credibility & trust" },
]
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{isJa ? "Paradigm 業種別デモサイト一覧" : "Paradigm Industry Demo Sites"}</title>
    <meta name="description" content={isJa ? "業種ごとに作り分けた、ナビゲートできる本番品質のデモサイト一覧" : "Navigable, production-quality demo websites built per industry"} />
    <style is:inline set:html={`
      :root { --brand:#7c3aed; --brand-dark:#5b21b6; }
      *{box-sizing:border-box}
      body{margin:0;font-family:Inter,"Noto Sans JP",system-ui,sans-serif;background:#f8fafc;color:#111827}
      .nav{position:sticky;top:0;z-index:40;display:flex;align-items:center;justify-content:space-between;height:64px;padding:0 24px;background:rgba(255,255,255,.9);border-bottom:1px solid rgba(17,24,39,.08);backdrop-filter:blur(18px)}
      .brand{display:flex;align-items:center;gap:10px;font-weight:900;text-decoration:none;color:#111827}
      .brand-mark{width:32px;height:32px;border-radius:6px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,var(--brand),var(--brand-dark))}
      .actions a{min-height:36px;display:inline-flex;align-items:center;padding:0 12px;border-radius:6px;color:#111827;text-decoration:none;font-size:13px;font-weight:800;border:1px solid rgba(17,24,39,.1);background:#fff;margin-left:8px}
      .wrap{width:min(1180px,calc(100% - 32px));margin:0 auto;padding:64px 0 96px}
      .head h1{margin:0 0 12px;font-size:38px;line-height:1.12}
      .head p{margin:0 0 32px;max-width:620px;color:#5b6472;line-height:1.7}
      .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
      .tile{display:flex;flex-direction:column;justify-content:space-between;min-height:168px;border-radius:10px;padding:20px;color:#111827;text-decoration:none;background:#fff;border:1px solid rgba(17,24,39,.1);box-shadow:0 18px 48px rgba(15,23,42,.06);transition:transform .2s ease,border-color .2s ease}
      .tile:hover{transform:translateY(-3px);border-color:var(--brand)}
      .tile .num{font-size:12px;font-weight:900;opacity:.5}
      .tile strong{display:block;font-size:20px;margin:8px 0 4px}
      .tile span{font-size:13px;color:#5b6472}
      .tile .go{margin-top:14px;font-size:13px;font-weight:800;color:var(--brand)}
      .foot{padding:28px 24px;text-align:center;color:#6b7280;font-size:12px;border-top:1px solid rgba(17,24,39,.08);background:#fff}
      @media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}.head h1{font-size:30px}}
      @media(max-width:560px){.grid{grid-template-columns:1fr}.nav{padding:0 14px}}
    `}></style>
  </head>
  <body>
    <nav class="nav">
      <a href="/demo" class="brand" aria-label="Paradigm demo index">
        <span class="brand-mark">P</span><span>Paradigm Demo</span>
      </a>
      <div class="actions">
        <a href="/demo?lang=ja">JA</a>
        <a href="/demo?lang=en">EN</a>
        <a href="https://paradigmjp.com" target="_blank" rel="noopener noreferrer">{isJa ? "Paradigmへ" : "Paradigm"}</a>
      </div>
    </nav>

    <main class="wrap">
      <div class="head">
        <h1>{isJa ? "業種ごとに作り分けた、本番品質のデモサイト。" : "Production-quality demo websites, built per industry."}</h1>
        <p>{isJa ? "LPの見本ではなく、ホーム・サービス・料金・事例・FAQ・会社情報・お問い合わせ・法務まで揃ったナビゲートできるサイトです。業種を選んで実際に回遊してください。" : "Not a single-page LP — each is a navigable site with home, services, pricing, cases, FAQ, about, contact, and legal pages. Pick an industry and explore."}</p>
      </div>
      <div class="grid">
        {industries.map((item, i) => (
          <a class="tile" href={`/demo/sample-${item.id}`} aria-label={isJa ? item.labelJa : item.labelEn}>
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <strong>{isJa ? item.labelJa : item.labelEn}</strong>
              <span>{isJa ? item.descJa : item.descEn}</span>
            </div>
            <span class="go">{isJa ? "サイトを見る →" : "View site →"}</span>
          </a>
        ))}
      </div>
    </main>

    <footer class="foot">
      {isJa ? "診断データから生成する、業種別フルサイトのデモ。" : "Industry full-site demos generated from diagnostic data."}
    </footer>
  </body>
</html>

---
import PremiumDemoPage from "../components/premium/PremiumDemoPage.astro"
import { getPremiumDemoProfile } from "../lib/premium-demo"
import { generateDemo } from "../keystatic/demo-data"
import "../styles/global.css"

const lang = (Astro.url.searchParams.get("lang") || "ja") as "ja" | "en"
const industry = Astro.url.searchParams.get("industry") || "consulting"
const appeal = (Astro.url.searchParams.get("appeal") || "brand") as "diagnostic" | "sales" | "brand" | "tech"
const data = generateDemo(industry, appeal, lang)
const isJa = lang === "ja"
const profile = getPremiumDemoProfile({
  slug: `${lang}-${industry}-${appeal}`,
  title: data.title,
  locale: lang,
  meta: {
    industry,
    locale: lang,
    company_name: data.customerName,
    accentColor: data.accentColor,
    accentColorDark: data.accentColorDark,
    accentColorLight: data.accentColorLight,
    calBookingUrl: data.calBookingUrl,
  },
})

const industries = [
  { id: "restaurant", labelJa: "飲食", labelEn: "Restaurant" },
  { id: "construction", labelJa: "建設", labelEn: "Construction" },
  { id: "dental", labelJa: "歯科", labelEn: "Dental" },
  { id: "beauty_salon", labelJa: "美容", labelEn: "Beauty" },
  { id: "retail", labelJa: "小売", labelEn: "Retail" },
  { id: "accounting", labelJa: "士業", labelEn: "Advisory" },
  { id: "cleaning", labelJa: "清掃", labelEn: "Cleaning" },
  { id: "consulting", labelJa: "コンサル", labelEn: "Consulting" },
]
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{isJa ? "Paradigm 業種別デモギャラリー" : "Paradigm Industry Demo Gallery"}</title>
    <meta name="description" content={isJa ? "業種ごとに作り分けたプロ品質のデモサイト" : "Professionally crafted demo sites by industry"} />
    <style set:html={`
      :root {
        --brand: ${data.accentColor};
        --brand-dark: ${data.accentColorDark};
        --brand-light: ${data.accentColorLight};
      }
      body { margin: 0; font-family: Inter, "Noto Sans JP", system-ui, sans-serif; background: #f8fafc; color: #111827; }
      .demo-shell-nav {
        position: sticky;
        top: 0;
        z-index: 40;
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 64px;
        padding: 0 24px;
        background: rgba(255,255,255,.88);
        border-bottom: 1px solid rgba(17,24,39,.08);
        backdrop-filter: blur(18px);
      }
      .demo-brand { display: flex; align-items: center; gap: 10px; font-weight: 900; text-decoration: none; color: #111827; }
      .demo-brand-mark { width: 32px; height: 32px; border-radius: 6px; display: grid; place-items: center; color: white; background: linear-gradient(135deg,var(--brand),var(--brand-dark)); }
      .demo-actions { display: flex; align-items: center; gap: 8px; }
      .demo-actions a { min-height: 36px; display: inline-flex; align-items: center; padding: 0 12px; border-radius: 6px; color: #111827; text-decoration: none; font-size: 13px; font-weight: 800; border: 1px solid rgba(17,24,39,.1); background: white; }
      .demo-gallery { width: min(1180px, calc(100% - 32px)); margin: 0 auto; padding: 76px 0 96px; }
      .demo-gallery-head { display: flex; justify-content: space-between; gap: 24px; align-items: end; margin-bottom: 24px; }
      .demo-gallery-head h2 { margin: 0; font-size: 38px; line-height: 1.1; letter-spacing: 0; }
      .demo-gallery-head p { margin: 0; max-width: 560px; color: #5b6472; line-height: 1.7; }
      .demo-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
      .demo-tile { min-height: 150px; border-radius: 8px; padding: 18px; color: #111827; text-decoration: none; background: white; border: 1px solid rgba(17,24,39,.1); box-shadow: 0 18px 48px rgba(15,23,42,.06); transition: transform .2s ease, border-color .2s ease; }
      .demo-tile:hover { transform: translateY(-3px); border-color: var(--brand); }
      .demo-tile.active { background: linear-gradient(135deg,var(--brand),var(--brand-dark)); color: white; }
      .demo-tile span { display: block; font-size: 12px; font-weight: 900; opacity: .62; margin-bottom: 42px; }
      .demo-tile strong { display: block; font-size: 20px; }
      .demo-shell-footer { padding: 28px 24px; text-align: center; color: #6b7280; font-size: 12px; border-top: 1px solid rgba(17,24,39,.08); background: white; }
      @media (max-width: 900px) {
        .demo-gallery-head { display: grid; }
        .demo-gallery-head h2 { font-size: 30px; }
        .demo-grid { grid-template-columns: repeat(2, 1fr); }
      }
      @media (max-width: 560px) {
        .demo-shell-nav { padding: 0 14px; }
        .demo-actions a:nth-child(2) { display: none; }
        .demo-grid { grid-template-columns: 1fr; }
      }
    `}></style>
  </head>
  <body>
    <nav class="demo-shell-nav">
      <a href="/demo" class="demo-brand" aria-label="Paradigm demo gallery">
        <span class="demo-brand-mark">P</span>
        <span>Paradigm Demo</span>
      </a>
      <div class="demo-actions">
        <a href={`/demo?lang=ja&industry=${industry}&appeal=${appeal}`}>JA</a>
        <a href={`/demo?lang=en&industry=${industry}&appeal=${appeal}`}>EN</a>
        <a href="https://paradigmjp.com" target="_blank" rel="noopener noreferrer">{isJa ? "Paradigmへ" : "Paradigm"}</a>
      </div>
    </nav>

    <PremiumDemoPage profile={profile} />

    <section class="demo-gallery" aria-label={isJa ? "業種別デモ一覧" : "Industry demo gallery"}>
      <div class="demo-gallery-head">
        <h2>{isJa ? "業種ごとに、別の勝ち方で作る。" : "Different industries, different winning structures."}</h2>
        <p>{isJa ? "色と文章だけを変えた量産デモではなく、職員が1件ずつ設計したように、写真・証拠・導線の順番まで作り分けます。" : "These are not color-swapped templates. Each industry changes imagery, proof, and the order of conversion cues."}</p>
      </div>
      <div class="demo-grid">
        {industries.map((item, index) => (
          <a
            class={`demo-tile ${item.id === industry ? "active" : ""}`}
            href={`/demo?lang=${lang}&industry=${item.id}&appeal=${appeal}`}
          >
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{isJa ? item.labelJa : item.labelEn}</strong>
          </a>
        ))}
      </div>
    </section>

    <footer class="demo-shell-footer">
      {isJa ? "診断データから生成する、業種別プロ品質デモサイト。" : "Production-quality industry demos generated from diagnostic data."}
    </footer>
  </body>
</html>

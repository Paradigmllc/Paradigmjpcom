---
import DemoLayout from "../layouts/DemoLayout.astro"
import { getDemoData } from "../keystatic/demo-data"

const slug = Astro.url.searchParams.get("slug") || "default-demo"
const data = await getDemoData(slug)
---

<DemoLayout title={`${data.customerName} — お問い合わせ`} accentColor={data.accentColor} accentColorDark={data.accentColorDark} accentColorLight={data.accentColorLight} lang="ja">
  <section class="section-padding">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-12"><div class="badge mb-4"><span class="badge-dot badge-dot-pulse"></span>Contact</div><h1 class="text-4xl md:text-5xl font-black gradient-text mb-4">お問い合わせ</h1><p class="text-white/40">まずは無料診断から。15分のオンライン面談で改善余地を可視化します。</p></div>
      <div class="glass p-10 space-y-6">
        <div class="grid sm:grid-cols-2 gap-4">
          <div><label class="block text-xs font-bold text-white/40 uppercase tracking-wider mb-2">お名前</label><input type="text" class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-white/20 focus:outline-none focus:border-brand/50 transition-colors" placeholder="山田 太郎"/></div>
          <div><label class="block text-xs font-bold text-white/40 uppercase tracking-wider mb-2">メールアドレス</label><input type="email" class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-white/20 focus:outline-none focus:border-brand/50 transition-colors" placeholder="yamada@example.com"/></div>
        </div>
        <div><label class="block text-xs font-bold text-white/40 uppercase tracking-wider mb-2">会社名</label><input type="text" class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-white/20 focus:outline-none focus:border-brand/50 transition-colors" placeholder="株式会社〇〇"/></div>
        <div><label class="block text-xs font-bold text-white/40 uppercase tracking-wider mb-2">お問い合わせ内容</label><textarea rows={4} class="w-full rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder-white/20 focus:outline-none focus:border-brand/50 transition-colors resize-none" placeholder="Webサイトの改善について相談したいです。"></textarea></div>
        <a href={data.calBookingUrl} target="_blank" rel="noopener noreferrer" class="btn-primary w-full justify-center text-base !py-4">無料診断を申し込む <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></a>
        <p class="text-xs text-white/20 text-center">または <a href={`tel:03-0000-0000`} class="text-brand-light hover:underline">03-0000-0000</a> までお電話ください</p>
      </div>
    </div>
  </section>
</DemoLayout>

---
import DemoLayout from "../layouts/DemoLayout.astro"
import { allIndustries, allAppeals, allLocales, getIndustryLabel, getAppealLabel, getAppealIcon } from "../keystatic/demo-data"

const selectedLang = (Astro.url.searchParams.get("lang") || "ja") as "ja" | "en"
---

<DemoLayout title="テンプレートギャラリー — Paradigm Demo" lang={selectedLang}>
  <section class="section-padding">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <div class="badge mb-4"><span class="badge-dot badge-dot-pulse"></span>{selectedLang==="ja"?"全48パターン":"48 Patterns"}</div>
        <h1 class="text-4xl md:text-6xl font-black gradient-text mb-4">{selectedLang==="ja"?"改善デモサイトテンプレート":"Demo Site Templates"}</h1>
        <p class="text-white/40 max-w-2xl mx-auto mb-8">{selectedLang==="ja"?"業界 × 訴求タイプ × 言語の全組み合わせから選択してください":"Choose from all industry × appeal × language combinations"}</p>
        <div class="flex items-center justify-center gap-3">
          {(["ja","en"] as const).map(l => (
            <a href={`?lang=${l}`} class={`px-4 py-2 rounded-lg text-sm font-bold transition-colors ${selectedLang===l?'bg-brand text-white':'glass text-white/40 hover:text-white'}`}>{l==="ja"?"🇯🇵 日本語":"🇺🇸 English"}</a>
          ))}
        </div>
      </div>

      <div class="space-y-16">
        {allIndustries().map(industry => {
          const label = getIndustryLabel(industry, selectedLang)
          const theme = { dental:"#06b6d4", restaurant:"#f59e0b", construction:"#f97316", consulting:"#7c3aed", retail:"#10b981", beauty_salon:"#ec4899", accounting:"#6366f1", cleaning:"#3b82f6" }[industry] || "#7c3aed"
          return (
            <div>
              <div class="flex items-center gap-3 mb-6">
                <div class="h-3 w-3 rounded-full" style={`background:${theme}`}></div>
                <h2 class="text-xl font-bold text-white">{label}</h2>
                <span class="text-xs text-white/20">{selectedLang==="ja"?"4パターン":"4 patterns"}</span>
              </div>
              <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
                {allAppeals().map(appeal => {
                  const appealLabel = getAppealLabel(appeal, selectedLang)
                  const icon = getAppealIcon(appeal)
                  const href = `/${selectedLang}/${industry}/${appeal}`
                  return (
                    <a href={href} class="glass-card glass-hover p-6 group block relative overflow-hidden">
                      <div class="absolute top-0 left-0 right-0 h-1" style={`background:${theme}`}></div>
                      <div class="text-2xl mb-3">{icon}</div>
                      <div class="text-xs font-bold text-white/40 uppercase tracking-wider mb-1">{appealLabel}</div>
                      <div class="text-sm font-bold text-white mb-3">{label} {selectedLang==="ja"?"向け":"for"} {appealLabel}</div>
                      <div class="flex items-center gap-2 text-xs text-white/20 group-hover:text-brand-light transition-colors">
                        {selectedLang==="ja"?"プレビューを見る":"View Preview"}
                        <svg class="h-3 w-3 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                      </div>
                    </a>
                  )
                })}
              </div>
            </div>
          )
        })}
      </div>
    </div>
  </section>
</DemoLayout>

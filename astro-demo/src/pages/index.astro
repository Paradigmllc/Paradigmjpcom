---
import DemoLayout from "../layouts/DemoLayout.astro"
import HeroSection from "../components/HeroSection.astro"
import BeforeAfter from "../components/BeforeAfter.astro"
import ServicePath from "../components/ServicePath.astro"
import CasePreview from "../components/CasePreview.astro"
import ProcessSection from "../components/ProcessSection.astro"
import TrustSection from "../components/TrustSection.astro"
import FaqSection from "../components/FaqSection.astro"
import BookingCta from "../components/BookingCta.astro"
import { getDemoData, JA_INDUSTRY } from "../keystatic/demo-data"

const slug = Astro.url.searchParams.get("slug") || "default-demo"
const data = await getDemoData(slug)
const industryLabel = JA_INDUSTRY[data.industry] || data.industry
---

<DemoLayout title={`${data.customerName} — Demo Site`} accentColor={data.accentColor} accentColorDark={data.accentColorDark} accentColorLight={data.accentColorLight}>

  <!-- Sticky nav -->
  <nav class="sticky top-0 z-50 bg-black/70 backdrop-blur-2xl border-b border-white/5">
    <div class="max-w-7xl mx-auto flex items-center justify-between px-6 h-16">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-brand to-brand-dark text-white text-xs font-black shadow-lg shadow-brand/20">
          {data.customerName.charAt(0)}
        </div>
        <div class="flex flex-col">
          <span class="text-sm font-semibold text-white truncate max-w-[200px]">{data.customerName}</span>
          <span class="text-[10px] text-white/30">{industryLabel} 特化型デモ</span>
        </div>
      </div>
      <div class="hidden lg:flex items-center gap-6 text-sm text-white/50">
        <a href="#hero" class="hover:text-brand-light transition-colors">概要</a>
        <a href="#service-path" class="hover:text-brand-light transition-colors">サービス</a>
        <a href="#case-study" class="hover:text-brand-light transition-colors">実績</a>
        <a href="#process" class="hover:text-brand-light transition-colors">流れ</a>
        <a href="#faq" class="hover:text-brand-light transition-colors">FAQ</a>
      </div>
      <a href={data.calBookingUrl} target="_blank" rel="noopener noreferrer"
         class="rounded-full bg-white px-5 py-2.5 text-sm font-bold text-black transition-all hover:scale-105 hover:shadow-lg hover:shadow-white/20">
        無料相談
      </a>
    </div>
  </nav>

  <main>
    <HeroSection data={data} />
    <BeforeAfter data={data} />
    <ServicePath data={data} />
    <CasePreview data={data} />
    <ProcessSection data={data} />
    <TrustSection data={data} />
    <FaqSection data={data} />
    <BookingCta data={data} />
  </main>

  <!-- Footer -->
  <footer class="border-t border-white/5 py-10 px-6">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-white/20">
      <div class="flex items-center gap-3">
        <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-white/10 text-white/50 text-xs font-bold">P</div>
        <span>Paradigm LLC</span>
      </div>
      <p>診断データから自動生成されたパーソナライズドデモサイト · © {new Date().getFullYear()}</p>
      <div class="flex gap-4">
        <a href="#" class="hover:text-white/40 transition-colors">プライバシー</a>
        <a href="#" class="hover:text-white/40 transition-colors">利用規約</a>
      </div>
    </div>
  </footer>
</DemoLayout>

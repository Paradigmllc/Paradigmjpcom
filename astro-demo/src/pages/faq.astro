---
import DemoLayout from "../layouts/DemoLayout.astro"
import { getDemoData } from "../keystatic/demo-data"

const slug = Astro.url.searchParams.get("slug") || "default-demo"
const data = await getDemoData(slug)
---

<DemoLayout title={`${data.customerName} — FAQ`} accentColor={data.accentColor} accentColorDark={data.accentColorDark} accentColorLight={data.accentColorLight} lang="ja">
  <section class="section-padding">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-16"><div class="badge mb-4"><span class="badge-dot"></span>FAQ</div><h1 class="text-4xl md:text-5xl font-black gradient-text mb-4">{data.faqTitle || "よくあるご質問"}</h1></div>
      <div class="space-y-3">
        {data.faqItems?.map((faq, i) => (
          <details class="glass cursor-pointer group" open={i === 0}>
            <summary class="flex items-center justify-between p-5 font-semibold text-white/70 group-open:text-white list-none">
              <span class="flex items-center gap-3"><span class="text-brand-light text-sm font-bold">Q{i+1}</span>{faq.question}</span>
              <svg class="h-4 w-4 text-white/20 group-open:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <div class="px-5 pb-5 pt-1 text-sm text-white/40 leading-relaxed">{faq.answer}</div>
          </details>
        ))}
      </div>
      <div class="text-center mt-12 p-8 glass">
        <p class="text-white/40 mb-4">上記で解決しない場合は、お気軽にお問い合わせください。</p>
        <a href="/contact" class="btn-primary">お問い合わせ <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></a>
      </div>
    </div>
  </section>
</DemoLayout>

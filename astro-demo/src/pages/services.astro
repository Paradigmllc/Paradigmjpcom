---
import DemoLayout from "../layouts/DemoLayout.astro"
import { getDemoData, JA_INDUSTRY } from "../keystatic/demo-data"

const slug = Astro.url.searchParams.get("slug") || "default-demo"
const data = await getDemoData(slug)
---

<DemoLayout title={`${data.customerName} — サービス`} accentColor={data.accentColor} accentColorDark={data.accentColorDark} accentColorLight={data.accentColorLight} lang="ja">
  <section class="section-padding">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16"><div class="badge mb-4"><span class="badge-dot"></span>Services</div><h1 class="text-4xl md:text-6xl font-black gradient-text mb-4">{data.serviceTitle}</h1><p class="text-white/40 max-w-2xl mx-auto">{data.serviceSubtitle || "データ診断に基づき、最適なソリューションをご提案します"}</p></div>
      <div class="space-y-8">
        {data.services.map((svc, i) => (
          <div class="glass-card glass-hover p-8 md:p-12 flex flex-col md:flex-row gap-8 items-start">
            <div class="flex-shrink-0 flex h-16 w-16 items-center justify-center rounded-2xl bg-gradient-to-br from-brand to-brand-dark text-white text-2xl shadow-lg shadow-brand/20">{svc.icon==="Globe"?"🌐":svc.icon==="Search"?"🔍":svc.icon==="Zap"?"⚡":svc.icon==="Shield"?"🛡️":"📊"}</div>
            <div>
              <h2 class="text-2xl font-bold text-white mb-3">{svc.title}</h2>
              <p class="text-white/50 leading-relaxed mb-4">{svc.description}</p>
              {svc.features && <div class="grid sm:grid-cols-2 gap-3">{svc.features.map(f => (<div class="flex items-center gap-2 text-sm text-white/40"><svg class="h-4 w-4 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>{f}</div>))}</div>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</DemoLayout>

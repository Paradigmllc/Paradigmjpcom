---
export interface Props {
  locale?: 'ja' | 'en';
  current?: string;
}

const { locale = 'ja', current } = Astro.props;
const navItems = [
  { label: { ja: 'ホーム', en: 'Home' }, href: '/' },
  { label: { ja: 'サービス', en: 'Services' }, href: '/services/paradigm' },
  { label: { ja: '料金', en: 'Pricing' }, href: '/pricing/paradigm' },
  { label: { ja: '事例', en: 'Cases' }, href: '/cases/paradigm' },
  { label: { ja: '会社概要', en: 'About' }, href: '/about/paradigm' },
  { label: { ja: 'お問い合わせ', en: 'Contact' }, href: '/contact/paradigm' },
  { label: { ja: 'ブログ', en: 'Blog' }, href: '/blog' },
];
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-100 no-print">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 font-bold text-lg text-brand-700 shrink-0">
        <svg class="w-8 h-8" viewBox="0 0 32 32" fill="none">
          <rect width="32" height="32" rx="8" fill="#1e40af"/>
          <text x="16" y="22" text-anchor="middle" fill="white" font-size="18" font-weight="900">P</text>
        </svg>
        <span class="hidden sm:inline">{locale === 'ja' ? 'パラダイム' : 'Paradigm'}</span>
      </a>
      <div class="hidden lg:flex items-center gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-150 ${
              current === item.href
                ? 'bg-brand-50 text-brand-700'
                : 'text-gray-600 hover:text-brand-600 hover:bg-gray-50'
            }`}
          >
            {locale === 'ja' ? item.label.ja : item.label.en}
          </a>
        ))}
      </div>
      <div class="flex items-center gap-3">
        <a href="/{locale === 'ja' ? 'en' : 'ja'}/" class="text-xs font-medium text-gray-500 hover:text-brand-600 px-2 py-1 rounded">
          {locale === 'ja' ? 'EN' : 'JA'}
        </a>
        <button class="lg:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100" aria-label="Menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>
<div class="h-16"></div>

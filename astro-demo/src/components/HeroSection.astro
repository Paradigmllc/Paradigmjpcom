---
import type { DemoData } from "../keystatic/demo-data"

interface Props { data: DemoData }

const { data } = Astro.props
const stats = data.heroStats ?? []
const industryLabels: Record<string, string> = {
  beauty_salon: "美容サロン", dental: "歯科医院", restaurant: "飲食店",
  construction: "建設業", accounting: "会計事務所", retail: "小売業",
  cleaning: "清掃業", consulting: "コンサルティング",
}
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Animated gradient mesh background -->
  <div class="absolute inset-0 bg-[#050510]">
    <div class="absolute top-0 -left-40 w-[600px] h-[600px] bg-brand/20 rounded-full blur-[120px] animate-float opacity-70"></div>
    <div class="absolute top-1/3 -right-40 w-[500px] h-[500px] bg-purple-600/15 rounded-full blur-[120px] animate-float-delayed opacity-60"></div>
    <div class="absolute bottom-0 left-1/3 w-[400px] h-[400px] bg-blue-500/10 rounded-full blur-[100px] animate-float-slow opacity-50"></div>
    <!-- Grid overlay -->
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iNjAiIGhlaWdodD0iNjAiIHZpZXdCb3g9IjAgMCA2MCA2MCIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48ZyBmaWxsPSJub25lIiBmaWxsLXJ1bGU9ImV2ZW5vZGQiPjxnIGZpbGw9IiNmZmYiIGZpbGwtb3BhY2l0eT0iMC4wMiI+PHBhdGggZD0iTTM2IDYwVjBIMjR2NjB6TTYwIDI0VjM2SDBWMjR6Ii8+PC9nPjwvZz48L3N2Zz4=')] opacity-30"></div>
  </div>

  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-8 py-32 md:py-40">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <!-- Left: Text content -->
      <div class="space-y-8">
        <!-- Industry badge -->
        <div class="inline-flex items-center gap-2.5 rounded-full border border-brand/40 bg-white/5 backdrop-blur-md px-5 py-2.5 text-sm font-medium text-brand-light">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-400"></span>
          </span>
          {industryLabels[data.industry] ?? data.industry} 特化型デモ
          {data.domain && <span class="text-white/30">· {data.domain}</span>}
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-[1.08] tracking-tight">
          <span class="gradient-text">{data.heroHeadline}</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-white/50 leading-relaxed max-w-xl">
          {data.heroSubtitle}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row gap-4 pt-4">
          <a href="#booking-cta"
             class="group inline-flex items-center justify-center gap-2.5 rounded-2xl bg-gradient-to-r from-brand to-brand-dark px-8 py-4 text-base font-bold text-white shadow-2xl shadow-brand/25 transition-all duration-300 hover:scale-[1.03] hover:shadow-brand/40 hover:shadow-2xl">
            無料診断を申し込む
            <svg class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="#service-path"
             class="inline-flex items-center justify-center gap-2 rounded-2xl border border-white/15 bg-white/5 backdrop-blur-md px-8 py-4 text-base font-semibold text-white/80 transition-all duration-300 hover:border-brand/40 hover:bg-white/10 hover:text-white">
            改善内容を見る
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </a>
        </div>

        <!-- Stats bar -->
        {stats.length > 0 && (
          <div class="flex flex-wrap gap-8 pt-8 border-t border-white/8">
            {stats.map((s) => (
              <div>
                <p class="text-3xl sm:text-4xl font-black text-white tabular-nums">
                  {s.value}<span class="text-xl text-brand-light">{s.suffix}</span>
                </p>
                <p class="mt-1 text-sm text-white/40">{s.label}</p>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Right: Visual element -->
      <div class="hidden lg:block relative">
        <div class="absolute -inset-4 bg-gradient-to-br from-brand/20 to-purple-600/20 rounded-3xl blur-2xl"></div>
        <div class="relative glass-card p-1 rounded-2xl shadow-2xl">
          <div class="aspect-[4/3] rounded-xl bg-gradient-to-br from-[#0a0a1a] to-[#0d0d2b] border border-white/5 overflow-hidden">
            <!-- Mock browser chrome -->
            <div class="flex items-center gap-2 px-4 py-3 border-b border-white/5">
              <span class="h-3 w-3 rounded-full bg-rose-500/80"></span>
              <span class="h-3 w-3 rounded-full bg-amber-500/80"></span>
              <span class="h-3 w-3 rounded-full bg-emerald-500/80"></span>
              <span class="ml-3 h-4 w-48 rounded bg-white/5"></span>
            </div>
            <!-- Mock content -->
            <div class="p-6 space-y-4">
              <div class="h-3 w-3/4 rounded bg-white/10"></div>
              <div class="h-3 w-1/2 rounded bg-white/5"></div>
              <div class="h-3 w-5/6 rounded bg-white/5"></div>
              <div class="mt-6 grid grid-cols-3 gap-3">
                <div class="h-20 rounded-lg bg-white/5"></div>
                <div class="h-20 rounded-lg bg-brand/20"></div>
                <div class="h-20 rounded-lg bg-white/5"></div>
              </div>
              <div class="mt-4 h-32 rounded-lg bg-white/5"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gradient-text {
    background: linear-gradient(135deg, #ffffff 0%, #a78bfa 50%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(30px, -20px) scale(1.05); }
  }
  @keyframes float-delayed {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-25px, 25px) scale(1.08); }
  }
  @keyframes float-slow {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(15px, -10px) scale(1.03); }
  }
  .animate-float { animation: float 12s ease-in-out infinite; }
  .animate-float-delayed { animation: float-delayed 14s ease-in-out infinite; }
  .animate-float-slow { animation: float-slow 18s ease-in-out infinite; }
</style>

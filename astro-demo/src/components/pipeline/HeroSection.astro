---
export interface Props {
  headline: string
  subheadline?: string
  image?: string | null
  primaryCta: { label: string; href: string }
  secondaryCta?: { label: string; href: string } | null
  variant?: "fullbleed" | "split" | "centered" | "gradient"
  colors?: { primary?: string; bg?: string; text?: string }
}
const { headline, subheadline, image, primaryCta, secondaryCta, variant = "fullbleed", colors = {} } = Astro.props
const p = colors.primary || "#2563eb"
const bg = colors.bg || "#ffffff"
const tx = colors.text || "#111827"
---

<section class="hero" data-variant={variant}>
  <style is:inline set:html={`
    .hero{position:relative;display:flex;align-items:center;min-height:92vh;overflow:hidden}
    .hero[data-variant="fullbleed"]{min-height:100vh}
    .hero[data-variant="centered"]{justify-content:center;text-align:center;min-height:85vh}
    .hero[data-variant="split"]{display:grid;grid-template-columns:1fr 1fr;gap:0;min-height:85vh}
    .hero[data-variant="gradient"]{min-height:80vh}
    .hero__bg{position:absolute;inset:0;z-index:0}
    .hero__bg::after{content:'';position:absolute;inset:0}
    .hero[data-variant="fullbleed"] .hero__bg::after{background:linear-gradient(to bottom,rgba(0,0,0,.45) 0%,rgba(0,0,0,.2) 50%,rgba(0,0,0,.65) 100%)}
    .hero[data-variant="split"] .hero__bg::after{background:linear-gradient(to right,rgba(255,255,255,.05) 0%,rgba(0,0,0,.35) 100%)}
    .hero[data-variant="centered"] .hero__bg::after{background:rgba(0,0,0,.55)}
    .hero[data-variant="gradient"]::before{content:'';position:absolute;inset:0;z-index:0;background:linear-gradient(160deg,var(--hp,${p}) 0%,color-mix(in srgb,var(--hp,${p}) 40%,#0a0a0a) 60%,#0a0a0a 100%)}
    .hero__bg img{width:100%;height:100%;object-fit:cover;animation:heroZoom 12s ease-out}
    @keyframes heroZoom{from{transform:scale(1.08)}to{transform:scale(1)}}
    .hero__content{position:relative;z-index:1;max-width:800px;padding:clamp(2rem,8vw,6rem) clamp(1.5rem,5vw,3rem)}
    .hero[data-variant="centered"] .hero__content{text-align:center;margin:0 auto}
    .hero[data-variant="split"] .hero__content{padding:clamp(2rem,5vw,5rem)}
    .hero__eyebrow{display:inline-block;font-size:0.75rem;font-weight:700;letter-spacing:0.15em;text-transform:uppercase;margin-bottom:1.5rem;opacity:0.6;animation:fadeUp .8s ease both}
    .hero h1{font-size:clamp(2.8rem,7vw,5.6rem);font-weight:800;line-height:1.05;letter-spacing:-0.03em;margin-bottom:1.2rem;animation:fadeUp .8s .1s ease both}
    .hero[data-variant="gradient"] h1,.hero[data-variant="fullbleed"] h1{color:#fff}
    .hero[data-variant="gradient"] .hero__sub,.hero[data-variant="fullbleed"] .hero__sub{color:rgba(255,255,255,.7)}
    .hero__sub{font-size:clamp(1rem,1.6vw,1.25rem);line-height:1.7;margin-bottom:2.5rem;max-width:520px;animation:fadeUp .8s .2s ease both}
    .hero[data-variant="centered"] .hero__sub{margin-left:auto;margin-right:auto}
    .hero__ctas{display:flex;flex-wrap:wrap;gap:12px;animation:fadeUp .8s .3s ease both}
    .hero[data-variant="centered"] .hero__ctas{justify-content:center}
    .hero__cta-pri{display:inline-flex;align-items:center;padding:16px 32px;background:var(--hp,${p});color:#fff;font-weight:600;font-size:1rem;border-radius:14px;transition:transform .25s ease,box-shadow .25s ease;box-shadow:0 4px 24px rgba(0,0,0,.12)}
    .hero__cta-pri:hover{transform:translateY(-2px);box-shadow:0 8px 32px rgba(0,0,0,.18)}
    .hero__cta-sec{display:inline-flex;align-items:center;padding:16px 32px;font-weight:600;font-size:1rem;border-radius:14px;border:1.5px solid rgba(255,255,255,.25);color:#fff;backdrop-filter:blur(8px);transition:border-color .25s ease,background .25s ease}
    .hero__cta-sec:hover{border-color:rgba(255,255,255,.5);background:rgba(255,255,255,.08)}
    @keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
    @media(max-width:768px){
      .hero[data-variant="split"]{grid-template-columns:1fr}
      .hero[data-variant="split"] .hero__bg{min-height:280px;order:-1}
      .hero h1{font-size:clamp(2rem,8vw,3.2rem)}
    }
  `}></style>
  {image && <div class="hero__bg"><img src={image} alt="" loading="eager" decoding="async" /></div>}
  <div class="hero__content">
    <span class="hero__eyebrow">{primaryCta.label}</span>
    <h1>{headline}</h1>
    {subheadline && <p class="hero__sub">{subheadline}</p>}
    <div class="hero__ctas">
      <a href={primaryCta.href} class="hero__cta-pri">{primaryCta.label}</a>
      {secondaryCta && <a href={secondaryCta.href} class="hero__cta-sec">{secondaryCta.label}</a>}
    </div>
  </div>
</section>

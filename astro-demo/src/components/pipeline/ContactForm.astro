---
export interface Props {
  title: string
  body?: string
  fields?: ("name" | "email" | "phone" | "company" | "message")[]
  successMessage?: string
}
const { title, body, fields = ["name","email","message"], successMessage = "送信しました。ありがとうございます。" } = Astro.props
---
<section class="contact">
  <style is:inline set:html={`
    .contact{padding:clamp(3rem,6vw,5rem) clamp(16px,4vw,40px)}
    .contact__wrap{max-width:600px;margin:0 auto}
    .contact h2{text-align:center;margin-bottom:0.5rem;font-size:clamp(1.6rem,3.5vw,2.4rem)}
    .contact__body{text-align:center;opacity:0.7;margin-bottom:2rem}
    .contact__form{display:flex;flex-direction:column;gap:1rem}
    .contact__form input,.contact__form textarea{width:100%;padding:12px 16px;border:1.5px solid rgba(0,0,0,.1);border-radius:10px;font-size:0.95rem;background:#fff}
    .contact__form input:focus,.contact__form textarea:focus{outline:none;border-color:#2563eb}
    .contact__form textarea{min-height:140px;resize:vertical}
    .contact__form button{padding:14px 32px;background:#2563eb;color:#fff;border:none;border-radius:10px;font-weight:700;font-size:1rem;cursor:pointer}
    .contact__success{display:none;text-align:center;padding:2rem;color:#2563eb;font-weight:600}
    .honeypot{display:none}
  `}></style>
  <div class="contact__wrap">
    <h2>{title}</h2>
    {body && <p class="contact__body">{body}</p>}
    <form class="contact__form" method="POST" action="/api/inquiries">
      <input class="honeypot" type="text" name="website" tabindex="-1" autocomplete="off" />
      {fields.includes("name") && <input type="text" name="name" placeholder="お名前" required />}
      {fields.includes("email") && <input type="email" name="email" placeholder="Email" required />}
      {fields.includes("phone") && <input type="tel" name="phone" placeholder="電話番号" />}
      {fields.includes("company") && <input type="text" name="company" placeholder="会社名" />}
      {fields.includes("message") && <textarea name="message" placeholder="お問い合わせ内容" required></textarea>}
      <button type="submit">送信する</button>
    </form>
    <div class="contact__success">{successMessage}</div>
  </div>
</section>

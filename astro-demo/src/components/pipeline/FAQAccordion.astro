---
export interface Props { items: { question: string; answer: string }[] }
const { items } = Astro.props
---
<section class="faq">
  <style is:inline set:html={`
    .faq{padding:clamp(3rem,6vw,5rem) clamp(16px,4vw,40px)}
    .faq__list{max-width:720px;margin:0 auto}
    .faq details{border-bottom:1px solid rgba(0,0,0,.08);padding:1.2rem 0}
    .faq summary{font-weight:700;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;font-size:1rem}
    .faq summary::after{content:'+';font-size:1.3rem;opacity:0.4}
    .faq details[open] summary::after{content:'−'}
    .faq details p{padding-top:0.8rem;opacity:0.7;line-height:1.8;font-size:0.92rem}
  `}></style>
  <div class="faq__list">
    {items.map((item, i) => (
      <details open={i === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>
    ))}
  </div>
</section>

---
export interface Props { items: { value: string; label: string }[]; colors?: { primary?: string } }
const { items, colors = {} } = Astro.props
const p = colors.primary || "#2563eb"
---
<section class="proof">
  <style is:inline set:html={`
    .proof{padding:clamp(3rem,7vw,5rem) clamp(1.5rem,5vw,3rem);text-align:center;background:linear-gradient(to bottom,rgba(0,0,0,.02),transparent)}
    .proof__grid{display:flex;flex-wrap:wrap;gap:clamp(1.5rem,4vw,3rem);justify-content:center;max-width:900px;margin:0 auto}
    .proof__item{min-width:140px}
    .proof__value{font-size:clamp(2.4rem,5vw,3.6rem);font-weight:900;color:var(--cp,${p});line-height:1;letter-spacing:-0.02em}
    .proof__suffix{font-size:1.2rem;font-weight:600;opacity:0.7;margin-left:2px}
    .proof__label{font-size:0.8rem;text-transform:uppercase;letter-spacing:0.08em;opacity:0.45;margin-top:0.6rem;font-weight:600}
  `}></style>
  <div class="proof__grid">
    {items.map(item => (
      <div class="proof__item">
        <div class="proof__value">{item.value}</div>
        <div class="proof__label">{item.label}</div>
      </div>
    ))}
  </div>
</section>

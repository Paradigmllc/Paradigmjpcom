---
export interface Props { items: { quote: string; author: string; role?: string }[]; colors?: { primary?: string } }
const { items, colors = {} } = Astro.props
const p = colors.primary || "var(--c-primary)"
---
<section class="tmon">
  <style is:inline set:html={`
    .tmon{padding:clamp(3rem,6vw,5rem) clamp(16px,4vw,40px);background:rgba(0,0,0,.02)}
    .tmon__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem;max-width:960px;margin:0 auto}
    .tmon__card{padding:clamp(1.5rem,3vw,2rem);border-radius:12px;background:#fff;border:1px solid rgba(0,0,0,.06)}
    .tmon blockquote{font-size:0.95rem;line-height:1.8;margin:0 0 1rem}
    .tmon blockquote::before{content:'"';font-size:2rem;color:var(--cp,${p});line-height:0;vertical-align:-0.4em;margin-right:4px}
    .tmon__author{font-size:0.88rem;font-weight:600}
    .tmon__role{font-size:0.78rem;opacity:0.5}
  `}></style>
  <div class="tmon__grid">
    {items.map(item => (
      <div class="tmon__card">
        <blockquote>{item.quote}</blockquote>
        <div class="tmon__author">{item.author}</div>
        {item.role && <div class="tmon__role">{item.role}</div>}
      </div>
    ))}
  </div>
</section>

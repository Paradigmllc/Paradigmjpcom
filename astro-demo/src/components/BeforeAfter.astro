---
import type { DemoData } from "../keystatic/demo-data"

interface Props { data: DemoData }

const { data } = Astro.props
const hasImages = data.beforeImage || data.afterImage
---

<section id="before-after" class="py-24 px-6 bg-[#08081a] border-y border-white/5">
  <div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="text-center mb-16">
      <p class="text-sm font-semibold text-brand-light tracking-widest uppercase mb-4">Before & After</p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6">
        改善のビフォーアフター
      </h2>
      <p class="text-white/40 text-lg max-w-2xl mx-auto leading-relaxed">
        データに基づく改善で、サイトはここまで変わります。
      </p>
    </div>

    <!-- Comparison -->
    <div class="grid md:grid-cols-2 gap-8 mb-16">
      <!-- Before -->
      <div class="group">
        <div class="flex items-center gap-3 mb-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-rose-500/20 text-rose-400 text-xs font-bold">×</span>
          <span class="text-sm font-semibold text-white/60">{data.beforeLabel || "Before"}</span>
        </div>
        <div class="relative overflow-hidden rounded-2xl border border-white/5 bg-[#0a0a1a] aspect-video">
          {hasImages ? (
            <img src={data.beforeImage} alt="Before" class="w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity duration-500" loading="lazy" decoding="async" />
          ) : (
            <div class="w-full h-full flex items-center justify-center text-white/10">
              <svg class="h-20 w-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <rect x="3" y="3" width="18" height="18" rx="2" stroke-width="1.5"/>
                <path d="M3 9h18M9 3v18" stroke-width="1.5"/>
              </svg>
            </div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a] via-transparent to-transparent"></div>
        </div>
      </div>

      <!-- After -->
      <div class="group">
        <div class="flex items-center gap-3 mb-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500/20 text-emerald-400 text-xs font-bold">✓</span>
          <span class="text-sm font-semibold text-white/60">{data.afterLabel || "After"}</span>
        </div>
        <div class="relative overflow-hidden rounded-2xl border border-brand/20 bg-[#0a0a1a] aspect-video shadow-2xl shadow-brand/5">
          {hasImages ? (
            <img src={data.afterImage || data.beforeImage} alt="After" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="lazy" decoding="async" />
          ) : (
            <div class="w-full h-full flex items-center justify-center">
              <div class="text-center">
                <div class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-brand/20 mb-4">
                  <svg class="h-8 w-8 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <p class="text-white/30 text-sm">改善後のイメージ</p>
              </div>
            </div>
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a1a]/60 via-transparent to-transparent"></div>
        </div>
      </div>
    </div>

    <!-- Improvement points -->
    {data.improvementPoints && data.improvementPoints.length > 0 && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {data.improvementPoints.map((point) => (
          <div class="glass-card p-5 flex items-start gap-3 group hover:border-brand/30 transition-all duration-300">
            <svg class="h-5 w-5 shrink-0 mt-0.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span class="text-sm text-white/70">{point}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

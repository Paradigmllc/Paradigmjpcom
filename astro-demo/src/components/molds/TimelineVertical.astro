---
// Timeline.astro
export interface Props {
  items: {
    year: string | number;
    title: string;
    body: string;
  }[];
}

const { items } = Astro.props;
---

<div class="relative">
  <!-- 縦のライン -->
  <div class="absolute left-4 top-0 h-full w-0.5 bg-gray-300 dark:bg-gray-600"></div>

  <ul class="space-y-12">
    {
      items.map((item, index) => (
        <li class="relative pl-12">
          <!-- 年表示 -->
          <div class="absolute -left-2 top-0 flex items-center justify-center w-10 h-10 rounded-full bg-blue-500 text-white font-bold text-sm shadow-md">
            {item.year}
          </div>

          <!-- コンテンツ -->
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 border border-gray-200 dark:border-gray-700">
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">
              {item.title}
            </h3>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
              {item.body}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</div>
---
export interface Props {
  headline: string;
  subheadline?: string;
  image?: string;
  primaryCta: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  theme?: "light" | "dark" | "gradient";
  accentColor?: string;
}

const {
  headline,
  subheadline,
  image,
  primaryCta,
  secondaryCta,
  theme = "dark",
  accentColor = "#0071e3",
} = Astro.props;

const themeClasses: Record<string, string> = {
  light: "bg-white text-gray-900",
  dark: "bg-black text-white",
  gradient: "bg-gradient-to-br from-gray-900 via-gray-800 to-black text-white",
};
---

<div
  class="relative overflow-hidden min-h-[90vh] flex items-center justify-center px-4 sm:px-8 md:px-12 lg:px-16 py-20 sm:py-24 md:py-32 lg:py-40 transition-colors duration-700 {themeClasses[theme]}"
>
  {image && (
    <div class="absolute inset-0 z-0">
      <img
        src={image}
        alt=""
        class="w-full h-full object-cover opacity-20 sm:opacity-30 md:opacity-40 lg:opacity-50 animate-fade-in"
        loading="lazy"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/30 to-transparent" />
    </div>
  )}

  <div class="relative z-10 max-w-4xl mx-auto text-center space-y-6 sm:space-y-8 md:space-y-10 lg:space-y-12">
    <h1
      class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl font-extrabold tracking-tight leading-none animate-slide-up"
      style="--accent-color: {accentColor}; color: var(--accent-color); background: linear-gradient(135deg, {accentColor}, #a78bfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
    >
      {headline}
    </h1>

    {subheadline && (
      <p
        class="text-lg sm:text-xl md:text-2xl lg:text-3xl font-medium max-w-2xl mx-auto opacity-80 animate-fade-in"
        style="animation-delay: 0.2s"
      >
        {subheadline}
      </p>
    )}

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 mt-6 sm:mt-8 md:mt-10">
      <a
        href={primaryCta.href}
        class="inline-flex items-center px-8 py-4 sm:px-10 sm:py-5 md:px-12 md:py-6 rounded-full text-base sm:text-lg md:text-xl font-bold tracking-wide transition-all duration-300 hover:scale-105 hover:shadow-2xl animate-fade-in"
        style="background-color: {accentColor}; color: white; --shadow-color: {accentColor}40; box-shadow: 0 8px 32px var(--shadow-color); animation-delay: 0.3s"
      >
        {primaryCta.label}
      </a>

      {secondaryCta && (
        <a
          href={secondaryCta.href}
          class="inline-flex items-center px-8 py-4 sm:px-10 sm:py-5 md:px-12 md:py-6 rounded-full text-base sm:text-lg md:text-xl font-bold tracking-wide border-2 transition-all duration-300 hover:bg-white/10 hover:scale-105 animate-fade-in"
          style="border-color: {accentColor}; color: {accentColor}; animation-delay: 0.4s"
        >
          {secondaryCta.label}
        </a>
      )}
    </div>
  </div>
</div>

<style is:global>
  @keyframes fade-in {
    0% { opacity: 0; }
    100% { opacity: 1; }
  }

  @keyframes slide-up {
    0% { opacity: 0; transform: translateY(40px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }

  .animate-slide-up {
    animation: slide-up 0.8s ease-out forwards;
  }
</style>
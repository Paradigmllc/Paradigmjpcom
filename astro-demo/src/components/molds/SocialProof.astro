---
export interface Props {
  rating: number;
  reviewCount: number;
  badges?: string[];
}

const { rating, reviewCount, badges = [] } = Astro.props;

// レーティング表示用の星を生成
const fullStars = Math.floor(rating);
const hasHalfStar = rating - fullStars >= 0.5;
const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
---

<div class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-lg shadow-sm">
  <!-- 星評価 -->
  <div class="flex items-center gap-0.5 text-yellow-400" aria-label={`${rating} out of 5 stars`}>
    {Array.from({ length: fullStars }).map((_, i) => (
      <svg key={`full-${i}`} class="w-4 h-4 fill-current" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
    ))}
    {hasHalfStar && (
      <svg class="w-4 h-4" viewBox="0 0 20 20">
        <defs>
          <linearGradient id="half-star">
            <stop offset="50%" stop-color="currentColor"/>
            <stop offset="50%" stop-color="#D1D5DB"/>
          </linearGradient>
        </defs>
        <path fill="url(#half-star)" d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
    )}
    {Array.from({ length: emptyStars }).map((_, i) => (
      <svg key={`empty-${i}`} class="w-4 h-4 fill-gray-300" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
    ))}
  </div>

  <!-- 評価テキスト -->
  <span class="text-sm font-medium text-gray-700">
    {rating.toFixed(1)}
  </span>

  <!-- 口コミ数 -->
  <span class="text-sm text-gray-500">
    ({reviewCount.toLocaleString()})
  </span>

  <!-- 認証バッジ -->
  {badges.length > 0 && (
    <div class="flex items-center gap-1 ml-1 border-l border-gray-200 pl-2">
      {badges.map((badge, index) => (
        <span
          key={index}
          class="inline-flex items-center gap-0.5 px-1.5 py-0.5 text-xs font-medium text-green-700 bg-green-50 border border-green-200 rounded-full"
        >
          <svg class="w-3 h-3 fill-current" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          {badge}
        </span>
      ))}
    </div>
  )}
</div>
---
// CardGrid.astro
export interface Props {
  items: {
    icon: string;
    title: string;
    body: string;
  }[];
  columns?: 1 | 2 | 3 | 4;
}

const { items, columns = 3 } = Astro.props;

const colClasses: Record<number, string> = {
  1: 'grid-cols-1',
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
};
---

<div class="grid gap-6 md:gap-8 {colClasses[columns]}">
  {
    items.map(({ icon, title, body }) => (
      <div
        class="group relative flex flex-col items-center rounded-2xl border border-gray-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-xl dark:border-gray-700 dark:bg-gray-800"
      >
        {/* アイコン */}
        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-gradient-to-br from-blue-50 to-indigo-100 text-2xl text-indigo-600 transition-transform duration-300 group-hover:scale-110 group-hover:from-blue-100 group-hover:to-indigo-200 dark:from-blue-900/30 dark:to-indigo-900/30 dark:text-indigo-400">
          <span class="[&>svg]:h-7 [&>svg]:w-7" set:html={icon} />
        </div>

        {/* タイトル */}
        <h3 class="mb-2 text-lg font-semibold text-gray-900 dark:text-white">
          {title}
        </h3>

        {/* 説明 */}
        <p class="text-center text-sm leading-relaxed text-gray-600 dark:text-gray-400">
          {body}
        </p>

        {/* アクセントライン（ホバー時に表示） */}
        <div class="absolute bottom-0 left-0 h-1 w-0 rounded-b-2xl bg-gradient-to-r from-blue-500 to-indigo-500 transition-all duration-300 group-hover:w-full" />
      </div>
    ))
  }
</div>


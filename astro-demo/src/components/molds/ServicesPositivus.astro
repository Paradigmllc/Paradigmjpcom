---
// ServiceCardGrid.astro
// Positivus サービスカードグリッド - デザインスペック厳守
// このファイルは Astro + Tailwind CSS で実装されています

export interface Props {
  services: {
    title: string;
    description: string;
  }[];
}

const { services } = Astro.props;

// カード背景色の循環パターン (厳密な順序)
const cardBgColors = ["#f3f3f3", "#b9ff66", "#191a23"];
---

<div class="w-full" style="padding: 0 100px;">
  <div class="grid grid-cols-2 gap-[77px]" style="padding: 50px;">
    {
      services.map((service, index) => {
        // 交互背景色: 6色パターン (f3f3f3 → b9ff66 → 191a23 → f3f3f3 → b9ff66 → 191a23)
        const bgColor = cardBgColors[index % 3];
        const isDark = bgColor === "#191a23";
        const textColor = isDark ? "text-white" : "text-[#191a23]";

        return (
          <div
            class="rounded-[45px] flex flex-col justify-between"
            style={{
              backgroundColor: bgColor,
              padding: "50px",
              gap: "77px",
            }}
          >
            {/* 上部: ラベル + 説明 */}
            <div class="flex flex-col gap-10">
              {/* Heading コンポーネント (ラベル) */}
              <div
                class="inline-block self-start rounded-none"
                style={{
                  backgroundColor: "#b9ff66",
                  padding: "0px 7px",
                  gap: "10px",
                }}
              >
                <h2
                  class="font-space-grotesk text-[40px] leading-tight font-medium"
                  style={{ color: "#191a23" }}
                >
                  {service.title}
                </h2>
              </div>

              {/* 説明文 */}
              {service.description && (
                <p
                  class="font-space-grotesk text-[18px] leading-relaxed"
                  style={{ color: textColor }}
                >
                  {service.description}
                </p>
              )}
            </div>

            {/* Link コンポーネント */}
            <div class="flex items-center">
              <a
                href="#"
                class="inline-flex items-center font-space-grotesk text-[18px] font-medium transition-opacity hover:opacity-80"
                style={{
                  backgroundColor: isDark ? "#f3f3f3" : "#191a23",
                  color: isDark ? "#191a23" : "#f3f3f3",
                  padding: "20px 35px",
                  borderRadius: "14px",
                }}
              >
                <span>Learn more</span>
                <svg
                  class="ml-2 w-5 h-5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"
                  />
                </svg>
              </a>
            </div>
          </div>
        );
      })
    }
  </div>
</div>

<style is:global>
  /* Space Grotesk フォントのインポート */
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap');

  .font-space-grotesk {
    font-family: 'Space Grotesk', sans-serif;
  }
</style>
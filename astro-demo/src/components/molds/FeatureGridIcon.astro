---
export interface Props {
  items: {
    title: string;
    body: string;
    icon: string;
  }[];
  columns?: 2 | 3 | 4;
}

const { items, columns = 3 } = Astro.props;

const gridColsClass = {
  2: "md:grid-cols-2",
  3: "md:grid-cols-3",
  4: "md:grid-cols-4",
}[columns];
---

<div
  class="grid grid-cols-1 gap-8 {gridColsClass}"
>
  {
    items.map((item) => (
      <div class="flex flex-col items-center text-center">
        <span class="text-4xl mb-3">{item.icon}</span>
        <h3 class="text-lg font-semibold mb-2">{item.title}</h3>
        <p class="text-sm text-gray-600">{item.body}</p>
      </div>
    ))
  }
</div>
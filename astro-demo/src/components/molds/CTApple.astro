---
// Apple-style CTA Section Component
// Props: headline, subheadline, ctaLabel, ctaHref

export interface Props {
  headline: string;
  subheadline?: string;
  ctaLabel: string;
  ctaHref: string;
}

const { headline, subheadline, ctaLabel, ctaHref } = Astro.props;
---

<section class="cta-section bg-[#000] text-[#f5f5f7]">
  <div class="mx-auto max-w-[980px] px-6 py-[clamp(4rem,8vw,8rem)] text-center">
    <h2 class="text-[clamp(2.5rem,5vw,4rem)] font-[400] leading-[1.15] tracking-[-0.02em] text-white opacity-0 translate-y-8 animate-fade-in">
      {headline}
    </h2>
    
    {subheadline && (
      <p class="mx-auto mt-6 max-w-[680px] text-[clamp(1.125rem,2vw,1.5rem)] font-[400] leading-[1.5] text-[#f5f5f7]/80 opacity-0 translate-y-8 animate-fade-in animation-delay-200">
        {subheadline}
      </p>
    )}
    
    <div class="mt-10 opacity-0 translate-y-8 animate-fade-in animation-delay-400">
      <a
        href={ctaHref}
        class="inline-block rounded-[54px] bg-[#0071e3] px-6 py-3 text-[1.0625rem] font-[400] text-white no-underline transition-all duration-300 ease-out hover:bg-[#0077ed] active:bg-[#006edb] focus:outline-none focus:ring-2 focus:ring-[#0071e3] focus:ring-offset-2 focus:ring-offset-black"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }
</style>
---
interface Feature {
  name: string;
  competitor: string;
  us: string;
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;
---

<table class="w-full border-collapse">
  <thead>
    <tr class="border-b-2 border-gray-300">
      <th class="py-3 px-4 text-left font-semibold text-gray-700">機能</th>
      <th class="py-3 px-4 text-center font-semibold text-gray-500">競合</th>
      <th class="py-3 px-4 text-center font-semibold text-indigo-700 bg-indigo-50">当社</th>
    </tr>
  </thead>
  <tbody>
    {features.map((feature, index) => (
      <tr class={index % 2 === 0 ? "bg-white" : "bg-gray-50" + " border-b border-gray-200 hover:bg-indigo-50/30 transition-colors"}>
        <td class="py-3 px-4 font-medium text-gray-800">{feature.name}</td>
        <td class="py-3 px-4 text-center text-gray-500">
          {feature.competitor === "✓" ? (
            <span class="text-green-500 font-bold">✓</span>
          ) : feature.competitor === "✗" ? (
            <span class="text-red-400">✗</span>
          ) : (
            <span class="text-gray-500">{feature.competitor}</span>
          )}
        </td>
        <td class="py-3 px-4 text-center bg-indigo-50 font-medium">
          {feature.us === "✓" ? (
            <span class="text-green-600 font-bold text-lg">✓</span>
          ) : feature.us === "✗" ? (
            <span class="text-red-400">✗</span>
          ) : feature.us === "★" ? (
            <span class="text-yellow-500 text-lg">★</span>
          ) : (
            <span class="text-indigo-700 font-semibold">{feature.us}</span>
          )}
        </td>
      </tr>
    ))}
  </tbody>
</table>
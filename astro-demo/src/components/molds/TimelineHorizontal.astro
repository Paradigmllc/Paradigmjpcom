---
// Timeline.astro
export interface Props {
  items: {
    date: string;
    title: string;
    body: string;
  }[];
}

const { items } = Astro.props;
---

<div class="timeline-container relative w-full overflow-x-auto pb-8">
  <div class="timeline-track relative flex gap-8 min-w-max px-8">
    <!-- 中央ライン -->
    <div class="absolute top-1/2 left-0 right-0 h-0.5 bg-gray-200 -translate-y-1/2 pointer-events-none"></div>

    {
      items.map((item, index) => (
        <div class="timeline-item relative flex-shrink-0 w-64" data-index={index}>
          <!-- ドット -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10">
            <div class="w-4 h-4 bg-blue-500 rounded-full border-4 border-white shadow-md"></div>
          </div>

          <!-- カード（日付の位置で上下交互） -->
          <div class={`relative ${index % 2 === 0 ? 'mt-0 pt-0' : 'mt-[calc(100%+2rem)]'}`}>
            <!-- カード上部の矢印ライン（偶数: 上向き / 奇数: 下向き） -->
            <div class={`absolute left-1/2 -translate-x-1/2 ${index % 2 === 0 ? 'bottom-full' : 'top-0 -translate-y-full'}`}>
              <div class={`w-0.5 h-6 ${index % 2 === 0 ? 'bg-blue-500' : 'bg-blue-500'}`}></div>
              <div class={`absolute left-1/2 -translate-x-1/2 w-3 h-3 border-blue-500 ${index % 2 === 0 ? 'border-b-2 border-r-2 rotate-45 -bottom-1' : 'border-t-2 border-l-2 rotate-45 -top-1'}`}></div>
            </div>

            <!-- カード本体 -->
            <div class="bg-white rounded-lg shadow-lg p-5 border border-gray-100 hover:shadow-xl transition-shadow duration-300">
              <span class="inline-block text-sm font-semibold text-blue-600 mb-2 bg-blue-50 px-3 py-1 rounded-full">
                {item.date}
              </span>
              <h3 class="text-lg font-bold text-gray-800 mb-2 leading-tight">
                {item.title}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed">
                {item.body}
              </p>
            </div>
          </div>

          <!-- カードの位置調整（偶数：上に配置 / 奇数：下に配置） -->
          <div class={`${index % 2 === 0 ? 'block' : 'hidden'}`}>
            <div class="mt-8"></div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  /* スクロールバーカスタマイズ（オプション） */
  .timeline-container::-webkit-scrollbar {
    height: 8px;
  }
  .timeline-container::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 4px;
  }
  .timeline-container::-webkit-scrollbar-thumb {
    background: #94a3b8;
    border-radius: 4px;
  }
  .timeline-container::-webkit-scrollbar-thumb:hover {
    background: #64748b;
  }
</style>
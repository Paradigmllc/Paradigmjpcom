---
export interface FormField {
  name: string;
  label: string;
  type: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  required?: boolean;
  placeholder?: string;
  options?: string[];
}

export interface Props {
  title: string;
  body: string;
  fields: FormField[];
  theme?: 'light' | 'dark' | 'brand';
}

const { title, body, fields, theme = 'light' } = Astro.props;
---

<div class={`contact-form ${theme === 'dark' ? 'bg-gray-900 text-white' : theme === 'brand' ? 'bg-indigo-600 text-white' : 'bg-white text-gray-900'} py-12 px-4 sm:px-6 lg:px-8`}>
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
      <p class="mt-4 text-lg leading-8">{body}</p>
    </div>

    <form class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2" method="POST" action="#">
      {
        fields.map((field, index) => {
          const isFullWidth = field.type === 'textarea';
          const colClass = isFullWidth ? 'sm:col-span-2' : '';
          const labelClass = `block text-sm font-semibold leading-6 ${theme === 'dark' ? 'text-gray-200' : theme === 'brand' ? 'text-indigo-100' : 'text-gray-900'}`;
          const inputClass = `mt-2.5 block w-full rounded-md border-0 px-3.5 py-2.5 shadow-sm ring-1 ring-inset focus:ring-2 focus:ring-inset sm:text-sm sm:leading-6 ${
            theme === 'dark'
              ? 'bg-gray-800 text-white ring-gray-600 placeholder:text-gray-400 focus:ring-indigo-400'
              : theme === 'brand'
              ? 'bg-indigo-500 text-white ring-indigo-400 placeholder:text-indigo-200 focus:ring-white'
              : 'bg-white text-gray-900 ring-gray-300 placeholder:text-gray-400 focus:ring-indigo-600'
          }`;

          return (
            <div class={colClass} key={index}>
              <label for={field.name} class={labelClass}>
                {field.label}
                {field.required && <span class="text-red-400 ml-1">*</span>}
              </label>

              {field.type === 'textarea' ? (
                <textarea
                  id={field.name}
                  name={field.name}
                  rows={4}
                  placeholder={field.placeholder || ''}
                  required={field.required || false}
                  class={inputClass}
                />
              ) : field.type === 'select' ? (
                <select
                  id={field.name}
                  name={field.name}
                  required={field.required || false}
                  class={inputClass}
                >
                  <option value="" disabled selected>{field.placeholder || '選択してください'}</option>
                  {field.options?.map((opt) => (
                    <option value={opt}>{opt}</option>
                  ))}
                </select>
              ) : (
                <input
                  id={field.name}
                  name={field.name}
                  type={field.type}
                  placeholder={field.placeholder || ''}
                  required={field.required || false}
                  class={inputClass}
                />
              )}
            </div>
          );
        })
      }

      <div class="sm:col-span-2 mt-4">
        <button
          type="submit"
          class={`w-full rounded-md px-3.5 py-2.5 text-center text-sm font-semibold shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 transition-colors ${
            theme === 'dark'
              ? 'bg-indigo-500 text-white hover:bg-indigo-400 focus-visible:outline-indigo-400'
              : theme === 'brand'
              ? 'bg-white text-indigo-600 hover:bg-indigo-50 focus-visible:outline-white'
              : 'bg-indigo-600 text-white hover:bg-indigo-500 focus-visible:outline-indigo-600'
          }`}
        >
          送信する
        </button>
      </div>
    </form>
  </div>
</div>
---
export interface Props {
  items: { value: string; label: string }[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-2 md:grid-cols-4 gap-4">
  {
    items.map((item) => (
      <div class="flex flex-col items-center justify-center p-6 bg-white rounded-xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
        <span class="text-3xl md:text-4xl font-bold text-gray-900">
          {item.value}
        </span>
        <span class="mt-2 text-sm text-gray-500 text-center">
          {item.label}
        </span>
      </div>
    ))
  }
</div>
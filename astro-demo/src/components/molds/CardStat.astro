---
export interface Props {
  items: {
    value: string | number;
    label: string;
    trend?: 'up' | 'down' | 'neutral';
  }[];
  columns?: 2 | 3 | 4 | 5 | 6;
}

const { items, columns = 3 } = Astro.props;

const gridCols: Record<number, string> = {
  2: 'grid-cols-1 sm:grid-cols-2',
  3: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-3',
  4: 'grid-cols-1 sm:grid-cols-2 lg:grid-cols-4',
  5: 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5',
  6: 'grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6',
};
---

<div class="grid gap-4 {gridCols[columns]}">
  {items.map((item) => (
    <div class="relative flex flex-col items-center justify-center rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
      <div class="flex items-baseline gap-1.5">
        <span class="text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
          {item.value}
        </span>
        {item.trend && (
          <span class="text-lg" aria-hidden="true">
            {item.trend === 'up' && (
              <svg class="h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
              </svg>
            )}
            {item.trend === 'down' && (
              <svg class="h-4 w-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            )}
            {item.trend === 'neutral' && (
              <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14" />
              </svg>
            )}
          </span>
        )}
      </div>
      <span class="mt-1 text-sm font-medium text-gray-500">
        {item.label}
      </span>
    </div>
  ))}
</div>
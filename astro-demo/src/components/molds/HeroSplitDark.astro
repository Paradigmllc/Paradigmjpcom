---
// src/components/DarkThemeHero.astro
export interface Props {
  headline: string;
  subheadline: string;
  image: string;
  cta: string;
}

const { headline, subheadline, image, cta } = Astro.props;
---

<section class="relative min-h-[600px] flex items-center bg-gray-950 text-gray-100 overflow-hidden">
  <div class="container mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Text Content -->
      <div class="flex flex-col gap-6 lg:pr-8">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-tight">
          {headline}
        </h1>
        <p class="text-lg md:text-xl text-gray-300 max-w-lg">
          {subheadline}
        </p>
        <div class="mt-4">
          <a
            href="#"
            class="inline-block bg-white text-gray-950 font-semibold px-8 py-4 rounded-md shadow-lg hover:bg-gray-200 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-gray-400 focus:ring-offset-2 focus:ring-offset-gray-950"
          >
            {cta}
          </a>
        </div>
      </div>

      <!-- Right: Image -->
      <div class="relative flex justify-center lg:justify-end">
        <div class="relative w-full max-w-lg aspect-[4/3] rounded-lg overflow-hidden shadow-2xl ring-1 ring-gray-800">
          <img
            src={image}
            alt={headline}
            class="w-full h-full object-cover"
            loading="eager"
          />
          <!-- subtle gradient overlay for depth -->
          <div class="absolute inset-0 bg-gradient-to-t from-gray-950/30 to-transparent pointer-events-none"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- subtle background texture / grain -->
  <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI1MCIgaGVpZ2h0PSI1MCIgdmlld0JveD0iMCAwIDUwIDUwIj48cGF0aCBkPSJNMjUgM0MxMi44IDMgMyAxMi44IDMgMjVzOS44IDIyIDIyIDIyIDIyLTkuOCAyMi0yMlMzNy4yIDMgMjUgM3oiIGZpbGw9IiNmZmYiIG9wYWNpdHk9IjAuMDMiLz48L3N2Zz4=')] opacity-30 pointer-events-none"></div>
</section>
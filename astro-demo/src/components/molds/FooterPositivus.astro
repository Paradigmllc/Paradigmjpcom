---
interface FooterProps {
  companyName: string;
  navLinks: { label: string; href: string }[];
  contact: { address: string; phone: string; email: string };
}

const { companyName, navLinks, contact } = Astro.props;
---

<footer class="bg-[#191a23] text-white font-['Space_Grotesk']">
  <div class="max-w-[1440px] mx-auto px-[100px] py-16">
    <!-- Top section: Logo + Navigation -->
    <div class="flex items-start justify-between gap-[206px] mb-16">
      <!-- Logo + Company Name -->
      <div class="flex-shrink-0">
        <a href="/" class="text-2xl font-bold">
          <span class="text-[#b9ff66]">◈</span> {companyName}
        </a>
      </div>

      <!-- Navigation Links -->
      <nav class="flex items-center gap-10">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-[18px] leading-[1.3] text-white/90 hover:text-[#b9ff66] transition-colors underline underline-offset-4 decoration-1"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Middle section: Contact + Newsletter -->
    <div class="flex justify-between gap-20 mb-20">
      <!-- Contact Info -->
      <div class="max-w-[320px]">
        <span
          class="inline-block px-[7px] py-0 bg-[#b9ff66] text-[#191a23] text-[18px] font-medium rounded-[14px] mb-6"
        >
          Contact us:
        </span>
        <div class="space-y-4 text-[18px] leading-[1.3]">
          <p>{contact.address}</p>
          <p>{contact.phone}</p>
          <p>{contact.email}</p>
        </div>
      </div>

      <!-- Newsletter Subscription -->
      <div
        class="bg-[#292a32] rounded-[45px] p-[50px] flex items-center gap-[77px] max-w-[634px] w-full"
      >
        <input
          type="email"
          placeholder="Email"
          class="flex-1 bg-transparent border-2 border-white rounded-[14px] px-[35px] py-[20px] text-[18px] placeholder:text-white/50 focus:outline-none focus:border-[#b9ff66]"
        />
        <button
          class="bg-[#b9ff66] text-[#191a23] font-medium text-[18px] rounded-[14px] px-[35px] py-[20px] whitespace-nowrap hover:bg-[#a0e64d] transition-colors"
        >
          Subscribe to news
        </button>
      </div>
    </div>

    <!-- Divider -->
    <div class="w-full h-px bg-white/20 mb-8"></div>

    <!-- Bottom: Copyright + Legal links -->
    <div class="flex items-center justify-between text-[18px] text-white/70">
      <p>© {new Date().getFullYear()} {companyName}. All Rights Reserved.</p>
      <div class="flex items-center gap-6">
        <a href="/privacy-policy" class="underline underline-offset-2 hover:text-[#b9ff66]">
          Privacy Policy
        </a>
      </div>
    </div>
  </div>
</footer>
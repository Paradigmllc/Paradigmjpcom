---
export interface Props {
  text: string;
  phone: string;
  ctaLabel: string;
  ctaHref: string;
}

const { text, phone, ctaLabel, ctaHref } = Astro.props;
---

<div class="fixed bottom-0 left-0 right-0 z-50 border-t border-gray-200 bg-white/95 backdrop-blur-sm shadow-lg">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
    <div class="flex flex-col">
      <p class="text-sm font-medium text-gray-900">{text}</p>
      <a
        href={`tel:${phone}`}
        class="text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors"
      >
        {phone}
      </a>
    </div>
    <a
      href={ctaHref}
      class="inline-flex items-center gap-2 rounded-lg bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 transition-all active:scale-95"
    >
      {ctaLabel}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        fill="currentColor"
        class="h-4 w-4"
      >
        <path
          fill-rule="evenodd"
          d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
          clip-rule="evenodd"
        />
      </svg>
    </a>
  </div>
</div>
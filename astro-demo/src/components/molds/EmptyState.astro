---
export interface Props {
  icon?: string;
  title: string;
  body: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { icon, title, body, ctaLabel, ctaHref } = Astro.props;
---

<div
  class="flex flex-col items-center justify-center py-16 px-4 text-center"
>
  {
    icon && (
      <span class="text-5xl mb-4">{icon}</span>
    )
  }

  <h2 class="text-2xl font-bold text-gray-800 mb-2">{title}</h2>
  <p class="text-gray-500 max-w-md mb-6">{body}</p>

  {
    ctaLabel && ctaHref && (
      <a
        href={ctaHref}
        class="inline-block rounded-lg bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow hover:bg-blue-700 transition-colors"
      >
        {ctaLabel}
      </a>
    )
  }
</div>
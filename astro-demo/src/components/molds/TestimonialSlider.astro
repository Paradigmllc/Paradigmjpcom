---
interface Props {
  items: {
    quote: string;
    author: string;
    role: string;
  }[];
}

const { items } = Astro.props;
---

<div class="overflow-x-auto pb-4">
  <div class="flex gap-6 w-max px-4">
    {
      items.map((item) => (
        <div class="flex-shrink-0 w-80 bg-white rounded-2xl shadow-lg p-6 border border-gray-100">
          <p class="text-gray-700 leading-relaxed mb-6">"{item.quote}"</p>
          <div class="border-t pt-4">
            <p class="font-semibold text-gray-900">{item.author}</p>
            <p class="text-sm text-gray-500">{item.role}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
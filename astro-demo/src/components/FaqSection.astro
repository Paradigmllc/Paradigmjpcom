---
import type { DemoData } from "../keystatic/demo-data"

interface Props { data: DemoData }
const { data } = Astro.props
const faqItems = data.faqItems?.length ? data.faqItems : []
---

{faqItems.length > 0 && (
  <section id="faq" class="py-24 px-6">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-sm font-semibold text-brand-light tracking-widest uppercase mb-4">FAQ</p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6">
          {data.faqTitle || "よくあるご質問"}
        </h2>
      </div>

      <div class="space-y-4">
        {faqItems.map((item) => (
          <div class="glass-card">
            <input type="checkbox" id={`faq-${item.question.slice(0, 8)}`} class="peer hidden" />
            <label for={`faq-${item.question.slice(0, 8)}`} class="flex items-center justify-between p-6 cursor-pointer select-none">
              <span class="text-base font-semibold text-white pr-8">{item.question}</span>
              <svg class="h-5 w-5 shrink-0 text-white/30 peer-checked:rotate-180 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </label>
            <div class="hidden peer-checked:block px-6 pb-6">
              <p class="text-white/50 leading-relaxed">{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

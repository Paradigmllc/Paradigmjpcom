---
import type { DemoData } from "../keystatic/demo-data"

interface Props { data: DemoData }
const { data } = Astro.props
const testimonials = data.testimonials?.length ? data.testimonials : []
const certifications = data.certifications?.length ? data.certifications : []
if (testimonials.length === 0 && certifications.length === 0) return new Response(null, { status: 200 })
---

<section id="trust" class="py-24 px-6 bg-[#08081a] border-y border-white/5">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-sm font-semibold text-brand-light tracking-widest uppercase mb-4">Trust</p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6">
        {data.trustTitle || "信頼の実績"}
      </h2>
    </div>

    {testimonials.length > 0 && (
      <div class="grid md:grid-cols-2 gap-6 mb-16">
        {testimonials.map((t) => (
          <div class="glass-card p-8 relative group hover:border-brand/20 transition-all duration-300">
            <svg class="h-8 w-8 text-brand/30 mb-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z"/>
            </svg>
            <p class="text-white/70 leading-relaxed mb-6 text-lg italic">
              {t.quote}
            </p>
            <div class="flex items-center gap-3 pt-4 border-t border-white/5">
              <div class="flex h-10 w-10 items-center justify-center rounded-full bg-brand/20 text-brand text-sm font-bold">
                {t.author.slice(0, 1)}
              </div>
              <div>
                <p class="text-sm font-semibold text-white">{t.author}</p>
                <p class="text-xs text-white/40">{t.role} - {t.company}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    {certifications.length > 0 && (
      <div class="flex flex-wrap justify-center gap-6">
        {certifications.map((cert) => (
          <div class="glass-card px-6 py-4 flex items-center gap-3 hover:border-brand/30 transition-all duration-300">
            <svg class="h-5 w-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
            <span class="text-sm font-semibold text-white/60">{cert}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

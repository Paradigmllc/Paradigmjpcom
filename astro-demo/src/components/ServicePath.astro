---
import type { DemoData } from "../keystatic/demo-data"

const iconMap: Record<string, string> = {
  Globe: `<svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10A15.3 15.3 0 0112 2z"/></svg>`,
  Search: `<svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
  Play: `<svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>`,
  Shield: `<svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  Zap: `<svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  BarChart: `<svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  Code: `<svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
  Pen: `<svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
}

interface Props { data: DemoData }
const { data } = Astro.props
const services = data.services?.length ? data.services : []
---

<section id="service-path" class="py-24 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-sm font-semibold text-brand-light tracking-widest uppercase mb-4">Solutions</p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6">
        {data.serviceTitle}
      </h2>
      {data.serviceSubtitle && (
        <p class="text-white/40 text-lg max-w-2xl mx-auto leading-relaxed">{data.serviceSubtitle}</p>
      )}
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {services.map((svc) => (
        <div class="glass-card glass-card-hover p-8 group relative overflow-hidden">
          <!-- Hover glow -->
          <div class="absolute inset-0 bg-gradient-to-br from-brand/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-3xl"></div>
          <div class="relative z-10">
            <!-- Icon -->
            <div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-brand/15 text-brand group-hover:bg-brand/25 group-hover:scale-110 transition-all duration-300">
              <Fragment set:html={iconMap[svc.icon] ?? iconMap.Globe} />
            </div>
            <!-- Title + Description -->
            <h3 class="text-xl font-bold text-white mb-3">{svc.title}</h3>
            <p class="text-white/50 leading-relaxed mb-6">{svc.description}</p>
            <!-- Features list -->
            {svc.features && svc.features.length > 0 && (
              <ul class="space-y-2.5">
                {svc.features.map((f) => (
                  <li class="flex items-center gap-2.5 text-sm text-white/40">
                    <svg class="h-4 w-4 shrink-0 text-brand/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    {f}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

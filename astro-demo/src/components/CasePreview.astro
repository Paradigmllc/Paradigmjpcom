---
import type { DemoData } from "../keystatic/demo-data"

interface Props { data: DemoData }
const { data } = Astro.props
const metrics = data.caseMetrics?.length ? data.caseMetrics : []

const caseImages: Record<string, string> = {
  beauty_salon: "https://images.unsplash.com/photo-1560066984-138dadb4c035?w=800&q=80",
  dental: "https://images.unsplash.com/photo-1606811971618-4486d14f3f99?w=800&q=80",
  restaurant: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=800&q=80",
  construction: "https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=800&q=80",
  accounting: "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=800&q=80",
  retail: "https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=800&q=80",
  cleaning: "https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=800&q=80",
  consulting: "https://images.unsplash.com/photo-1600880292203-757bb62b4baf?w=800&q=80",
}
---

<section id="case-study" class="py-24 px-6 bg-[#08081a]">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <p class="text-sm font-semibold text-brand-light tracking-widest uppercase mb-4">Case Study</p>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6">{data.caseTitle}</h2>
      <p class="text-white/40 text-lg max-w-2xl mx-auto leading-relaxed">{data.caseDescription}</p>
    </div>

    <div class="grid lg:grid-cols-5 gap-12 items-center">
      <!-- Metrics grid -->
      <div class="lg:col-span-3 grid grid-cols-2 gap-4">
        {metrics.map((m) => (
          <div class="glass-card p-6 group hover:border-brand/20 transition-all duration-300">
            <p class="text-4xl sm:text-5xl font-black text-brand tabular-nums group-hover:scale-110 transition-transform duration-300 origin-left">
              {m.value}<span class="text-xl text-brand-light ml-1">{m.suffix}</span>
            </p>
            <p class="mt-2 text-sm font-semibold text-white/70">{m.label}</p>
            {m.detail && (
              <p class="mt-1.5 text-xs text-white/30 leading-relaxed">{m.detail}</p>
            )}
          </div>
        ))}
      </div>

      <!-- Image -->
      <div class="lg:col-span-2 relative">
        <div class="absolute -inset-2 bg-gradient-to-br from-brand/30 to-purple-600/20 rounded-3xl blur-xl opacity-60"></div>
        <img
          src={data.caseImage ?? caseImages[data.industry] ?? caseImages.consulting}
          alt="Case study"
          class="relative w-full rounded-2xl border border-white/10 shadow-2xl"
          loading="lazy" decoding="async"
        />
      </div>
    </div>
  </div>
</section>

---
import type { DemoData } from "../keystatic/demo-data"

const iconMap: Record<string, string> = {
  Search: `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>`,
  Zap: `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>`,
  BarChart: `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>`,
  Shield: `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  Globe: `<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 014 10"/></svg>`,
}

interface Props { data: DemoData }
const { data } = Astro.props
const steps = data.processSteps?.length ? data.processSteps : []
---

{steps.length > 0 && (
  <section id="process" class="py-24 px-6">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-16">
        <p class="text-sm font-semibold text-brand-light tracking-widest uppercase mb-4">Process</p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6">
          {data.processTitle || "プロジェクトの流れ"}
        </h2>
      </div>

      <div class="relative">
        <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-brand/50 via-white/10 to-brand/50 md:-translate-x-px hidden md:block"></div>
        <div class="space-y-12">
          {steps.map((step, i) => {
            const isLeft = i % 2 === 0
            return (
              <div class="relative flex flex-col md:flex-row gap-6 md:gap-12 items-start">
                <div class="flex-shrink-0 flex items-center justify-center w-16 h-16 rounded-2xl bg-brand/15 border border-brand/20 text-brand font-black text-xl z-10">
                  {step.step}
                </div>
                <div class="flex-1 glass-card p-8 hover:border-brand/20 transition-all duration-300">
                  <div class="flex items-center gap-3 mb-3">
                    <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand/20 text-brand">
                      <Fragment set:html={iconMap[step.icon] ?? iconMap.Zap} />
                    </div>
                    <h3 class="text-xl font-bold text-white">{step.title}</h3>
                  </div>
                  <p class="text-white/50 leading-relaxed">{step.description}</p>
                </div>
                <div class="hidden md:block flex-1"></div>
              </div>
            )
          })}
        </div>
      </div>
    </div>
  </section>
)}

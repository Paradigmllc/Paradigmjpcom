{
  "name": "youtube-media-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "derivative:sample": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-derivative.ps1 -Source renders/enron-evidence-room-draft.mp4 -Output renders/enron-evidence-room-vertical-test.mp4 -StartSeconds 20 -DurationSeconds 12 -Profile vertical-fit",
    "derivative:edl-sample": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-edl-derivative.ps1 -Manifest video/pilot-investigation/derivatives/enron-ja-short.json",
    "opencut:adapt-sample": "node scripts/adapt-opencut-edl.mjs video/pilot-investigation/derivatives/opencut-project-sample.json --source renders/enron-evidence-room-draft.mp4 --render-output renders/enron-opencut-edl-test.mp4 --manifest-output renders/enron-opencut-edl.json --profile vertical-fit",
    "transcript:validate-sample": "node scripts/validate-transcript.mjs video/pilot-investigation/derivatives/ja-transcript-sample.json --output renders/ja-transcript-clean.json",
    "caption:font": "node scripts/fetch-caption-font.mjs",
    "caption:ass-sample": "node scripts/generate-ass-captions.mjs video/pilot-investigation/derivatives/ja-transcript-sample.json --output renders/enron-caption-sample.ass --profile vertical",
    "caption:pipeline-sample": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-captioned-sample.ps1",
    "voice:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-voice-runtime.ps1",
    "voice:bootstrap:production": "node scripts/bootstrap-production-voice-models.mjs",
    "voice:assets": "node scripts/fetch-kokoro-assets.mjs",
    "narration:pilot-ja": "node scripts/run-narration-pipeline.mjs operations/episode-enron-ja/narration.json",
    "narration:pilot-en": "node scripts/run-narration-pipeline.mjs operations/episode-enron-en/narration.json",
    "script:pilot-ja": "node scripts/generate-production-script.mjs renders/editorial/episode-enron-ja/blueprint.json --evidence operations/episode-enron-ja/evidence-pack.json --base-manifest operations/episode-enron-ja/narration.json --output operations/episode-enron-ja/narration.json --report renders/professional/episode-enron-ja/script-generation-report.json",
    "script:pilot-en": "node scripts/generate-production-script.mjs renders/editorial/episode-enron-en/blueprint.json --evidence operations/episode-enron-en/evidence-pack.json --base-manifest operations/episode-enron-en/narration.json --output operations/episode-enron-en/narration.json --report renders/professional/episode-enron-en/script-generation-report.json",
    "score:pilot-ja": "node scripts/generate-original-score.mjs renders/editorial/episode-enron-ja/blueprint.json --manifest operations/episode-enron-ja/sound-design.json --output renders/sound/episode-enron-ja",
    "score:pilot-en": "node scripts/generate-original-score.mjs renders/editorial/episode-enron-en/blueprint.json --manifest operations/episode-enron-en/sound-design.json --output renders/sound/episode-enron-en",
    "professional:pilot-ja": "node scripts/run-professional-master.mjs episode-enron-ja --preview-seconds 60 --workers 2",
    "professional:pilot-en": "node scripts/run-professional-master.mjs episode-enron-en --preview-seconds 60 --workers 2",
    "professional:master-ja": "node scripts/run-professional-master.mjs episode-enron-ja --workers 2",
    "professional:master-en": "node scripts/run-professional-master.mjs episode-enron-en --workers 2",
    "research:pilot-ja": "node scripts/run-research-ingest.mjs operations/episode-enron-ja/evidence-pack.json --output renders/research/episode-enron-ja",
    "research:pilot-en": "node scripts/run-research-ingest.mjs operations/episode-enron-en/evidence-pack.json --output renders/research/episode-enron-en",
    "visuals:pilot-ja": "node scripts/run-comfyui-assets.mjs operations/episode-enron-ja/visual-assets.json --output renders/visual-assets/episode-enron-ja",
    "visuals:pilot-en": "node scripts/run-comfyui-assets.mjs operations/episode-enron-en/visual-assets.json --output renders/visual-assets/episode-enron-en",
    "blueprint:pilot-ja": "node scripts/generate-editorial-blueprint.mjs operations/episode-enron-ja/editorial.json",
    "blueprint:pilot-en": "node scripts/generate-editorial-blueprint.mjs operations/episode-enron-en/editorial.json",
    "entertainment:pilot-ja": "node scripts/generate-entertainment-pilot.mjs episode-enron-ja --duration 90",
    "entertainment:pilot-en": "node scripts/generate-entertainment-pilot.mjs episode-enron-en --duration 90",
    "portfolio:variation-audit": "node scripts/portfolio-variation-audit.mjs",
    "hyperframes:compile:ja": "node scripts/compile-hyperframes-project.mjs renders/editorial/episode-enron-ja/blueprint.json --output renders/hyperframes-projects/episode-enron-ja-master",
    "hyperframes:compile:en": "node scripts/compile-hyperframes-project.mjs renders/editorial/episode-enron-en/blueprint.json --output renders/hyperframes-projects/episode-enron-en-master",
    "hyperframes:preview:ja": "node scripts/compile-hyperframes-project.mjs renders/editorial/episode-enron-ja/blueprint.json --output renders/hyperframes-projects/episode-enron-ja-preview --preview-seconds 60",
    "hyperframes:preview:en": "node scripts/compile-hyperframes-project.mjs renders/editorial/episode-enron-en/blueprint.json --output renders/hyperframes-projects/episode-enron-en-preview --preview-seconds 60",
    "hyperframes:render:professional-ja": "node scripts/render-hyperframes-safe.mjs renders/hyperframes-projects/episode-enron-ja-professional-preview --output renders/previews/episode-enron-ja-professional-preview.mp4 --workers 2",
    "hyperframes:master-audio:professional-ja": "node scripts/master-rendered-audio.mjs renders/previews/episode-enron-ja-professional-preview.mp4 --output renders/previews/episode-enron-ja-professional-preview.mastered.mp4",
    "hyperframes:inspect:professional-ja": "node scripts/inspect-rendered-master.mjs renders/previews/episode-enron-ja-professional-preview.mastered.mp4 --target-duration 30 --output renders/previews/episode-enron-ja-professional-preview.quality.json",
    "sound:mix:professional-ja": "node scripts/render-sound-designed-master.mjs renders/previews/episode-enron-ja-professional-preview.mp4 --manifest operations/episode-enron-ja/sound-design.json --output renders/previews/episode-enron-ja-professional-preview.sound-mastered.mp4",
    "worker:once": "node scripts/run-production-queue.mjs",
    "worker:start": "node scripts/run-production-queue.mjs --watch --poll-seconds 5",
    "ops:preflight": "node scripts/production-preflight.mjs",
    "video:check": "npm --prefix video/pilot-investigation run check",
    "video:render": "npm --prefix video/pilot-investigation run render",
    "video:vertical:check": "npm --prefix video/pilot-investigation-vertical run check",
    "video:vertical:render": "npm --prefix video/pilot-investigation-vertical run render"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hyperframes/producer": "^0.4.45",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "hyperframes": "^0.4.45",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

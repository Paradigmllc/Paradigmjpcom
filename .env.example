# ============================================================
# paradigmjp.com — Environment variables template
# 実値は Coolify の env 設定に保管 (このファイルは git tracked・実値書込禁止)
# Sales CRM is managed in Twenty; Supabase remains the application data store.
# ============================================================

# ─── Supabase (既存) ─────────────────────────────────────────
# yihdmgtxiqfdgdueolub プロジェクト共有 (PayloadCMS schema "payload" で分離)
NEXT_PUBLIC_SUPABASE_URL=https://yihdmgtxiqfdgdueolub.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sales OS SSOT override
# Hetzner/Supabase OSS移行後は営業OSだけこちらへ切替。未設定時は既存Supabaseを使用。
SALES_SUPABASE_URL=
SALES_SUPABASE_SERVICE_ROLE_KEY=
SALES_SUPABASE_REALTIME_URL=
# Set true in production when Sales OS should use the dedicated OSS Supabase.
SALES_SUPABASE_PRIMARY=false

# Host-side OSS Supabase backup (`scripts/backup-oss-supabase.sh`).
# Prefer a root-readable env file on the host; never commit the real password.
# Production release is blocked until encryption is enabled and an off-host SSH
# target is configured. See docs/ops/backup-restore.md.
OSS_SUPABASE_POSTGRES_PASSWORD=
OSS_SUPABASE_ENV_FILE=/opt/supabase/.env
OSS_SUPABASE_BACKUP_ROOT=/opt/backups/oss-supabase-nightly
OSS_SUPABASE_BACKUP_RETENTION_DAYS=14
OSS_SUPABASE_BACKUP_ENCRYPTION_REQUIRED=true
OSS_SUPABASE_BACKUP_GPG_PASSPHRASE=
OSS_SUPABASE_BACKUP_SSH_TARGET=
OSS_SUPABASE_BACKUP_SSH_ROOT=/backups/paradigmjpcom
# Alternative off-host transport. The backup script uploads the encrypted
# archive and checksum to R2 when SSH_TARGET is empty.
OSS_SUPABASE_BACKUP_R2_ROOT=paradigmjpcom/oss-supabase
OSS_SUPABASE_BACKUP_R2_UPLOAD_HELPER=/usr/local/lib/paradigmjpcom/r2-put.py
OSS_SUPABASE_PGHOST=127.0.0.1
OSS_SUPABASE_PGPORT=5433
OSS_SUPABASE_PGUSER=postgres
OSS_SUPABASE_PGDATABASE=postgres

# ─── PayloadCMS (既存) ───────────────────────────────────────
DATABASE_URI=
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=https://paradigmjp.com
# 2026-06-16: push:false + pool安全設定で本番Disk IO Budget保護
#   - statement_timeout=30000 (暴走クエリ遮断)
#   - lock_timeout=10000 (ロック待ち制限)
#   - idle_in_transaction_session_timeout=20000 (放置セッション切断)
#   - pool max=2 (無料枠接続数抑制)
#   - transaction mode pooler (port 6543) 推奨

# ─── Site (既存) ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://paradigmjp.com
NEXT_PUBLIC_DEMO_SITE_URL=https://demo.paradigmjp.com
NEXT_PUBLIC_COMPANY_NAME=Paradigm合同会社
ADMIN_PASSWORD=
ADMIN_SCRIPT_SECRET=
ADMIN_EMAIL=  # PayloadCMS onInit auto-seed 用 (PAYLOAD_ADMIN_EMAIL も可)
PAYLOAD_ADMIN_EMAIL=  # ADMIN_EMAIL の別名

# ─── i18n / DeepSeek 翻訳 (P17) ──────────────────────────────
DEEPSEEK_API_KEY=

# ─── screenshot-to-code private gateway ─────────────────────

# ============================================================
# paradigmjp.com — Environment variables template
# 実値は Coolify の env 設定に保管 (このファイルは git tracked・実値書込禁止)
# Sprint 8 (2026-05-13) 新規・Notion × Supabase ハブ整備
# ============================================================

# ─── Supabase (既存) ─────────────────────────────────────────
# yihdmgtxiqfdgdueolub プロジェクト共有 (PayloadCMS schema "payload" で分離)
NEXT_PUBLIC_SUPABASE_URL=https://yihdmgtxiqfdgdueolub.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sales OS SSOT override
# Hetzner/Supabase OSS移行後は営業OSだけこちらへ切替。未設定時は既存Supabaseを使用。
SALES_SUPABASE_URL=
SALES_SUPABASE_SERVICE_ROLE_KEY=

# ─── PayloadCMS (既存) ───────────────────────────────────────
DATABASE_URI=
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=https://paradigmjp.com

# ─── Site (既存) ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://paradigmjp.com
NEXT_PUBLIC_COMPANY_NAME=Paradigm合同会社
ADMIN_PASSWORD=

# ─── i18n / DeepSeek 翻訳 (P17) ──────────────────────────────
DEEPSEEK_API_KEY=

# ─── Notion ハブ (Sprint 8 NEW) ──────────────────────────────
# https://www.notion.so/my-integrations から integration を作成し、
# 4 つの DB に invite してから ID をここに記載
NOTION_API_KEY=
NOTION_DB_COMPANIES_ID=
NOTION_DB_CUSTOMERS_ID=
NOTION_DB_DELIVERIES_ID=
NOTION_DB_TEMPLATES_ID=

# ─── Notion 即時 Webhook (2026-05-21 NEW・Notion編集→即Supabase反映) ──
# integration の Webhooks タブで subscription 作成 → URL = /api/sales/notion-webhook
# 登録時に Notion が verification_token を 1 度だけ POST する (サーバーログに出力)
# → その値をここに保存 + Notion UI に貼り戻して subscription を verify する。
# 以後の全 Webhook の X-Notion-Signature 検証鍵になる (未設定なら全 reject = fail-closed)。
NOTION_WEBHOOK_SECRET=
# (任意) integration の bot user id。未設定なら起動時に /users/me で自動取得しエコー防止に使う。
NOTION_BOT_ID=
# Supabase Database Webhook (S→N 即時同期) の共有秘密。
# Supabase Dashboard → Database → Webhooks で sales_companies/customers/deliveries に
# POST /api/sales/supabase-webhook を設定し、header x-webhook-secret にこの値を入れる。
# 未設定なら supabase-webhook は全 reject (fail-closed)。
SUPABASE_WEBHOOK_SECRET=

# (任意) region 別 DB id override。未設定なら notion-apply.ts の既知 id を使用。
NOTION_DB_COMPANIES_JP=
NOTION_DB_COMPANIES_GLOBAL=
NOTION_DB_CUSTOMERS_JP=
NOTION_DB_CUSTOMERS_GLOBAL=
NOTION_DB_DELIVERIES_JP=
NOTION_DB_DELIVERIES_GLOBAL=
NOTION_DB_TEMPLATES_JP=
NOTION_DB_TEMPLATES_GLOBAL=

# ─── Slack 通知 (Sprint 7 fail-soft 化) ──────────────────────
# Slack Incoming Webhook URL (未設定なら no-op)
SLACK_WEBHOOK_URL=

# ─── n8n (Sprint 8 NEW) ──────────────────────────────────────
# Coolify セルフホスト n8n の base URL
N8N_BASE_URL=
N8N_API_KEY=
# n8n から paradigmjp.com 内 API を call する時の base URL
PARADIGMJP_BASE_URL=https://paradigmjp.com

# ─── Sales command center OSS surfaces ───────────────────────
# Supabaseのみクラウド版。以下はCoolify等でセルフホストしたOSS版のURL。
NOCODB_BASE_URL=
APPSMITH_BASE_URL=
TWENTY_BASE_URL=
TWENTY_API_KEY=
METABASE_BASE_URL=
CALCOM_BASE_URL=
DOCUSEAL_BASE_URL=

# ─── Stripe + Wise (Sprint 8 NEW・Q6 で env 化) ──────────────
# Stripe 受取 (USD で固定し Wise へ ACH 送金)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Wise Business USD バーチャル口座 (Stripe Payout 先)
WISE_API_KEY=
WISE_USD_ACCT_HOLDER=
WISE_USD_ACCT_ROUTING=
WISE_USD_ACCT_NUMBER=

# ─── Dify Cloud (DIFY-CLOUD-ONLY 永久ルール) ─────────────────
DIFY_API_KEY=
DIFY_API_KEY_JA=
DIFY_API_KEY_EN=
DIFY_BASE_URL=https://api.dify.ai
DIFY_DIAGNOSIS_API_KEY=
DIFY_DIAGNOSIS_BASE_URL=https://api.dify.ai
DIFY_DIAGNOSIS_API_URL=

# Sales enrichment orchestration
# If unset, the app calls PARADIGMJP_BASE_URL/api/sales/enrichment/run with N8N_WEBHOOK_SECRET.
TRIGGER_DEV_SALES_ENRICHMENT_WEBHOOK_URL=
N8N_SALES_ENRICHMENT_WEBHOOK_URL=

# Sales OS OSS URLs
NOCODB_BASE_URL=https://nocodb.paradigmjp.com
APPSMITH_BASE_URL=https://appsmith.paradigmjp.com
TWENTY_BASE_URL=https://twenty.paradigmjp.com
TWENTY_API_KEY=
METABASE_BASE_URL=https://metabase.paradigmjp.com
CALCOM_BASE_URL=https://cal.paradigmjp.com
DOCUSEAL_BASE_URL=https://docuseal.paradigmjp.com
NOTION_LEGACY_SYNC_ENABLED=false
N8N_BASE_URL=https://n8n.paradigmjp.com
CRAWL4AI_BASE_URL=https://crawl4.paradigmjp.com
BROWSERLESS_URL=
OUTREACH_WORKER_URL=
OUTREACH_WORKER_SECRET=
CAMOUFOX_WS_URL=

# Cal.com / Docuseal webhooks call the app through n8n-compatible shared auth.
# Set header: X-Webhook-Secret: $N8N_WEBHOOK_SECRET
CALCOM_WEBHOOK_URL=https://paradigmjp.com/api/sales/calcom/webhook
DOCUSEAL_WEBHOOK_URL=https://paradigmjp.com/api/sales/docuseal/webhook

# Paradigm AI Bot / Telegram -> Hermes/Paperclip Sales OS bridge
PARADIGM_AI_BOT_USERNAME=@aiparadigmbot
PARADIGM_AI_AGENT_WEBHOOK_URL=https://paradigmjp.com/api/sales/agent/telegram-command

# Sales OS source APIs
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
WHATWEB_API_URL=
URLSCAN_API_KEY=
PUBLICWWW_API_KEY=
MOZILLA_OBSERVATORY_API_URL=https://http-observatory.security.mozilla.org/api/v1
SECURITYTRAILS_API_KEY=
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
HOUJIN_BANGOU_API_ID=
JGRANTS_API_KEY=
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=
APOLLO_API_KEY=
OPENMONTAGE_API_URL=
COMFYUI_API_URL=
REMOTION_RENDER_URL=

# ─── Gemini (chat fallback) ──────────────────────────────────
GEMINI_API_KEY=

# ─── Umami Analytics (Settings global で 12-locale array 推奨) ─
NEXT_PUBLIC_UMAMI_HOST=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── Cloudflare Turnstile (フォーム CAPTCHA) ─────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Error monitor (Sprint 7 環境変数化) ─────────────────────
ERROR_MONITOR_DISABLED=
SENTRY_DSN=

# ─── Hero video (P18-D-7) ────────────────────────────────────
NEXT_PUBLIC_HERO_VIDEO_URL=

# ─── Supabase Management API ──────────────────────────────────
# Supabase Dashboard → Settings → Access Token で PAT 発行
# プロジェクト状態確認・復旧 (scripts/supabase-health-check.mjs) で使用
SUPABASE_PAT=

# ─── Coolify API ──────────────────────────────────────────────
# deploy.mjs / supabase-health-check.mjs で使用
COOLIFY_API_TOKEN=

# ─── Coolify Application ─────────────────────────────────────
PARADIGM_APP_UUID=i12am4vvcbggefnqdizhnv9a

# ============================================================
# paradigmjp.com — Environment variables template
# 実値は Coolify の env 設定に保管 (このファイルは git tracked・実値書込禁止)
# Sprint 8 (2026-05-13) 新規・Notion × Supabase ハブ整備
# ============================================================

# ─── Supabase (既存) ─────────────────────────────────────────
# yihdmgtxiqfdgdueolub プロジェクト共有 (PayloadCMS schema "payload" で分離)
NEXT_PUBLIC_SUPABASE_URL=https://yihdmgtxiqfdgdueolub.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sales OS SSOT override
# Hetzner/Supabase OSS移行後は営業OSだけこちらへ切替。未設定時は既存Supabaseを使用。
SALES_SUPABASE_URL=
SALES_SUPABASE_SERVICE_ROLE_KEY=

# ─── PayloadCMS (既存) ───────────────────────────────────────
DATABASE_URI=
PAYLOAD_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=https://paradigmjp.com

# ─── Site (既存) ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://paradigmjp.com
NEXT_PUBLIC_COMPANY_NAME=Paradigm合同会社
ADMIN_PASSWORD=

# ─── i18n / DeepSeek 翻訳 (P17) ──────────────────────────────
DEEPSEEK_API_KEY=

# ─── Notion ハブ (Sprint 8 NEW) ──────────────────────────────
# https://www.notion.so/my-integrations から integration を作成し、
# 4 つの DB に invite してから ID をここに記載
NOTION_API_KEY=
NOTION_DB_COMPANIES_ID=
NOTION_DB_CUSTOMERS_ID=
NOTION_DB_DELIVERIES_ID=
NOTION_DB_TEMPLATES_ID=

# ─── Notion 即時 Webhook (2026-05-21 NEW・Notion編集→即Supabase反映) ──
# integration の Webhooks タブで subscription 作成 → URL = /api/sales/notion-webhook
# 登録時に Notion が verification_token を 1 度だけ POST する (サーバーログに出力)
# → その値をここに保存 + Notion UI に貼り戻して subscription を verify する。
# 以後の全 Webhook の X-Notion-Signature 検証鍵になる (未設定なら全 reject = fail-closed)。
NOTION_WEBHOOK_SECRET=
# (任意) integration の bot user id。未設定なら起動時に /users/me で自動取得しエコー防止に使う。
NOTION_BOT_ID=
# Supabase Database Webhook (S→N 即時同期) の共有秘密。
# Supabase Dashboard → Database → Webhooks で sales_companies/customers/deliveries に
# POST /api/sales/supabase-webhook を設定し、header x-webhook-secret にこの値を入れる。
# 未設定なら supabase-webhook は全 reject (fail-closed)。
SUPABASE_WEBHOOK_SECRET=

# (任意) region 別 DB id override。未設定なら notion-apply.ts の既知 id を使用。
NOTION_DB_COMPANIES_JP=
NOTION_DB_COMPANIES_GLOBAL=
NOTION_DB_CUSTOMERS_JP=
NOTION_DB_CUSTOMERS_GLOBAL=
NOTION_DB_DELIVERIES_JP=
NOTION_DB_DELIVERIES_GLOBAL=
NOTION_DB_TEMPLATES_JP=
NOTION_DB_TEMPLATES_GLOBAL=

# ─── Slack 通知 (Sprint 7 fail-soft 化) ──────────────────────
# Slack Incoming Webhook URL (未設定なら no-op)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
HERMES_AGENT_WEBHOOK_URL=


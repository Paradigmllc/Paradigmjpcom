# Standalone Sales Pipeline container.
# 実値は Coolify / local .env にのみ保存し、git には書かない。

PORT=8090
SALES_PIPELINE_CONTAINER_SECRET=

# Inside Coolify / docker compose, this can point to internal PostgREST.
SALES_SUPABASE_URL=http://supabase-rest-1:3000
SALES_SUPABASE_SERVICE_ROLE_KEY=

# Optional UI link targets.
PARADIGMJP_PUBLIC_BASE=https://paradigmjp.com
TWENTY_BASE_URL=https://twenty.paradigmjp.com

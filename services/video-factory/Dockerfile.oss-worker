FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VIDEO_FACTORY_ROOT=/app \
    VIDEO_FACTORY_ENGINE_PROFILE_CATALOG=/app/config/engine-profiles.yaml \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      ffmpeg \
      python3 \
      python3-pip \
      python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv "$VIRTUAL_ENV" \
    && pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir '.[api]'
COPY config/engine-profiles.yaml ./config/engine-profiles.yaml

RUN useradd --create-home --uid 10002 ossworker \
    && mkdir -p /opt/workers /opt/models \
    && chown -R ossworker:ossworker /app /opt/workers /opt/models

USER ossworker
EXPOSE 8090
CMD ["uvicorn", "video_factory.engine_worker_api:app", "--host", "0.0.0.0", "--port", "8090", "--workers", "1", "--no-access-log"]

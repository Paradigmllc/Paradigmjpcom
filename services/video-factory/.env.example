# Paradigm Video Factory — copy to .env and keep real values out of Git.

VIDEO_FACTORY_ENVIRONMENT=local
VIDEO_FACTORY_API_KEY=
VIDEO_FACTORY_WORKSPACE=/data/video-factory
VIDEO_FACTORY_LOG_LEVEL=INFO
VIDEO_FACTORY_EXTERNAL_TIMEOUT_SECONDS=1800
# auto = Prefect when PREFECT_API_URL exists, otherwise the persistent local queue.
VIDEO_FACTORY_QUEUE_BACKEND=auto
VIDEO_FACTORY_LOCAL_QUEUE_WORKERS=1

# Optional external Codex/LLM planner command. It must accept
# --brief, --schema, and --output and write a schema-valid shot manifest.
VIDEO_FACTORY_PLANNER_COMMAND=

# Deterministic compositor and agent skills.
HYPERFRAMES_VERSION=0.7.77
HYPERFRAMES_NPX=npx
HYPERFRAMES_RENDER_QUALITY=draft
VIDEO_FACTORY_MASTER_COMPOSITOR=hyperframes
VIDEO_FACTORY_ALLOW_FFMPEG_COMPOSITOR_FALLBACK=false

# Browser console GPU management. VAST_API_KEY, the default template hash, and
# ComfyUI credentials can also be entered after login in /console/. The runtime
# file is stored in the persistent workspace with mode 0600 and is never echoed.
VAST_API_KEY=
VAST_API_BASE_URL=https://console.vast.ai/api
VAST_DEFAULT_TEMPLATE_HASH=
VAST_MAX_HOURLY_PRICE=1.00
VAST_API_TIMEOUT_SECONDS=30

# ComfyUI remains fail-closed until endpoint, auth, GPU, exact models, and
# approved API-format workflow bindings are all present.
# Recommended production topology:
#   GPU ComfyUI -> private network -> authenticated proxy -> Video Factory
COMFYUI_UPSTREAM_URL=
COMFYUI_PROXY_API_KEY=
COMFYUI_PROXY_TIMEOUT_SECONDS=1800
COMFYUI_PROXY_MAX_BODY_BYTES=10485760
COMFYUI_API_URL=http://comfyui-auth-proxy:8189
COMFYUI_API_KEY=
COMFYUI_PROFILE=production-gpu-01
COMFYUI_TIMEOUT_SECONDS=1800
COMFYUI_POLL_SECONDS=3
COMFYUI_MIN_VRAM_GB=24
COMFYUI_WORKFLOW_ROOT=/app/workflows/comfyui
COMFYUI_WORKFLOW_REGISTRY=/app/workflows/comfyui/registry.yaml
COMFYUI_REQUIRED_WORKFLOWS=brand-background,product-hero-still,social-thumbnail,abstract-broll-t2v,product-broll-i2v,video-upscale,frame-interpolation,background-remove-replace
COMFYUI_ALLOW_UNREGISTERED_WORKFLOWS=false
VIDEO_FACTORY_MODEL_REGISTRY=/app/config/model-registry.yaml
VIDEO_FACTORY_PRODUCTION_REGION=JP

# ComfyUI MCP is discovery/admin-only. Production execution is performed by
# the authenticated Video Factory adapter, not by an unauthenticated MCP call.
COMFYUI_MCP_VERSION=0.2.2
COMFYUI_MCP_TRUST_REMOTE=false
COMFYUI_MCP_OUTPUT_MODE=file

# Exact browser capture allow-list. Leave empty only for local dry-runs.
PLAYWRIGHT_NODE=node
PLAYWRIGHT_CAPTURE_SCRIPT=/app/tools/playwright-capture/capture.mjs
PLAYWRIGHT_ALLOWED_HOSTS=paradigmjp.com,www.paradigmjp.com
PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# Optional specialist workers. Each command receives a request JSON path and
# must return a schema-valid EngineOutput JSON path.
BLENDER_ADAPTER_COMMAND=
MANIM_ADAPTER_COMMAND=
LIVEPORTRAIT_ADAPTER_COMMAND=
MUSETALK_ADAPTER_COMMAND=

# Orchestration. Docker Compose overrides PREFECT_API_URL for the full stack;
# standalone browser deployments leave it empty and use the local queue.
PREFECT_API_URL=
PREFECT_DEPLOYMENT_NAME=paradigm-video-production/production-flow
POSTGRES_USER=prefect
POSTGRES_PASSWORD=
POSTGRES_DB=prefect

# Delivery. Local delivery works without external credentials.
RCLONE_REMOTE=
RCLONE_BASE_PATH=Paradigm/Video Production Subscription/01_Active Clients
FRAMEIO_ACCESS_TOKEN=
FRAMEIO_CREATE_FILE_URL=
FRAMEIO_API_BASE_URL=https://api.frame.io
FRAMEIO_TIMEOUT_SECONDS=900

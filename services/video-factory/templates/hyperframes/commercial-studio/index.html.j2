<!doctype html>
<html lang="{{ language }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ project_name }} — {{ template_name }}</title>
  <style>
    :root {
      --bg: {{ brand.primary_color }};
      --accent: {{ brand.accent_color }};
      --secondary: {{ brand.secondary_color }};
      --text: {{ brand.text_color }};
      --font: {{ brand.font_family | tojson }};
      --safe: {{ brand.safe_margin_percent }}%;
      --duration: {{ duration_seconds }}s;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: var(--bg); }
    body { color: var(--text); font-family: var(--font), "EB Garamond", sans-serif; }
    #stage { position: relative; width: {{ width }}px; height: {{ height }}px; overflow: hidden; isolation: isolate; background: var(--bg); }
    .scene { position: absolute; inset: 0; overflow: hidden; padding: var(--safe); }
    .texture { position: absolute; inset: 0; opacity: .2; background-image: linear-gradient(color-mix(in srgb, var(--text) 12%, transparent) 2px, transparent 2px), linear-gradient(90deg, color-mix(in srgb, var(--text) 12%, transparent) 2px, transparent 2px); background-size: 72px 72px; animation: texture-drift var(--duration) linear both; }
    .glow { position: absolute; width: 58%; aspect-ratio: 1; right: -14%; top: -28%; border-radius: 50%; background: var(--accent); filter: blur(80px); opacity: .26; animation: glow-breathe var(--duration) ease-in-out both; }
    .orb { position: absolute; width: 17%; aspect-ratio: 1; left: -5%; bottom: 5%; border: 4px solid var(--accent); border-radius: 50%; opacity: .62; animation: orbit var(--duration) ease-in-out both; }
    .frame { position: absolute; inset: calc(var(--safe) * .56); border: 3px solid color-mix(in srgb, var(--text) 35%, transparent); border-radius: 36px; animation: frame-in .7s .12s cubic-bezier(.16,1,.3,1) both; }
    .topline { position: absolute; top: var(--safe); left: var(--safe); right: var(--safe); display: flex; justify-content: space-between; align-items: center; gap: 24px; font: 700 clamp(12px,1.45vw,30px)/1 ui-monospace, monospace; letter-spacing: .16em; text-transform: uppercase; }
    .topline span:first-child { color: var(--text); animation: enter-left .48s .2s cubic-bezier(.16,1,.3,1) both; }
    .topline span:last-child { opacity: .66; animation: enter-right .72s .28s cubic-bezier(.22,1,.36,1) both; }
    .rule { position: absolute; left: var(--safe); right: var(--safe); bottom: var(--safe); height: 8px; overflow: hidden; border-radius: 999px; background: color-mix(in srgb, var(--text) 18%, transparent); }
    .rule::after { content: ""; display: block; width: 100%; height: 100%; background: var(--accent); transform-origin: left; animation: rule-fill var(--duration) linear both; }
    h1 { margin: 0; font-size: clamp(28px,7vw,144px); line-height: .9; letter-spacing: -.055em; text-wrap: balance; }
    h1.headline-long { font-size: clamp(24px,5.4vw,112px); line-height: .98; }
    p { margin: 0; font-size: clamp(14px,2.3vw,48px); line-height: 1.28; text-wrap: balance; }
    .micro { font: 700 clamp(11px,1.15vw,24px)/1.2 ui-monospace, monospace; letter-spacing: .13em; text-transform: uppercase; }

    .kinetic-type .copy { position: absolute; left: var(--safe); right: 8%; top: 24%; bottom: 17%; z-index: 2; display: flex; flex-direction: column; justify-content: center; }
    .kinetic-type h1 { max-width: 92%; animation: kinetic-slam .62s .25s cubic-bezier(.12,.8,.2,1.22) both, resolve-out .28s calc(var(--duration) - .32s) ease-in both; }
    .kinetic-type p { width: min(72%, 1100px); margin-top: clamp(12px,2vw,38px); padding-left: 26%; animation: enter-right .78s .54s cubic-bezier(.16,1,.3,1) both; }
    .kinetic-type .ghost { position: absolute; right: -2%; bottom: 6%; z-index: 1; font-size: clamp(72px,20vw,420px); font-weight: 900; line-height: .7; color: color-mix(in srgb, var(--accent) 30%, transparent); -webkit-text-fill-color: color-mix(in srgb, var(--accent) 30%, transparent); -webkit-text-stroke: 4px color-mix(in srgb, var(--accent) 70%, transparent); opacity: .34; transform: rotate(-8deg); animation: ghost-pan var(--duration) ease-in-out both; }

    .product-spotlight .split { position: absolute; inset: 17% var(--safe) 15%; display: grid; grid-template-columns: 1.18fr .82fr; gap: 5%; align-items: stretch; }
    .product-spotlight .copy { display: flex; flex-direction: column; justify-content: center; }
    .product-spotlight h1 { animation: enter-left .74s .24s cubic-bezier(.16,1,.3,1) both; }
    .product-spotlight p { max-width: 850px; margin-top: 34px; opacity: .82; animation: rise-in .84s .48s cubic-bezier(.22,1,.36,1) both; }
    .product-spotlight .product-card { position: relative; border: 4px solid color-mix(in srgb, var(--text) 48%, transparent); border-radius: 42px; background: linear-gradient(145deg, color-mix(in srgb, var(--accent) 32%, var(--secondary)), var(--secondary)); box-shadow: 0 46px 110px color-mix(in srgb, black 38%, transparent); display: grid; place-items: center; overflow: hidden; animation: card-turn .9s .2s cubic-bezier(.16,1,.3,1) both; }
    .product-spotlight .product-card::before { content: ""; position: absolute; width: 82%; aspect-ratio: 1; border: 28px solid color-mix(in srgb, var(--accent) 70%, transparent); border-radius: 50%; animation: product-orbit var(--duration) linear both; }
    .product-spotlight .brand-letter { position: relative; font-size: clamp(130px,17vw,340px); font-weight: 900; letter-spacing: -.08em; }

    .ui-focus .workspace { position: absolute; inset: 18% var(--safe) 14%; display: grid; grid-template-columns: .62fr 1.38fr; gap: 4%; align-items: center; }
    .ui-focus h1 { font-size: clamp(26px,6.4vw,132px); animation: enter-left .64s .18s cubic-bezier(.16,1,.3,1) both; }
    .ui-focus p { margin-top: 30px; opacity: .78; animation: rise-in .78s .43s cubic-bezier(.22,1,.36,1) both; }
    .device { border: 5px solid color-mix(in srgb, var(--text) 56%, transparent); border-radius: 36px; padding: 24px; background: #07111f; box-shadow: 0 50px 120px rgba(0,0,0,.45); transform-origin: center; animation: device-in .95s .24s cubic-bezier(.16,1,.3,1) both; }
    .device-bar { display: flex; gap: 12px; margin-bottom: 22px; }
    .device-bar i { width: 18px; height: 18px; border-radius: 50%; background: var(--accent); opacity: .5; }
    .device-screen { min-height: clamp(180px,31vw,440px); display: grid; grid-template-columns: .38fr .62fr; gap: 18px; }
    .device-panel, .device-chart { border-radius: 22px; background: color-mix(in srgb, var(--accent) 18%, #111827); border: 2px solid color-mix(in srgb, var(--text) 18%, transparent); }
    .device-panel { background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 42%, #111827), #111827); }
    .device-chart { position: relative; overflow: hidden; }
    .device-chart::after { content: ""; position: absolute; inset: 18% 10%; border-left: 8px solid var(--accent); border-bottom: 8px solid var(--accent); transform: skewY(-22deg); animation: chart-grow 1.1s .72s cubic-bezier(.16,1,.3,1) both; }

    .data-proof .proof-grid { position: absolute; inset: 19% var(--safe) 17%; z-index: 2; display: grid; grid-template-columns: .5fr 1.5fr; gap: 4%; align-items: center; }
    .data-proof .stat { font-size: clamp(72px,14vw,270px); line-height: .78; font-weight: 900; letter-spacing: -.08em; color: var(--accent); font-variant-numeric: tabular-nums; animation: stat-in .68s .22s cubic-bezier(.12,.8,.2,1.18) both; }
    .data-proof .copy { border-left: clamp(3px,.35vw,6px) solid var(--accent); padding-left: 7%; }
    .data-proof h1 { font-size: clamp(24px,5.4vw,112px); animation: enter-right .72s .34s cubic-bezier(.16,1,.3,1) both; }
    .data-proof h1.headline-long { font-size: clamp(22px,4.6vw,96px); line-height: .96; }
    .data-proof p { margin-top: clamp(10px,1.6vw,30px); font-size: clamp(11px,1.6vw,32px); opacity: .82; animation: rise-in .84s .58s cubic-bezier(.22,1,.36,1) both; }
    .bars { position: absolute; left: var(--safe); width: 25%; bottom: 16%; z-index: 1; display: grid; grid-template-columns: repeat(4,1fr); gap: clamp(4px,.8vw,16px); height: clamp(28px,4.8vw,92px); align-items: end; opacity: .24; }
    .bars i { display: block; background: var(--accent); transform-origin: bottom; animation: bar-in .66s cubic-bezier(.16,1,.3,1) both; }
    .bars i:nth-child(1) { height: 32%; animation-delay: .42s; } .bars i:nth-child(2) { height: 58%; animation-delay: .5s; } .bars i:nth-child(3) { height: 76%; animation-delay: .58s; } .bars i:nth-child(4) { height: 100%; animation-delay: .66s; }

    .social-cta .cta-wrap { position: absolute; inset: 19% 10% 15%; display: grid; place-items: center; text-align: center; }
    .social-cta h1 { max-width: 1500px; animation: cta-in .8s .2s cubic-bezier(.16,1,.3,1) both; }
    .social-cta p { max-width: 980px; margin: 34px auto 0; opacity: .82; animation: rise-in .7s .5s cubic-bezier(.22,1,.36,1) both; }
    .cta-button { display: inline-flex; margin-top: 48px; padding: 24px 46px; border-radius: 999px; background: var(--accent); color: var(--secondary); font-size: clamp(22px,2vw,40px); font-weight: 900; box-shadow: 0 22px 70px color-mix(in srgb, var(--accent) 42%, transparent); animation: button-pop .5s .76s cubic-bezier(.12,.8,.2,1.24) both, button-breathe 2.4s 1.3s ease-in-out infinite; }
    .social-cta .ring { position: absolute; width: 72%; aspect-ratio: 1; border-radius: 50%; border: 5px solid color-mix(in srgb, var(--accent) 50%, transparent); animation: ring-pulse var(--duration) ease-out both; }

    @keyframes texture-drift { from { background-position: 0 0; } to { background-position: 144px 72px; } }
    @keyframes glow-breathe { 0%,100% { transform: scale(.82) translate(3%,-3%); opacity: .18; } 48% { transform: scale(1.18); opacity: .34; } }
    @keyframes orbit { from { transform: translate(-8%,12%); } to { transform: translate(46%,-32%); } }
    @keyframes frame-in { from { opacity: 0; transform: scale(.985); } to { opacity: 1; transform: scale(1); } }
    @keyframes enter-left { from { opacity: 0; transform: translateX(-90px); } to { opacity: 1; transform: none; } }
    @keyframes enter-right { from { opacity: 0; transform: translateX(100px); } to { opacity: 1; transform: none; } }
    @keyframes rise-in { from { opacity: 0; transform: translateY(56px); } to { opacity: 1; transform: none; } }
    @keyframes kinetic-slam { from { opacity: 0; transform: translateY(-80px) skewY(-5deg); letter-spacing: .04em; } to { opacity: 1; transform: none; letter-spacing: -.055em; } }
    @keyframes ghost-pan { from { transform: translateX(8%) rotate(-8deg); } to { transform: translateX(-7%) rotate(-2deg); } }
    @keyframes card-turn { from { opacity: 0; transform: perspective(1200px) rotateY(18deg) translateX(80px) scale(.92); } to { opacity: 1; transform: perspective(1200px) rotateY(-5deg) translateX(0) scale(1); } }
    @keyframes product-orbit { from { transform: rotate(0) scale(.86); } to { transform: rotate(160deg) scale(1.08); } }
    @keyframes device-in { from { opacity: 0; transform: perspective(1300px) rotateY(-14deg) translateX(100px) scale(.94); } to { opacity: 1; transform: perspective(1300px) rotateY(-4deg) translateX(0) scale(1); } }
    @keyframes chart-grow { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0); } }
    @keyframes stat-in { from { opacity: 0; transform: scale(.72) rotate(-4deg); } to { opacity: 1; transform: none; } }
    @keyframes bar-in { from { transform: scaleY(0); } to { transform: scaleY(1); } }
    @keyframes cta-in { from { opacity: 0; transform: scale(.8); letter-spacing: .02em; } to { opacity: 1; transform: scale(1); letter-spacing: -.055em; } }
    @keyframes button-pop { from { opacity: 0; transform: scale(.65); } to { opacity: 1; transform: scale(1); } }
    @keyframes button-breathe { 0%,100% { transform: scale(1); } 50% { transform: scale(1.045); } }
    @keyframes ring-pulse { from { transform: scale(.45); opacity: .72; } to { transform: scale(1.22); opacity: 0; } }
    @keyframes rule-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    @keyframes resolve-out { to { opacity: .86; transform: translateY(-8px); } }
  </style>
</head>
<body>
  <div id="stage" data-composition-id="{{ composition_id }}" data-no-timeline data-start="0" data-duration="{{ duration_seconds }}" data-width="{{ width }}" data-height="{{ height }}" data-fps="{{ fps }}">
    <section id="scene-root" class="scene clip {{ template_id }} motion-{{ brand.motion_preset }}" data-start="0" data-duration="{{ duration_seconds }}" data-track-index="0">
      <div class="texture"></div><div class="glow"></div><div class="orb"></div><div class="frame"></div>
      <div class="topline"><span>{{ eyebrow }}</span><span>{{ project_name }} / {{ shot_kind }}</span></div>
      {% if template_id == "kinetic-type" %}
      <div class="copy"><h1{% if headline | length > 55 %} class="headline-long"{% endif %}>{{ headline }}</h1><p>{{ body }}</p></div><div class="ghost" data-layout-allow-occlusion data-layout-allow-overflow>{{ eyebrow[:2] }}</div>
      {% elif template_id == "product-spotlight" %}
      <div class="split"><div class="copy"><h1{% if headline | length > 55 %} class="headline-long"{% endif %}>{{ headline }}</h1><p>{{ body }}</p></div><div class="product-card"><div class="brand-letter">{{ project_name[:1] }}</div></div></div>
      {% elif template_id == "ui-focus" %}
      <div class="workspace"><div class="copy"><h1{% if headline | length > 55 %} class="headline-long"{% endif %}>{{ headline }}</h1><p>{{ body }}</p></div><div class="device"><div class="device-bar"><i></i><i></i><i></i></div><div class="device-screen"><div class="device-panel"></div><div class="device-chart"></div></div></div></div>
      {% elif template_id == "data-proof" %}
      <div class="proof-grid"><div class="stat">{{ '%02d' | format(composition_id[-3:] | int) }}</div><div class="copy"><h1{% if headline | length > 55 %} class="headline-long"{% endif %}>{{ headline }}</h1><p>{{ body }}</p></div></div><div class="bars"><i></i><i></i><i></i><i></i></div>
      {% else %}
      <div class="cta-wrap"><div class="ring"></div><div><h1{% if headline | length > 55 %} class="headline-long"{% endif %}>{{ headline }}</h1><p>{{ body }}</p><div class="cta-button">{{ eyebrow }} →</div></div></div>
      {% endif %}
      <div class="rule"></div>
    </section>
  </div>
</body>
</html>

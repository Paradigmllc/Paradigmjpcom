<!doctype html>
<html lang="{{ language }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ project_name }} — {{ language }}</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: {{ brand.primary_color }}; }
    #stage { position: relative; width: {{ width }}px; height: {{ height }}px; background: {{ brand.primary_color }}; }
    video.clip { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; background: {{ brand.primary_color }}; }
  </style>
</head>
<body>
  <div
    id="stage"
    data-composition-id="master-{{ language }}"
    data-start="0"
    data-duration="{{ total_duration }}"
    data-width="{{ width }}"
    data-height="{{ height }}"
    data-fps="{{ fps }}"
  >
    {% for clip in clips %}
    <video
      id="scene-{{ '%03d' | format(loop.index) }}"
      class="clip"
      data-start="{{ clip.start }}"
      data-duration="{{ clip.duration }}"
      data-track-index="0"
      src="assets/{{ clip.filename }}"
      playsinline
      preload="auto"
    ></video>
    {% endfor %}
  </div>
</body>
</html>

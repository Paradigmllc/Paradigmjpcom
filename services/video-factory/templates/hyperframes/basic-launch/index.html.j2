<!doctype html>
<html lang="{{ language }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ project_name }}</title>
  <style>
    :root {
      --bg: {{ brand.primary_color }};
      --accent: {{ brand.accent_color }};
      --text: {{ brand.text_color }};
      --font: {{ brand.font_family | tojson }};
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; background: var(--bg); }
    body { font-family: var(--font), sans-serif; color: var(--text); }
    #stage { position: relative; width: {{ width }}px; height: {{ height }}px; background: var(--bg); }
    .scene { position: absolute; inset: 0; display: grid; place-items: center; padding: 8%; }
    .card { width: min(84%, 1400px); border: 1px solid color-mix(in srgb, var(--text) 24%, transparent); border-radius: 32px; padding: 5%; background: color-mix(in srgb, var(--bg) 82%, black); }
    .eyebrow { color: var(--accent); letter-spacing: .16em; text-transform: uppercase; font-size: clamp(24px, 2vw, 42px); font-weight: 700; }
    h1 { margin: .4em 0 0; font-size: clamp(58px, 7vw, 144px); line-height: .95; letter-spacing: -.04em; }
    p { margin: 1em 0 0; font-size: clamp(26px, 2.2vw, 46px); line-height: 1.25; opacity: .86; }
    .progress { position: absolute; left: 6%; right: 6%; bottom: 5%; height: 8px; border-radius: 99px; background: color-mix(in srgb, var(--text) 14%, transparent); overflow: hidden; }
    .progress > span { display: block; height: 100%; width: 100%; background: var(--accent); transform-origin: left; }
  </style>
</head>
<body>
  <div id="stage" data-composition-id="{{ composition_id }}" data-start="0" data-duration="{{ duration_seconds }}" data-width="{{ width }}" data-height="{{ height }}" data-fps="{{ fps }}">
    <section class="scene clip" data-start="0" data-duration="{{ duration_seconds }}" data-track-index="0">
      <div class="card">
        <div class="eyebrow">{{ eyebrow }}</div>
        <h1>{{ headline }}</h1>
        <p>{{ body }}</p>
      </div>
      <div class="progress"><span></span></div>
    </section>
  </div>
</body>
</html>

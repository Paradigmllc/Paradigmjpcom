{
  "$defs": {
    "Approver": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
          "title": "Email",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "email"
      ],
      "title": "Approver",
      "type": "object"
    },
    "BrandSpec": {
      "additionalProperties": false,
      "properties": {
        "accent_color": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Accent Color",
          "type": "string"
        },
        "font_family": {
          "default": "Inter",
          "maxLength": 100,
          "minLength": 1,
          "title": "Font Family",
          "type": "string"
        },
        "logo_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo Path"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "primary_color": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Primary Color",
          "type": "string"
        },
        "text_color": {
          "default": "#FFFFFF",
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Text Color",
          "type": "string"
        }
      },
      "required": [
        "name",
        "primary_color",
        "accent_color"
      ],
      "title": "BrandSpec",
      "type": "object"
    },
    "DeliverableSpec": {
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": {
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "4:5"
          ],
          "title": "Aspect Ratio",
          "type": "string"
        },
        "format": {
          "default": "mp4",
          "enum": [
            "mp4",
            "mov",
            "webm"
          ],
          "title": "Format",
          "type": "string"
        },
        "fps": {
          "default": 30,
          "maximum": 120,
          "minimum": 15,
          "title": "Fps",
          "type": "integer"
        },
        "height": {
          "maximum": 7680,
          "minimum": 320,
          "title": "Height",
          "type": "integer"
        },
        "language": {
          "pattern": "^[a-z]{2}(?:-[A-Z]{2})?$",
          "title": "Language",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z0-9][a-z0-9-]{1,79}$",
          "title": "Name",
          "type": "string"
        },
        "width": {
          "maximum": 7680,
          "minimum": 320,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "language",
        "aspect_ratio",
        "width",
        "height"
      ],
      "title": "DeliverableSpec",
      "type": "object"
    },
    "LikenessConsent": {
      "enum": [
        "granted",
        "not_granted",
        "not_applicable"
      ],
      "title": "LikenessConsent",
      "type": "string"
    },
    "LocalizationSpec": {
      "additionalProperties": false,
      "properties": {
        "cta": {
          "maxLength": 500,
          "minLength": 2,
          "title": "Cta",
          "type": "string"
        },
        "objective": {
          "maxLength": 2000,
          "minLength": 10,
          "title": "Objective",
          "type": "string"
        },
        "reviewer": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "segment_overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/LocalizedSegmentCopy"
          },
          "title": "Segment Overrides",
          "type": "object"
        }
      },
      "required": [
        "objective",
        "cta"
      ],
      "title": "LocalizationSpec",
      "type": "object"
    },
    "LocalizedSegmentCopy": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "headline": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Headline"
        }
      },
      "title": "LocalizedSegmentCopy",
      "type": "object"
    },
    "RightsDeclaration": {
      "additionalProperties": false,
      "properties": {
        "ai_generation_allowed": {
          "title": "Ai Generation Allowed",
          "type": "boolean"
        },
        "claims_approved_by_client": {
          "title": "Claims Approved By Client",
          "type": "boolean"
        },
        "likeness_consent": {
          "$ref": "#/$defs/LikenessConsent"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "source_assets_cleared": {
          "title": "Source Assets Cleared",
          "type": "boolean"
        },
        "voice_consent": {
          "$ref": "#/$defs/LikenessConsent"
        }
      },
      "required": [
        "source_assets_cleared",
        "ai_generation_allowed",
        "likeness_consent",
        "voice_consent",
        "claims_approved_by_client"
      ],
      "title": "RightsDeclaration",
      "type": "object"
    },
    "ShotKind": {
      "enum": [
        "text_motion",
        "ui_capture",
        "chart",
        "generative",
        "supplied_edit",
        "three_d",
        "technical_diagram",
        "portrait_animation",
        "lip_sync",
        "transition"
      ],
      "title": "ShotKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approver": {
      "$ref": "#/$defs/Approver"
    },
    "audience": {
      "maxLength": 2000,
      "minLength": 10,
      "title": "Audience",
      "type": "string"
    },
    "brand": {
      "$ref": "#/$defs/BrandSpec"
    },
    "deliverables": {
      "items": {
        "$ref": "#/$defs/DeliverableSpec"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Deliverables",
      "type": "array"
    },
    "duration_seconds": {
      "maximum": 600,
      "minimum": 5,
      "title": "Duration Seconds",
      "type": "number"
    },
    "engine_profile_overrides": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "$ref": "#/$defs/ShotKind"
      },
      "title": "Engine Profile Overrides",
      "type": "object"
    },
    "languages": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Languages",
      "type": "array"
    },
    "localizations": {
      "additionalProperties": {
        "$ref": "#/$defs/LocalizationSpec"
      },
      "title": "Localizations",
      "type": "object"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "objective": {
      "maxLength": 2000,
      "minLength": 10,
      "title": "Objective",
      "type": "string"
    },
    "platforms": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "minItems": 1,
      "title": "Platforms",
      "type": "array"
    },
    "project_name": {
      "maxLength": 120,
      "minLength": 3,
      "title": "Project Name",
      "type": "string"
    },
    "reference_urls": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Reference Urls",
      "type": "array"
    },
    "requested_shot_kinds": {
      "items": {
        "$ref": "#/$defs/ShotKind"
      },
      "title": "Requested Shot Kinds",
      "type": "array"
    },
    "rights": {
      "$ref": "#/$defs/RightsDeclaration"
    },
    "source_assets": {
      "items": {
        "type": "string"
      },
      "maxItems": 200,
      "title": "Source Assets",
      "type": "array"
    }
  },
  "required": [
    "project_name",
    "objective",
    "audience",
    "platforms",
    "duration_seconds",
    "languages",
    "brand",
    "rights",
    "approver",
    "deliverables"
  ],
  "title": "ClientBrief",
  "type": "object"
}